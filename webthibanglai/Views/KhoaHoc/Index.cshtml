@model webthibanglai.Models.KhoaHocViewModel

@{
    ViewData["Title"] = "Khóa học";

    static string FormatPrice(long price) => string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0}đ", price);
    static string FormatDate(DateOnly? date) => date?.ToString("dd/MM/yyyy") ?? "Đang cập nhật";
    static string GetStatusLabel(string status) => status switch
    {
        "DangMo" => "Đang mở đăng ký",
        "DangMoDangKy" => "Đang mở đăng ký",
        "DaDay" => "Đã đủ học viên",
        "DaDuHocVien" => "Đã đủ học viên",
        "TamDung" => "Tạm dừng",
        _ => "Sắp khai giảng"
    };
    static string GetStatusClass(string status) => status switch
    {
        "DangMo" => "bg-success",
        "DangMoDangKy" => "bg-success",
        "DaDay" => "bg-warning text-dark",
        "DaDuHocVien" => "bg-warning text-dark",
        "TamDung" => "bg-secondary",
        _ => "bg-primary"
    };
    static string GetCourseTheme(int index) => (index % 6) switch
    {
        0 => "course-blue",
        1 => "course-amber",
        2 => "course-purple",
        3 => "course-cyan",
        4 => "course-red",
        _ => "course-indigo"
    };
    static string GetCourseIconClass(KhoaHocCourseItem course)
    {
        var raw = string.Join(" ",
            course.TenKhoaHoc ?? string.Empty,
            course.MoTaNgan ?? string.Empty,
            course.LoaiBangLai ?? string.Empty,
            course.MaKhoaHoc ?? string.Empty).ToLowerInvariant();

        // Ưu tiên mô tô/xe máy trước để tránh match nhầm "oto" nằm trong "moto".
        if (raw.Contains("mô tô") || raw.Contains("moto") || raw.Contains("motor") || raw.Contains("xe máy") || raw.Contains("xemay") || raw.Contains("a1") || raw.Contains("a2"))
        {
            return "fa fa-motorcycle";
        }

        if (raw.Contains("xe tải") || raw.Contains("xetai") || raw.Contains("truck") || raw.Contains("hạng c") || raw.Contains("hang c"))
        {
            return "fa fa-truck";
        }

        if (raw.Contains("xe ô tô") || raw.Contains("xe oto") || raw.Contains("xeto") || raw.Contains("ô tô") || raw.Contains("car") || raw.Contains("hạng b") || raw.Contains("hang b"))
        {
            return "fa fa-car";
        }

        return "fa fa-motorcycle";
    }

    var featuredCourse = Model.Courses
        .Where(course => course.IsOpenForRegistration)
        .OrderBy(course => course.ThoiGianBatDau ?? DateOnly.MaxValue)
        .ThenBy(course => course.HocPhi)
        .FirstOrDefault()
        ?? Model.Courses.FirstOrDefault();
}



<div class="container-xxl py-6">
    <div class="container">
        @if (featuredCourse is not null)
        {
            <section class="course-for-you-hero mb-5 wow fadeInUp" data-wow-delay="0.1s" id="courseForYouHero">
                <div class="course-for-you-hero__content">
                    <span class="course-for-you-hero__eyebrow"><i class="fa fa-wand-magic-sparkles me-2"></i>Khóa học cho bạn</span>
                    <h1 class="course-for-you-hero__title" id="recommendedCourseTitle">@featuredCourse.TenKhoaHoc</h1>
                    <p class="course-for-you-hero__text" id="recommendedCourseReason">Dựa trên kết quả khảo sát ban đầu và danh sách các khóa học đang mở, đây là lựa chọn phù hợp để bạn bắt đầu hành trình học lái xe máy một cách thuận tiện và hiệu quả.</p>
                    <div class="course-for-you-hero__actions">
                        <a class="btn btn-light course-for-you-hero__btn" id="recommendedCourseDetailLink" asp-controller="KhoaHoc" asp-action="Detail" asp-route-id="@featuredCourse.CourseId">
                            <i class="fa fa-circle-info me-2"></i>Xem khóa học phù hợp
                        </a>
                        <form asp-controller="KhoaHoc" asp-action="Register" method="post" class="course-for-you-hero__form" id="recommendedCourseRegisterForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" id="recommendedCourseRegisterId" value="@featuredCourse.CourseId" />
                            <input type="hidden" name="ghiChu" value="Đăng ký từ gợi ý khóa học cho bạn" />
                            <button type="submit" class="btn btn-warning text-dark course-for-you-hero__register" id="recommendedCourseRegisterButton" @(featuredCourse.IsOpenForRegistration ? null : "disabled")>
                                <i class="fa fa-paper-plane me-2"></i>Đăng ký ngay
                            </button>
                        </form>
                    </div>
                </div>

                <div class="course-for-you-hero__panel">
                    <div class="course-for-you-card">
                        <div class="course-for-you-card__top">
                            <span class="course-for-you-card__icon"><i class="@GetCourseIconClass(featuredCourse)"></i></span>
                            <span class="badge @GetStatusClass(featuredCourse.TrangThai)" id="recommendedCourseStatus">@GetStatusLabel(featuredCourse.TrangThai)</span>
                        </div>
                        <div class="course-for-you-card__name" id="recommendedCourseName">@featuredCourse.TenKhoaHoc</div>
                        <div class="course-for-you-card__desc" id="recommendedCourseDesc">@featuredCourse.MoTaNgan</div>
                        <div class="course-for-you-card__metrics">
                            <div>
                                <span>Học phí</span>
                                <strong id="recommendedCoursePrice">@FormatPrice(featuredCourse.HocPhi)</strong>
                            </div>
                            <div>
                                <span>Số buổi</span>
                                <strong id="recommendedCourseLessons">@featuredCourse.SoBuoiHoc buổi</strong>
                            </div>
                            <div>
                                <span>Khai giảng</span>
                                <strong id="recommendedCourseStart">@FormatDate(featuredCourse.ThoiGianBatDau)</strong>
                            </div>
                            <div>
                                <span>Còn chỗ</span>
                                <strong id="recommendedCourseSlots">@Math.Max(featuredCourse.SoLuongToiDa - featuredCourse.SoLuongHienTai, 0)</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        }

        <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 650px;">
            <h6 class="text-primary text-uppercase mb-2">Lộ trình đào tạo</h6>
            <h1 class="display-6 mb-4">Khóa học thực tế từ hệ thống để học viên dễ chọn và đăng ký</h1>
          
        </div>

       

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-warning wow fadeInUp" data-wow-delay="0.1s">
                <i class="fa fa-circle-info me-2"></i>@Model.ErrorMessage
            </div>
        }

        @if (Model.Courses.Count == 0)
        {
            <div class="row">
                <div class="col-12 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="bg-light rounded shadow-sm p-5 text-center">
                        <i class="fa fa-layer-group text-primary mb-3" style="font-size: 2.5rem;"></i>
                        <h4 class="mb-3">Chưa có khóa học để hiển thị</h4>
                        <p class="text-muted mb-0">Trang này đang chờ dữ liệu từ API hoặc API chưa kết nối đúng với ứng dụng web.</p>
                    </div>
                </div>
            </div>
        }
        else
        {
        <div class="course-cards-grid">
            @for (var index = 0; index < Model.Courses.Count; index++)
            {
                var course = Model.Courses[index];

                <article class="home-featured-course-card h-100 wow fadeInUp course-result-item"
                       data-wow-delay="0.1s"
                       data-course-id="@course.CourseId"
                       data-course-name="@course.TenKhoaHoc"
                     data-course-code="@course.MaKhoaHoc"
                     data-course-license="@course.LoaiBangLai"
                     data-course-desc="@course.MoTaNgan"
                     data-course-price="@course.HocPhi"
                     data-course-price-text="@FormatPrice(course.HocPhi)"
                     data-course-lessons="@course.SoBuoiHoc"
                     data-course-start="@FormatDate(course.ThoiGianBatDau)"
                       data-course-status="@GetStatusLabel(course.TrangThai)"
                        data-course-open="@(course.IsOpenForRegistration ? "true" : "false")"
                        data-course-slots="@Math.Max(course.SoLuongToiDa - course.SoLuongHienTai, 0)">
                    <div class="home-featured-course-card__glow"></div>
                    <div class="home-featured-course-card__top">
                        <span class="home-featured-course-card__icon"><i class="@GetCourseIconClass(course)"></i></span>
                        <span class="home-featured-course-card__status">@GetStatusLabel(course.TrangThai)</span>
                    </div>
                    <div class="home-featured-course-card__code">@course.MaKhoaHoc</div>
                    <h5 class="home-featured-course-card__title">@course.TenKhoaHoc</h5>
                    <p class="home-featured-course-card__desc">@(string.IsNullOrWhiteSpace(course.MoTaNgan) ? "Khóa học đang được cập nhật mô tả chi tiết." : course.MoTaNgan)</p>

                    <div class="home-featured-course-card__price">
                        <span>Học phí</span>
                        <strong>@FormatPrice(course.HocPhi)</strong>
                    </div>

                    <div class="home-featured-course-card__meta">
                        <div><span>Số buổi</span><strong>@course.SoBuoiHoc buổi</strong></div>
                        <div><span>Khai giảng</span><strong>@FormatDate(course.ThoiGianBatDau)</strong></div>
                    </div>

                    <div class="home-featured-course-card__schedule">
                        <i class="fa fa-calendar-alt me-2"></i>@(string.IsNullOrWhiteSpace(course.LichHocTomTat) ? "Lịch học đang cập nhật" : course.LichHocTomTat)
                    </div>

                    <a class="home-featured-course-card__button text-decoration-none" asp-controller="KhoaHoc" asp-action="Detail" asp-route-id="@course.CourseId">
                        <i class="fa fa-circle-info me-2"></i>Xem chi tiết
                    </a>
                </article>
            }
        </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .course-for-you-hero {
            position: relative;
            overflow: hidden;
            border-radius: 2rem;
            padding: clamp(1.5rem, 4vw, 3rem);
            background: radial-gradient(circle at top left, rgba(247, 185, 0, .22), transparent 34%), linear-gradient(135deg, #ffffff 0%, #fff8df 50%, #f7b900 100%);
            color: #0b2c4d;
            display: grid;
            grid-template-columns: minmax(0, 1.35fr) minmax(300px, .8fr);
            gap: 2rem;
            border: 1px solid rgba(247, 185, 0, .3);
            box-shadow: 0 22px 60px rgba(11, 44, 77, .12);
        }

        .course-for-you-hero::after {
            content: '';
            position: absolute;
            width: 280px;
            height: 280px;
            right: -90px;
            top: -90px;
            border-radius: 50%;
            background: rgba(11, 44, 77, .08);
        }

        .home-featured-course-card {
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            height: 100%;
            padding: 1.5rem;
            border-radius: 1.5rem;
            background: linear-gradient(150deg, #ffffff 0%, #f8fbff 58%, #fff4cc 100%);
            border: 1px solid rgba(12, 43, 75, .08);
            box-shadow: 0 18px 35px rgba(12, 43, 75, .12);
        }

        .home-featured-course-card__glow {
            position: absolute;
            top: -64px;
            right: -64px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(243, 189, 0, .2);
        }

        .home-featured-course-card__top,
        .home-featured-course-card__meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
        }

        .home-featured-course-card__icon {
            width: 52px;
            height: 52px;
            border-radius: 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(243, 189, 0, .12);
            color: #bc7c00;
            border: 1px solid rgba(243, 189, 0, .55);
            font-size: 1.2rem;
        }

        .home-featured-course-card__status {
            border-radius: 999px;
            background: #d5f3df;
            color: #067647;
            padding: .35rem .8rem;
            font-size: .84rem;
            font-weight: 700;
        }

        .home-featured-course-card__code {
            color: #f3bd00;
            font-size: 1.05rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            font-weight: 700;
        }

        .home-featured-course-card__title {
            color: #0c2b4b;
            font-size: 1.95rem;
            margin: 0;
        }

        .home-featured-course-card__desc {
            color: #64748b;
            margin: 0;
        }

        .home-featured-course-card__price {
            padding: 1rem;
            border-radius: 1rem;
            background: #0f345c;
            color: #fff;
        }

        .home-featured-course-card__price span,
        .home-featured-course-card__meta span {
            display: block;
            font-size: .86rem;
            color: #98a2b3;
            margin-bottom: .2rem;
        }

        .home-featured-course-card__price strong {
            font-size: 1.35rem;
        }

        .home-featured-course-card__meta > div {
            flex: 1;
            border-radius: 1rem;
            background: #f7f9fc;
            border: 1px solid rgba(12, 43, 75, .08);
            padding: .95rem;
        }

        .home-featured-course-card__meta strong {
            color: #0c2b4b;
            font-size: 1.05rem;
        }

        .home-featured-course-card__schedule {
            color: #64748b;
            font-size: .95rem;
        }

        .home-featured-course-card__button {
            margin-top: auto;
            border: none;
            border-radius: 999px;
            padding: .75rem 1rem;
            font-weight: 700;
            color: #0c2b4b;
            background: linear-gradient(90deg, #f3bd00 0%, #ffd447 100%);
            box-shadow: 0 10px 24px rgba(243, 189, 0, .35);
            transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease;
            text-align: center;
        }

        .home-featured-course-card__button:hover {
            color: #0c2b4b;
            transform: translateY(-2px);
            box-shadow: 0 14px 26px rgba(243, 189, 0, .42);
        }

        .course-for-you-hero__content,
        .course-for-you-hero__panel {
            position: relative;
            z-index: 1;
        }

        .course-for-you-hero__eyebrow {
            display: inline-flex;
            align-items: center;
            padding: .55rem 1rem;
            border-radius: 999px;
            background: #fff7d7;
            border: 1px solid rgba(243, 189, 0, .45);
            color: #b47f00;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .06em;
            font-size: .82rem;
            margin-bottom: 1.25rem;
        }

        .course-for-you-hero__title {
            max-width: 760px;
            font-size: clamp(2rem, 4vw, 3.35rem);
            font-weight: 900;
            line-height: 1.08;
            margin-bottom: 1rem;
        }

        .course-for-you-hero__text {
            max-width: 680px;
            color: #526173;
            font-size: 1.05rem;
            line-height: 1.7;
            margin-bottom: 1.5rem;
        }

        .course-for-you-hero__actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 1rem;
        }

        .course-for-you-hero__btn,
        .course-for-you-hero__register {
            border-radius: 999px;
            padding: .85rem 1.25rem;
            font-weight: 800;
            box-shadow: 0 8px 20px rgba(11, 44, 77, .08);
        }

        .course-for-you-hero__btn {
            color: #0b2c4d;
            background: #ffffff;
            border: 1px solid rgba(247, 185, 0, .28);
        }

        .course-for-you-hero__form {
            margin: 0;
        }

        .course-for-you-card {
            border-radius: 1.5rem;
            background: rgba(255, 255, 255, .82);
            border: 1px solid rgba(255, 255, 255, .72);
            box-shadow: 0 14px 34px rgba(11, 44, 77, .1);
            backdrop-filter: blur(10px);
            padding: 1.5rem;
        }

        .course-for-you-card__top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1.1rem;
        }

        .course-for-you-card__icon {
            width: 64px;
            height: 64px;
            border-radius: 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f7b900, #f59e0b);
            color: #0b2c4d;
            font-size: 1.55rem;
            box-shadow: 0 6px 16px rgba(247, 185, 0, .32);
        }

        .course-for-you-card__name {
            color: #0b2c4d;
            font-size: 1.35rem;
            font-weight: 900;
            line-height: 1.25;
            margin-bottom: .6rem;
        }

        .course-for-you-card__desc {
            color: #526173;
            line-height: 1.55;
            margin-bottom: 1rem;
        }

        .course-for-you-card__metrics {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .75rem;
        }

        .course-for-you-card__metrics div {
            border-radius: 1rem;
            background: #f8fafc;
            border: 1px solid #e5edf6;
            padding: .85rem;
        }

        .course-for-you-card__metrics span,
        .course-for-you-card__metrics strong {
            display: block;
        }

        .course-for-you-card__metrics span {
            color: #6b7280;
            font-size: .82rem;
            margin-bottom: .2rem;
        }

        .course-for-you-card__metrics strong {
            color: #111827;
            font-size: .98rem;
        }

        .course-cards-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.25rem;
        }

        .course-modern-card {
            --course-gradient: linear-gradient(135deg, #3b82f6, #2563eb);
            --course-color: #2563eb;
            --course-border: #3b82f6;
            --course-shadow: rgba(59, 130, 246, .25);
            --course-bg-light: #eff6ff;
            position: relative;
            overflow: hidden;
            min-height: 100%;
            border-radius: 1.35rem;
            background: linear-gradient(135deg, var(--course-bg-light) 0%, #ffffff 100%);
            border: 2px solid transparent;
            box-shadow: 0 4px 16px rgba(0, 0, 0, .08);
            display: flex;
            flex-direction: column;
            transition: transform .3s cubic-bezier(.4, 0, .2, 1), box-shadow .3s ease, border-color .3s ease;
        }

        .course-modern-card:hover {
            transform: translateY(-6px);
            border-color: var(--course-border);
            box-shadow: 0 14px 34px var(--course-shadow);
        }

        .course-modern-card__glow {
            position: absolute;
            inset: 0;
            background: var(--course-gradient);
            opacity: 0;
            transition: opacity .3s ease;
        }

        .course-modern-card:hover .course-modern-card__glow {
            opacity: .08;
        }

        .course-modern-card > *:not(.course-modern-card__glow) {
            position: relative;
            z-index: 1;
        }

        .course-modern-card__body {
            padding: 1.35rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            flex: 1;
        }

        .course-modern-card__header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .course-modern-card__badges {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: .5rem;
        }

        .course-modern-card__icon {
            width: 58px;
            height: 58px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--course-gradient);
            color: #ffffff;
            font-size: 1.45rem;
            box-shadow: 0 5px 14px var(--course-shadow);
            flex-shrink: 0;
        }

        .course-modern-card__status {
            padding: .45rem .8rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, .88);
            color: var(--course-color);
            border: 1px solid color-mix(in srgb, var(--course-border), transparent 70%);
            font-weight: 800;
            font-size: .82rem;
            white-space: nowrap;
        }

        .course-modern-card__code {
            color: var(--course-color);
            font-size: .82rem;
            font-weight: 850;
            letter-spacing: .04em;
            text-transform: uppercase;
            margin-bottom: .35rem;
        }

        .course-modern-card__title {
            color: #1f2937;
            font-size: 1.2rem;
            font-weight: 850;
            line-height: 1.35;
            margin-bottom: .55rem;
        }

        .course-modern-card__desc {
            color: #6b7280;
            font-size: .92rem;
            line-height: 1.55;
            margin: 0;
        }

        .course-modern-card__price {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: .9rem 1rem;
            border-radius: 1rem;
            background: rgba(255, 255, 255, .9);
            border: 1px solid color-mix(in srgb, var(--course-border), transparent 78%);
        }

        .course-modern-card__price span,
        .course-modern-card__price strong {
            display: block;
        }

        .course-modern-card__price span {
            color: #6b7280;
            font-size: .82rem;
            font-weight: 700;
        }

        .course-modern-card__price strong {
            color: var(--course-color);
            font-size: 1.05rem;
            font-weight: 900;
        }

        .course-modern-card__metrics {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .75rem;
        }

        .course-modern-metric {
            padding: .85rem;
            border-radius: 1rem;
            background: rgba(255, 255, 255, .86);
            border: 1px solid #edf2f7;
        }

        .course-modern-metric--wide {
            grid-column: 1 / -1;
        }

        .course-modern-metric span,
        .course-modern-metric strong {
            display: block;
        }

        .course-modern-metric span {
            color: #6b7280;
            font-size: .82rem;
            margin-bottom: .2rem;
        }

        .course-modern-metric strong {
            color: #111827;
            font-size: .98rem;
        }

        .course-modern-card__progress {
            color: #6b7280;
            font-size: .9rem;
        }

        .course-modern-card__progress strong {
            color: var(--course-color);
        }

        .course-modern-card__progress .progress {
            height: 10px;
            border-radius: 999px;
            background: rgba(15, 23, 42, .08);
        }

        .course-modern-card__progress .progress-bar {
            border-radius: 999px;
            background: var(--course-gradient);
        }

        .course-modern-card__schedule {
            color: #6b7280;
            font-size: .88rem;
            line-height: 1.55;
            display: grid;
            gap: .45rem;
        }

        .course-modern-card__schedule i {
            color: var(--course-color);
        }

        .course-modern-card__footer {
            display: grid;
            gap: .7rem;
            margin-top: auto;
        }

        .course-modern-card__button {
            display: block;
            width: 100%;
            border: 0;
            border-radius: 1rem;
            padding: .9rem 1rem;
            color: #ffffff;
            background: var(--course-gradient);
            font-weight: 850;
            box-shadow: 0 6px 16px var(--course-shadow);
            transition: transform .25s ease, box-shadow .25s ease, opacity .25s ease;
        }

        .course-modern-card__button:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px var(--course-shadow);
            color: #ffffff;
        }

        .course-modern-card__button:disabled {
            cursor: not-allowed;
            opacity: .55;
        }

        .course-modern-card__button--outline {
            color: var(--course-color);
            background: rgba(255, 255, 255, .9);
            border: 1px solid color-mix(in srgb, var(--course-border), transparent 65%);
            box-shadow: none;
        }

        .course-modern-card__button--outline:hover {
            color: var(--course-color);
            background: #ffffff;
        }

        .course-modern-card__button--outline:hover:not(:disabled),
        .course-modern-card__button--outline:focus-visible {
            color: var(--course-color);
        }

        .course-blue {
            --course-gradient: linear-gradient(135deg, #3b82f6, #2563eb);
            --course-color: #2563eb;
            --course-border: #3b82f6;
            --course-shadow: rgba(59, 130, 246, .3);
            --course-bg-light: #eff6ff;
        }

        .course-amber {
            --course-gradient: linear-gradient(135deg, #f59e0b, #d97706);
            --course-color: #d97706;
            --course-border: #f59e0b;
            --course-shadow: rgba(245, 158, 11, .3);
            --course-bg-light: #fffbeb;
        }

        .course-purple {
            --course-gradient: linear-gradient(135deg, #a855f7, #9333ea);
            --course-color: #9333ea;
            --course-border: #a855f7;
            --course-shadow: rgba(168, 85, 247, .3);
            --course-bg-light: #faf5ff;
        }

        .course-cyan {
            --course-gradient: linear-gradient(135deg, #06b6d4, #0891b2);
            --course-color: #0891b2;
            --course-border: #06b6d4;
            --course-shadow: rgba(6, 182, 212, .3);
            --course-bg-light: #ecfeff;
        }

        .course-red {
            --course-gradient: linear-gradient(135deg, #ef4444, #dc2626);
            --course-color: #dc2626;
            --course-border: #ef4444;
            --course-shadow: rgba(239, 68, 68, .3);
            --course-bg-light: #fef2f2;
        }

        .course-indigo {
            --course-gradient: linear-gradient(135deg, #6366f1, #4f46e5);
            --course-color: #4f46e5;
            --course-border: #6366f1;
            --course-shadow: rgba(99, 102, 241, .3);
            --course-bg-light: #eef2ff;
        }

        @@media (max-width: 1199.98px) {
            .course-cards-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 991.98px) {
            .course-for-you-hero {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 767.98px) {
            .course-cards-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 575.98px) {
            .course-for-you-card__metrics {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var hero = document.getElementById('courseForYouHero');
            if (!hero) {
                return;
            }

            var courseItems = Array.from(document.querySelectorAll('.course-result-item[data-course-id]'));
            if (courseItems.length === 0) {
                return;
            }

            function readOnboardingData() {
                try {
                    var raw = window.localStorage.getItem('onboardingData');
                    return raw ? JSON.parse(raw) : null;
                } catch {
                    return null;
                }
            }

            function normalize(value) {
                return (value || '').toString().toLowerCase();
            }

            function scoreCourse(course, onboarding) {
                var text = normalize(course.name + ' ' + course.code + ' ' + course.license + ' ' + course.desc);
                var score = course.isOpen ? 50 : 0;

                if (course.slots > 0) {
                    score += Math.min(course.slots, 10);
                }

                if (!onboarding) {
                    return score - Math.min(course.price / 100000, 15);
                }

                if (onboarding.purpose === 'hoc_thi_bang_lai') {
                    score += 18;
                    if (text.includes('cơ bản') || text.includes('a1') || text.includes('lần đầu')) score += 12;
                }

                if (onboarding.purpose === 'thi_thu' || onboarding.level === 'sap_thi' || onboarding.style === 'hoc_theo_de') {
                    score += 14;
                    if (course.lessons <= 12) score += 10;
                    if (text.includes('cấp tốc') || text.includes('ôn thi') || text.includes('thi')) score += 12;
                }

                if (onboarding.purpose === 'on_lai_kien_thuc' || onboarding.level === 'da_thi_rot') {
                    score += 14;
                    if (text.includes('ôn') || text.includes('bổ trợ') || text.includes('củng cố')) score += 12;
                }

                if (onboarding.purpose === 'xem_meo_thi' || onboarding.style === 'hoc_nhanh') {
                    score += 10;
                    if (course.lessons > 0 && course.lessons <= 10) score += 10;
                }

                if (onboarding.level === 'chua_biet_gi' || onboarding.style === 'ly_thuyet_truoc' || onboarding.style === 'hoc_tu_tu') {
                    score += 12;
                    if (course.lessons >= 10) score += 8;
                    if (text.includes('cơ bản') || text.includes('lý thuyết')) score += 10;
                }

                return score - Math.min(course.price / 150000, 10);
            }

            function buildReason(course, onboarding) {
                if (!onboarding) {
                    return 'Bạn chưa hoàn tất khảo sát ban đầu, nên hệ thống đang ưu tiên khóa học đang mở đăng ký, còn chỗ và có lịch khai giảng phù hợp.';
                }

                var purposeMap = {
                    hoc_thi_bang_lai: 'học để thi bằng lái lần đầu',
                    thi_thu: 'thi thử để đánh giá năng lực',
                    on_lai_kien_thuc: 'ôn lại kiến thức đã học',
                    xem_meo_thi: 'xem mẹo thi và kinh nghiệm'
                };

                var levelMap = {
                    chua_biet_gi: 'mới bắt đầu',
                    da_hoc_qua: 'đã có nền tảng cơ bản',
                    sap_thi: 'sắp thi và cần ôn tập tích cực',
                    da_thi_rot: 'cần củng cố lại sau lần thi chưa đạt',
                    da_co_bang: 'muốn củng cố kiến thức'
                };

                var purpose = purposeMap[onboarding.purpose] || 'học bằng lái xe máy';
                var level = levelMap[onboarding.level] || 'cần một lộ trình phù hợp';
                return 'Dựa trên khảo sát: bạn muốn ' + purpose + ', hiện đang ' + level + '. Hệ thống đã đối chiếu với danh sách khóa học từ API và gợi ý khóa học này.';
            }

            var onboarding = readOnboardingData();
            var courses = courseItems.map(function (item) {
                return {
                    id: item.getAttribute('data-course-id') || '',
                    name: item.getAttribute('data-course-name') || '',
                    code: item.getAttribute('data-course-code') || '',
                    license: item.getAttribute('data-course-license') || '',
                    desc: item.getAttribute('data-course-desc') || '',
                    price: parseInt(item.getAttribute('data-course-price') || '0', 10) || 0,
                    priceText: item.getAttribute('data-course-price-text') || 'Đang cập nhật',
                    lessons: parseInt(item.getAttribute('data-course-lessons') || '0', 10) || 0,
                    start: item.getAttribute('data-course-start') || 'Đang cập nhật',
                    status: item.getAttribute('data-course-status') || 'Sắp khai giảng',
                    isOpen: item.getAttribute('data-course-open') === 'true',
                    slots: parseInt(item.getAttribute('data-course-slots') || '0', 10) || 0
                };
            });

            var recommended = courses
                .map(function (course) {
                    course.score = scoreCourse(course, onboarding);
                    return course;
                })
                .sort(function (a, b) {
                    return b.score - a.score;
                })[0];

            if (!recommended) {
                return;
            }

            var detailLink = document.getElementById('recommendedCourseDetailLink');
            var registerId = document.getElementById('recommendedCourseRegisterId');
            var registerButton = document.getElementById('recommendedCourseRegisterButton');

            document.getElementById('recommendedCourseTitle').textContent = recommended.name;
            // Giữ nội dung tĩnh trong HTML cho #recommendedCourseReason, không ghi đè bằng JS.
            document.getElementById('recommendedCourseStatus').textContent = recommended.status;
            document.getElementById('recommendedCourseName').textContent = recommended.name;
            document.getElementById('recommendedCourseDesc').textContent = recommended.desc || 'Khóa học đang được cập nhật mô tả chi tiết.';
            document.getElementById('recommendedCoursePrice').textContent = recommended.priceText;
            document.getElementById('recommendedCourseLessons').textContent = recommended.lessons + ' buổi';
            document.getElementById('recommendedCourseStart').textContent = recommended.start;
            document.getElementById('recommendedCourseSlots').textContent = recommended.slots.toString();

            if (detailLink) {
                detailLink.href = '/KhoaHoc/Detail/' + encodeURIComponent(recommended.id);
            }

            if (registerId) {
                registerId.value = recommended.id;
            }

            if (registerButton) {
                registerButton.disabled = !recommended.isOpen;
            }
        })();
    </script>
}
