@model webthibanglai.Models.KhoaHocDetailViewModel

@{
    ViewData["Title"] = "Chi tiết khóa học";

    static string FormatPrice(long price) => string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0}đ", price);
    static string FormatDate(DateOnly? date) => date?.ToString("dd/MM/yyyy") ?? "Đang cập nhật";
    static string FormatDayOfWeek(int day) => day switch
    {
        2 => "Thứ 2",
        3 => "Thứ 3",
        4 => "Thứ 4",
        5 => "Thứ 5",
        6 => "Thứ 6",
        7 => "Thứ 7",
        8 => "Chủ nhật",
        _ => $"Thứ {day}"
    };
    static string GetStatusLabel(string status) => status switch
    {
        "DangMo" => "Đang mở đăng ký",
        "DangMoDangKy" => "Đang mở đăng ký",
        "DaDay" => "Đã đủ học viên",
        "DaDuHocVien" => "Đã đủ học viên",
        "TamDung" => "Tạm dừng",
        _ => "Sắp khai giảng"
    };

    static string GetRegistrationStateClass(string? state) => state switch
    {
        "success" => "alert-success",
        "warning" => "alert-warning",
        "danger" => "alert-danger",
        _ => "alert-info"
    };
}


<div class="container-xxl py-6">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-warning mb-4">
                <i class="fa fa-circle-info me-2"></i>@Model.ErrorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.RegistrationMessage))
        {
            <div class="alert alert-success mb-4">
                <i class="fa fa-circle-check me-2"></i>@Model.RegistrationMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.RegistrationErrorMessage))
        {
            <div class="alert alert-danger mb-4">
                <i class="fa fa-triangle-exclamation me-2"></i>@Model.RegistrationErrorMessage
            </div>
        }

        @if (Model.Course is null)
        {
            <div class="bg-light rounded shadow-sm p-5 text-center">
                <i class="fa fa-layer-group text-primary mb-3" style="font-size: 2.5rem;"></i>
                <h4 class="mb-3">Không có dữ liệu khóa học</h4>
                <p class="text-muted mb-4">Chi tiết khóa học hiện chưa thể hiển thị.</p>
                <a class="btn btn-primary" asp-controller="KhoaHoc" asp-action="Index">Quay lại danh sách khóa học</a>
            </div>
        }
        else
        {
            var course = Model.Course;
            var availableClasses = Model.Classes;
            var sessionDefinitions = new[]
            {
                new { Key = "Sang", Label = "Sáng" },
                new { Key = "Chieu", Label = "Chiều" },
                new { Key = "Toi", Label = "Tối" }
            };

            static int NormalizeDayOfWeek(System.DayOfWeek dayOfWeek) => dayOfWeek switch
            {
                System.DayOfWeek.Monday => 2,
                System.DayOfWeek.Tuesday => 3,
                System.DayOfWeek.Wednesday => 4,
                System.DayOfWeek.Thursday => 5,
                System.DayOfWeek.Friday => 6,
                System.DayOfWeek.Saturday => 7,
                System.DayOfWeek.Sunday => 8,
                _ => 0
            };

            static string DetectSession(string startTime)
            {
                if (!TimeOnly.TryParse(startTime, out var time))
                {
                    return "Khac";
                }

                if (time < new TimeOnly(12, 0))
                {
                    return "Sang";
                }

                if (time < new TimeOnly(18, 0))
                {
                    return "Chieu";
                }

                return "Toi";
            }

            static DateOnly GetStartOfWeek(DateOnly date)
            {
                var normalizedDay = NormalizeDayOfWeek(date.DayOfWeek);
                var offset = normalizedDay - 2;
                return date.AddDays(-offset);
            }

            static DateOnly FindNextDateByDayOfWeek(DateOnly fromDate, int targetDayOfWeek)
            {
                var normalizedCurrentDay = NormalizeDayOfWeek(fromDate.DayOfWeek);
                var offset = targetDayOfWeek - normalizedCurrentDay;
                if (offset < 0)
                {
                    offset += 7;
                }

                return fromDate.AddDays(offset);
            }

            WeeklyScheduleTableViewModel BuildScheduleTable(List<KhoaHocScheduleItem> schedules, DateOnly? startDate, DateOnly? endDate)
            {
                var expandedSchedule = new List<(int DayOfWeek, string SessionKey, WeeklyScheduleOccurrenceItem Item)>();

                if (startDate.HasValue && endDate.HasValue && startDate <= endDate)
                {
                    var nextSearchDate = startDate.Value;

                    foreach (var schedule in schedules)
                    {
                        var occurrenceDate = FindNextDateByDayOfWeek(nextSearchDate, schedule.ThuTrongTuan);
                        if (occurrenceDate > endDate.Value)
                        {
                            break;
                        }

                        expandedSchedule.Add((
                            schedule.ThuTrongTuan,
                            DetectSession(schedule.GioBatDau),
                            new WeeklyScheduleOccurrenceItem
                            {
                                NgayHoc = occurrenceDate,
                                GioBatDau = schedule.GioBatDau,
                                GioKetThuc = schedule.GioKetThuc,
                                DiaDiem = schedule.DiaDiem
                            }));

                        nextSearchDate = occurrenceDate.AddDays(1);
                    }
                }
                else
                {
                    expandedSchedule = schedules
                        .Select(item => (
                            item.ThuTrongTuan,
                            DetectSession(item.GioBatDau),
                            new WeeklyScheduleOccurrenceItem
                            {
                                NgayHoc = null,
                                GioBatDau = item.GioBatDau,
                                GioKetThuc = item.GioKetThuc,
                                DiaDiem = item.DiaDiem
                            }))
                        .ToList();
                }

                var effectiveStartDate = startDate ?? expandedSchedule
                    .Where(item => item.Item.NgayHoc.HasValue)
                    .Select(item => item.Item.NgayHoc!.Value)
                    .DefaultIfEmpty(DateOnly.FromDateTime(DateTime.Today))
                    .Min();

                var effectiveEndDate = endDate ?? expandedSchedule
                    .Where(item => item.Item.NgayHoc.HasValue)
                    .Select(item => item.Item.NgayHoc!.Value)
                    .DefaultIfEmpty(effectiveStartDate)
                    .Max();

                var firstWeekStart = GetStartOfWeek(effectiveStartDate);
                var lastWeekStart = GetStartOfWeek(effectiveEndDate);
                var weekOptions = new List<WeeklyScheduleWeekOption>();

                for (var weekStart = firstWeekStart; weekStart <= lastWeekStart; weekStart = weekStart.AddDays(7))
                {
                    var weekEnd = weekStart.AddDays(6);
                    weekOptions.Add(new WeeklyScheduleWeekOption
                    {
                        Index = weekOptions.Count,
                        StartDate = weekStart,
                        EndDate = weekEnd,
                        Label = $"Tuần {weekOptions.Count + 1}: {weekStart:dd/MM} - {weekEnd:dd/MM}"
                    });
                }

                if (weekOptions.Count == 0)
                {
                    weekOptions.Add(new WeeklyScheduleWeekOption
                    {
                        Index = 0,
                        StartDate = firstWeekStart,
                        EndDate = firstWeekStart.AddDays(6),
                        Label = $"Tuần 1: {firstWeekStart:dd/MM} - {firstWeekStart.AddDays(6):dd/MM}"
                    });
                }

                var scheduleTable = new WeeklyScheduleTableViewModel
                {
                    Weeks = weekOptions,
                    SelectedWeekIndex = 0,
                    WeekTables = new List<WeeklyScheduleWeekTable>()
                };

                foreach (var week in weekOptions)
                {
                    var weekTable = new WeeklyScheduleWeekTable
                    {
                        WeekIndex = week.Index,
                        Label = week.Label,
                        Days = Enumerable.Range(0, 7)
                            .Select(offset => week.StartDate.AddDays(offset))
                            .Select(date => new WeeklyScheduleDayColumn
                            {
                                DayOfWeek = NormalizeDayOfWeek(date.DayOfWeek),
                                Label = FormatDayOfWeek(NormalizeDayOfWeek(date.DayOfWeek)),
                                Date = date
                            })
                            .ToList(),
                        Rows = new List<WeeklyScheduleRow>()
                    };

                    foreach (var session in sessionDefinitions)
                    {
                        var row = new WeeklyScheduleRow
                        {
                            SessionKey = session.Key,
                            SessionLabel = session.Label,
                            Cells = weekTable.Days.Select(day => new WeeklyScheduleCell
                            {
                                DayOfWeek = day.DayOfWeek,
                                SessionKey = session.Key,
                                Items = expandedSchedule
                                    .Where(item => item.DayOfWeek == day.DayOfWeek
                                        && item.SessionKey == session.Key
                                        && item.Item.NgayHoc == day.Date)
                                    .Select(item => item.Item)
                                    .OrderBy(item => item.NgayHoc)
                                    .ThenBy(item => item.GioBatDau)
                                    .ToList()
                            }).ToList()
                        };

                        weekTable.Rows.Add(row);
                    }

                    scheduleTable.WeekTables.Add(weekTable);
                }

                return scheduleTable;
            }

            <section class="course-detail-hero mb-5">
                <div class="course-detail-hero__content">
                    <div class="course-detail-hero__badges">
                        <span class="course-detail-hero__badge course-detail-hero__badge--status">@GetStatusLabel(course.TrangThai)</span>
                        <span class="course-detail-hero__badge">@course.MaKhoaHoc</span>
                        <span class="course-detail-hero__badge">@course.LoaiBangLai</span>
                    </div>
                    <h1 class="course-detail-hero__title">@course.TenKhoaHoc</h1>
                    <p class="course-detail-hero__text">@course.MoTa</p>
                </div>
                <div class="course-detail-hero__panel">
                    <div class="course-detail-highlight">
                        <span class="course-detail-highlight__icon"><i class="fa fa-motorcycle"></i></span>
                        <div>
                            <span class="course-detail-highlight__label">Khóa học GPLX</span>
                            <strong>@course.LoaiBangLai</strong>
                        </div>
                    </div>
                    <div class="course-detail-highlight">
                        <span class="course-detail-highlight__icon"><i class="fa fa-calendar-check"></i></span>
                        <div>
                            <span class="course-detail-highlight__label">Khai giảng</span>
                            <strong>@FormatDate(course.NgayBatDau)</strong>
                        </div>
                    </div>
                    <div class="course-detail-highlight">
                        <span class="course-detail-highlight__icon"><i class="fa fa-wallet"></i></span>
                        <div>
                            <span class="course-detail-highlight__label">Học phí</span>
                            <strong>@FormatPrice(course.HocPhi)</strong>
                        </div>
                    </div>
                </div>
            </section>

            <div class="row g-5 align-items-start">
                <div class="col-lg-8">

                    <div class="course-detail-section mt-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div>
                                <h4 class="mb-1">Danh sách lớp đang mở</h4>
                                <p class="text-muted mb-0">Chọn lớp phù hợp với lịch học của bạn trước khi gửi đăng ký.</p>
                            </div>
                            <span class="badge rounded-pill bg-light text-dark border">@availableClasses.Count lớp</span>
                        </div>

                        @if (availableClasses.Count == 0)
                        {
                            <div class="course-empty-state text-center">
                                <i class="fa fa-school text-primary mb-3"></i>
                                <h5 class="mb-2">Chưa có lớp nào để hiển thị</h5>
                                <p class="text-muted mb-0">Hệ thống đang cập nhật danh sách lớp và lịch học cho khóa này.</p>
                            </div>
                        }
                        else
                        {
                            <div class="class-list-grid">
                                @foreach (var classItem in availableClasses)
                                {
                                    var isSelected = Model.SelectedClassId == classItem.ClassId;
                                    var classScheduleTable = BuildScheduleTable(classItem.LichHoc, classItem.NgayBatDau, classItem.NgayKetThuc);
                                    var classExpandedScheduleCount = classScheduleTable.WeekTables
                                        .SelectMany(week => week.Rows)
                                        .SelectMany(row => row.Cells)
                                        .Sum(cell => cell.Items.Count);
                                    <div class="class-card @(classItem.IsOpenForRegistration ? string.Empty : "is-disabled") @(isSelected ? "is-selected" : string.Empty)" data-class-card data-class-id="@classItem.ClassId" data-class-name="@classItem.TenLop" data-selectable="@(classItem.IsOpenForRegistration ? "true" : "false")">
                                        <div class="class-card__top">
                                            <div>
                                                <div class="class-card__title-row">
                                                    <input form="courseRegistrationForm" type="radio" name="classId" value="@classItem.ClassId" class="class-card__radio" @(classItem.IsOpenForRegistration ? null : "disabled") @(isSelected ? "checked" : null) />
                                                    <h5 class="mb-0">@classItem.TenLop</h5>
                                                </div>
                                                <div class="small text-muted mt-2">Giáo viên: @(string.IsNullOrWhiteSpace(classItem.GiaoVien) ? "Đang cập nhật" : classItem.GiaoVien)</div>
                                            </div>
                                            <span class="badge rounded-pill @(classItem.IsOpenForRegistration ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@GetStatusLabel(classItem.TrangThai)</span>
                                        </div>

                                        <div class="class-card__meta">
                                            <div><strong>Sĩ số:</strong> @classItem.SiSoHienTai/@classItem.SiSoToiDa</div>
                                            <div><strong>Bắt đầu:</strong> @FormatDate(classItem.NgayBatDau)</div>
                                            <div><strong>Kết thúc:</strong> @FormatDate(classItem.NgayKetThuc)</div>
                                            <div><strong>Còn lại:</strong> @classItem.RemainingSlots chỗ</div>
                                        </div>

                                        <div class="class-card__schedule">
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                                <div class="fw-semibold">Lịch học mẫu</div>
                                              
                                            </div>
                                            @if (classItem.LichHoc.Count == 0)
                                            {
                                                <div class="text-muted small">Chưa có lịch học chi tiết.</div>
                                            }
                                            else
                                            {
                                                @await Html.PartialAsync("~/Views/Shared/Components/WeeklyScheduleTable/Default.cshtml", classScheduleTable)

                                                <div class="bg-white border rounded-3 p-3 mt-3">
                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                        <i class="fa fa-circle-info text-primary"></i>
                                                        <span class="fw-semibold">Tổng quan lịch học lớp</span>
                                                    </div>
                                                    <div class="small text-muted">
                                                        Lớp hiện có <strong>@classExpandedScheduleCount</strong> buổi trong khoảng thời gian học, học vào
                                                        <strong>@string.Join(", ", classItem.LichHoc.Select(item => item.ThuTrongTuan).Distinct().OrderBy(day => day).Select(FormatDayOfWeek))</strong>.
                                                        Lịch thực tế có thể được trung tâm điều chỉnh trước ngày khai giảng.
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        @if (!classItem.IsOpenForRegistration)
                                        {
                                            <div class="class-card__overlay-note">
                                                <i class="fa fa-lock me-2"></i>Lớp này hiện chưa mở đăng ký.
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="course-detail-register-card sticky-top" style="top: 110px;">
                        <div class="course-detail-register-card__header">
                            <span class="course-detail-register-card__icon"><i class="fa fa-paper-plane"></i></span>
                            <div>
                                <h4 class="mb-1">Đăng ký khóa học</h4>
                                <p class="text-muted mb-0 small">Gửi yêu cầu đăng ký trực tiếp đến hệ thống</p>
                            </div>
                        </div>

                        <div class="course-detail-register-info mb-3">
                            <div class="text-muted small mb-1">Giảng viên chính</div>
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(course.GiaoVienChinh) ? "Đang cập nhật" : course.GiaoVienChinh)</div>
                            @if (!string.IsNullOrWhiteSpace(course.SoDienThoaiGiaoVien))
                            {
                                <div class="small text-muted mt-1">Liên hệ: @course.SoDienThoaiGiaoVien</div>
                            }
                        </div>

                        <div class="course-detail-register-info mb-3">
                            <div class="text-muted small mb-1">Trạng thái nhận đăng ký</div>
                            <div class="fw-semibold @(course.IsOpenForRegistration ? "text-success" : "text-warning")">
                                @(course.IsOpenForRegistration ? "Có thể đăng ký" : "Tạm thời chưa nhận đăng ký")
                            </div>
                        </div>

                       

                        @if (!string.IsNullOrWhiteSpace(Model.PaymentStatusMessage))
                        {
                            <div class="alert @GetRegistrationStateClass(Model.PaymentStatusState) small">
                                <i class="fa fa-circle-info me-2"></i>@Model.PaymentStatusMessage
                            </div>
                        }

                        <form id="courseRegistrationForm" asp-controller="KhoaHoc" asp-action="Register" method="post" class="d-grid gap-2 mb-3 js-submit-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@course.CourseId" />
                            <input type="hidden" id="selectedClassIdInput" name="classId" value="@(Model.SelectedClassId?.ToString() ?? string.Empty)" />
                            <div>
                                <label class="form-label fw-semibold">Lớp đã chọn</label>
                                <div id="selectedClassText" class="selected-class-placeholder">
                                    @(Model.SelectedClassId.HasValue
                                        ? availableClasses.FirstOrDefault(item => item.ClassId == Model.SelectedClassId.Value)?.TenLop ?? "Đã chọn lớp"
                                        : "Bạn cần chọn 1 lớp ở danh sách bên trái")
                                </div>
                            </div>
                            <div>
                                <label class="form-label fw-semibold">Ghi chú</label>
                                <textarea name="ghiChu" class="form-control" rows="3" placeholder="Nhập ghi chú nếu cần"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg js-submit-button" @(course.IsOpenForRegistration && availableClasses.Any(item => item.IsOpenForRegistration) ? null : "disabled")>
                                <span class="js-submit-default">Đăng ký ngay</span>
                                <span class="js-submit-loading d-none"><i class="fa fa-spinner fa-spin me-2"></i>Đang gửi đăng ký...</span>
                            </button>
                        </form>

                        <div class="d-grid gap-2">
                            <a class="btn btn-outline-secondary" asp-controller="KhoaHoc" asp-action="Index">Quay lại danh sách</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .course-detail-hero {
            position: relative;
            overflow: hidden;
            border-radius: 2rem;
            padding: clamp(1.5rem, 4vw, 3rem);
            background: radial-gradient(circle at top left, rgba(247, 185, 0, .22), transparent 34%), linear-gradient(135deg, #ffffff 0%, #fff8df 52%, #f7b900 100%);
            color: #0b2c4d;
            display: grid;
            grid-template-columns: minmax(0, 1.4fr) minmax(280px, .75fr);
            gap: 2rem;
            border: 1px solid rgba(247, 185, 0, .28);
            box-shadow: 0 22px 60px rgba(11, 44, 77, .12);
        }

        .course-detail-hero::after {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            right: -80px;
            top: -80px;
            border-radius: 50%;
            background: rgba(11, 44, 77, .08);
        }

        .course-detail-hero__content,
        .course-detail-hero__panel {
            position: relative;
            z-index: 1;
        }

        .course-detail-hero__badges {
            display: flex;
            flex-wrap: wrap;
            gap: .65rem;
            margin-bottom: 1.25rem;
        }

        .course-detail-hero__badge {
            display: inline-flex;
            align-items: center;
            padding: .55rem 1rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, .78);
            border: 1px solid rgba(247, 185, 0, .34);
            color: #0b2c4d;
            font-weight: 800;
            font-size: .86rem;
            box-shadow: 0 8px 20px rgba(11, 44, 77, .06);
        }

        .course-detail-hero__badge--status {
            color: #15803d;
            background: rgba(240, 253, 244, .88);
            border-color: rgba(34, 197, 94, .3);
        }

        .course-detail-hero__title {
            max-width: 760px;
            font-size: clamp(2rem, 4vw, 3.5rem);
            font-weight: 900;
            line-height: 1.08;
            margin-bottom: 1rem;
        }

        .course-detail-hero__text {
            max-width: 720px;
            color: #526173;
            font-size: 1.05rem;
            line-height: 1.7;
            margin: 0;
        }

        .course-detail-hero__panel {
            display: grid;
            gap: 1rem;
            align-content: center;
        }

        .course-detail-highlight {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem;
            border-radius: 1.25rem;
            background: rgba(255, 255, 255, .76);
            border: 1px solid rgba(255, 255, 255, .72);
            backdrop-filter: blur(10px);
            box-shadow: 0 12px 30px rgba(11, 44, 77, .08);
        }

        .course-detail-highlight__icon {
            width: 56px;
            height: 56px;
            border-radius: 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f7b900, #ffc93c);
            color: #0b2c4d;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .course-detail-highlight__label,
        .course-detail-highlight strong {
            display: block;
        }

        .course-detail-highlight__label {
            color: #6b7280;
            font-size: .85rem;
            margin-bottom: .15rem;
        }

        .course-detail-highlight strong {
            color: #111827;
            font-size: 1.05rem;
            font-weight: 900;
        }

        .course-detail-metric,
        .course-detail-section,
        .course-detail-register-card {
            border-radius: 1.35rem;
            border: 1px solid #edf2f7;
            background: linear-gradient(135deg, #fffbeb 0%, #ffffff 100%);
            box-shadow: 0 4px 16px rgba(0, 0, 0, .06);
        }

        .course-detail-metric {
            padding: 1.15rem;
        }

        .course-detail-metric--white {
            background: #ffffff;
        }

        .course-detail-metric__icon {
            width: 44px;
            height: 44px;
            border-radius: .9rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: .85rem;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #ffffff;
            box-shadow: 0 6px 16px rgba(245, 158, 11, .24);
        }

        .course-detail-progress {
            padding: 1.25rem;
            border-radius: 1.25rem;
            background: #ffffff;
            border: 1px solid #edf2f7;
            box-shadow: 0 4px 14px rgba(15, 23, 42, .05);
        }

        .course-detail-progress .progress {
            height: 12px;
            border-radius: 999px;
            background: rgba(15, 23, 42, .08);
        }

        .course-detail-progress .progress-bar {
            border-radius: 999px;
        }

        .course-detail-section {
            padding: 1.5rem;
            background: #ffffff;
        }

        .course-detail-register-card {
            padding: 1.5rem;
            background: linear-gradient(135deg, #ffffff 0%, #fff8df 100%);
        }

        .course-detail-register-card__header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .course-detail-register-card__icon {
            width: 56px;
            height: 56px;
            border-radius: 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: #ffffff;
            font-size: 1.25rem;
            box-shadow: 0 8px 18px rgba(59, 130, 246, .24);
            flex-shrink: 0;
        }

        .course-detail-register-info {
            padding: 1rem;
            border-radius: 1rem;
            background: rgba(255, 255, 255, .82);
            border: 1px solid #edf2f7;
        }

        .course-detail-register-card textarea.form-control {
            border-radius: 1rem;
        }

        .course-detail-register-card .btn {
            border-radius: 1rem;
            font-weight: 800;
        }

        .class-list-grid {
            display: grid;
            gap: 1rem;
        }

        .class-card {
            position: relative;
            display: block;
            padding: 1.25rem;
            border: 1px solid #e5e7eb;
            border-radius: 1.15rem;
            background: linear-gradient(135deg, #ffffff 0%, #fffdf7 100%);
            cursor: pointer;
            transition: all .2s ease;
            width: 100%;
            min-width: 0;
            overflow: hidden;
            box-sizing: border-box;
        }

        .class-card:hover {
            border-color: #f59e0b;
            box-shadow: 0 12px 24px rgba(245, 158, 11, .12);
        }

        .class-card.is-selected {
            border-color: #2563eb;
            box-shadow: 0 14px 28px rgba(37, 99, 235, .14);
        }

        .class-card.is-disabled {
            opacity: .75;
            cursor: not-allowed;
        }

        .class-card__top {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .class-card__title-row {
            display: flex;
            align-items: center;
            gap: .75rem;
        }

        .class-card__radio {
            width: 1.1rem;
            height: 1.1rem;
            accent-color: #2563eb;
        }

        .class-card__meta {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .75rem;
            font-size: .95rem;
            margin-bottom: 1rem;
        }

        .class-card__schedule {
            padding: 1rem;
            border-radius: 1rem;
            background: #fff;
            border: 1px dashed #e5e7eb;
            max-height: 540px;
            overflow: auto;
            overscroll-behavior: contain;
            width: 100%;
            min-width: 0;
            box-sizing: border-box;
        }

        .class-card__schedule .weekly-schedule-wrapper,
        .class-card__schedule .table-responsive,
        .class-card__schedule table {
            max-width: 100%;
            box-sizing: border-box;
        }

        .class-card__schedule .weekly-schedule-wrapper,
        .class-card__schedule .table-responsive {
            overflow-x: auto;
        }

        .class-list-grid,
        .course-detail-section,
        .class-card__top,
        .class-card__meta {
            min-width: 0;
        }

        .class-card__schedule::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        .class-card__schedule::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, .8);
            border-radius: 999px;
        }

        .class-card__schedule::-webkit-scrollbar-track {
            background: rgba(241, 245, 249, .9);
            border-radius: 999px;
        }

        .class-schedule-item {
            padding: .75rem;
            border-radius: .85rem;
            background: #f8fafc;
        }

        .class-card__overlay-note {
            margin-top: 1rem;
            font-size: .92rem;
            color: #b45309;
        }

        .course-empty-state {
            padding: 2rem 1rem;
            border-radius: 1rem;
            background: #f8fafc;
            border: 1px dashed #cbd5e1;
        }

        .selected-class-placeholder {
            padding: .95rem 1rem;
            border-radius: 1rem;
            background: rgba(255,255,255,.8);
            border: 1px solid #e5e7eb;
            font-weight: 600;
            color: #0f172a;
        }

        @@media (max-width: 991.98px) {
            .course-detail-hero {
                grid-template-columns: 1fr;
            }

            .class-card__meta {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('courseRegistrationForm');
            if (!form) {
                return;
            }

            var classInputs = document.querySelectorAll('input[name="classId"]');
            var classCards = document.querySelectorAll('[data-class-card]');
            var selectedClassText = document.getElementById('selectedClassText');
            var selectedClassIdInput = document.getElementById('selectedClassIdInput');
            var submitButton = form.querySelector('.js-submit-button');
            var defaultText = form.querySelector('.js-submit-default');
            var loadingText = form.querySelector('.js-submit-loading');

            function clearSelection() {
                classCards.forEach(function (card) {
                    card.classList.remove('is-selected');
                });

                classInputs.forEach(function (input) {
                    input.checked = false;
                });

                if (selectedClassIdInput) {
                    selectedClassIdInput.value = '';
                }

                if (selectedClassText) {
                    selectedClassText.textContent = 'Bạn cần chọn 1 lớp ở danh sách bên trái';
                }
            }

            function selectCard(card) {
                var classId = card.getAttribute('data-class-id') || '';
                var className = card.getAttribute('data-class-name') || 'Đã chọn lớp';

                classCards.forEach(function (item) {
                    item.classList.remove('is-selected');
                });

                classInputs.forEach(function (input) {
                    input.checked = input.value === classId;
                });

                card.classList.add('is-selected');

                if (selectedClassIdInput) {
                    selectedClassIdInput.value = classId;
                }

                if (selectedClassText) {
                    selectedClassText.textContent = className;
                }
            }

            classCards.forEach(function (card) {
                card.addEventListener('click', function (event) {
                    if (event.target.closest('a, button')) {
                        return;
                    }

                    if (card.getAttribute('data-selectable') !== 'true') {
                        return;
                    }

                    var currentClassId = card.getAttribute('data-class-id') || '';
                    var isAlreadySelected = selectedClassIdInput && selectedClassIdInput.value === currentClassId;

                    if (isAlreadySelected) {
                        clearSelection();
                        return;
                    }

                    selectCard(card);
                });
            });

            classInputs.forEach(function (input) {
                input.addEventListener('click', function (event) {
                    event.preventDefault();
                });
            });

            form.addEventListener('submit', function (event) {
                if (!selectedClassIdInput || !selectedClassIdInput.value) {
                    event.preventDefault();
                    window.alert('Vui lòng chọn một lớp đang mở đăng ký trước khi gửi yêu cầu.');
                    return;
                }

                if (submitButton) {
                    submitButton.disabled = true;
                }

                if (defaultText) {
                    defaultText.classList.add('d-none');
                }

                if (loadingText) {
                    loadingText.classList.remove('d-none');
                }
            });
        })();
    </script>
}
