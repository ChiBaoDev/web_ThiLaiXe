@model webthibanglai.Models.LichHocViewModel
@{
    ViewData["Title"] = "Trang học viên";
    var profile = Model.Profile;
    var stats = Model.Stats;
    var registration = Model.Registration;
}

<div id="studentPortalPage" class="container-xxl py-5 student-portal-page">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(Model.RegistrationSuccessMessage))
        {
            <div class="alert alert-success rounded-4 border-0 shadow-sm mb-4">@Model.RegistrationSuccessMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(TempData["StudentProfileNotice"]?.ToString()))
        {
            <div class="alert alert-warning rounded-4 border-0 shadow-sm mb-4">
                <i class="fas fa-circle-info me-2"></i>@TempData["StudentProfileNotice"]
            </div>
        }

        @if (!Model.HasStudentProfile)
        {
            <div class="student-register-shell mb-5">
                <div class="student-register-shell__backdrop"></div>
                <div class="row g-4 align-items-stretch position-relative">
                    <div class="col-lg-5">
                        <div class="student-register-intro h-100">
                            <span class="badge rounded-pill student-register-intro__badge">Chưa có hồ sơ học viên</span>
                            <h2 class="student-register-intro__title mt-4 mb-3">Đăng ký hồ sơ để mở khóa đầy đủ lịch học và tiện ích cá nhân</h2>
                            <p class="student-register-intro__text mb-4">Sau khi hoàn tất đăng ký, hệ thống sẽ hiển thị thông tin học viên, lịch học, khóa học đã đăng ký và các thống kê ôn tập ngay trên trang này.</p>

                            <div class="student-register-highlight-list d-grid gap-3">
                                <div class="student-register-highlight-item">
                                    <div class="student-register-highlight-item__icon"><i class="fas fa-id-card"></i></div>
                                    <div>
                                        <div class="fw-semibold">Thông tin hồ sơ rõ ràng</div>
                                        <div class="small text-muted">Khai báo họ tên, ngày sinh, CCCD và địa chỉ chính xác để đối chiếu.</div>
                                    </div>
                                </div>
                                <div class="student-register-highlight-item">
                                    <div class="student-register-highlight-item__icon"><i class="fas fa-calendar-check"></i></div>
                                    <div>
                                        <div class="fw-semibold">Đồng bộ lịch học</div>
                                        <div class="small text-muted">Nhận lịch học và lộ trình khóa học phù hợp với hồ sơ học viên.</div>
                                    </div>
                                </div>
                                <div class="student-register-highlight-item">
                                    <div class="student-register-highlight-item__icon"><i class="fas fa-shield-alt"></i></div>
                                    <div>
                                        <div class="fw-semibold">Bảo mật và tiện lợi</div>
                                        <div class="small text-muted">Dữ liệu được gắn với tài khoản để theo dõi mọi lúc trên cổng học viên.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <div class="student-register-card h-100">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                                <div>
                                    <span class="student-register-card__eyebrow">Form đăng ký học viên</span>
                                    <h3 class="h4 mb-1 mt-2">Hoàn thiện thông tin trong vài bước</h3>
                                    <p class="text-muted mb-0">Vui lòng điền đúng thông tin để trung tâm xác nhận hồ sơ nhanh hơn.</p>
                                </div>
                                <div class="student-register-card__step">Bước 1/1</div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.RegistrationErrorMessage))
                            {
                                <div class="alert alert-danger rounded-4 border-0 mb-4">@Model.RegistrationErrorMessage</div>
                            }

                            <form asp-controller="LichHoc" asp-action="RegisterStudentProfile" method="post" class="row g-3">
                                @Html.AntiForgeryToken()

                                <div class="col-12">
                                    <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                                    <input asp-for="Registration.HoTen" class="form-control form-control-lg student-register-input" placeholder="Ví dụ: Nguyễn Văn A" value="@registration.HoTen" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Ngày sinh</label>
                                    <input asp-for="Registration.NgaySinh" type="date" class="form-control student-register-input" value="@registration.NgaySinh" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Giới tính</label>
                                    <select asp-for="Registration.GioiTinh" class="form-select student-register-input">
                                        <option value="">Chọn giới tính</option>
                                        <option value="Nam" selected="@(registration.GioiTinh == "Nam")">Nam</option>
                                        <option value="Nữ" selected="@(registration.GioiTinh == "Nữ")">Nữ</option>
                                        <option value="Khác" selected="@(registration.GioiTinh == "Khác")">Khác</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">CCCD</label>
                                    <input asp-for="Registration.Cccd" class="form-control student-register-input" placeholder="Nhập số CCCD" value="@registration.Cccd" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Ảnh chân dung</label>
                                    <input asp-for="Registration.AnhChanDung" class="form-control student-register-input" placeholder="Dán URL ảnh chân dung nếu có" value="@registration.AnhChanDung" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Địa chỉ</label>
                                    <textarea asp-for="Registration.DiaChi" class="form-control student-register-input" rows="4" placeholder="Nhập địa chỉ hiện tại">@registration.DiaChi</textarea>
                                </div>
                                <div class="col-12">
                                    <div class="student-register-card__footer d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                        <div class="small text-muted">
                                            <i class="fas fa-circle-info me-2 text-primary"></i>Thông tin của bạn sẽ được dùng để đối chiếu hồ sơ học viên tại trung tâm.
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-lg px-4 student-register-submit">
                                            <i class="fas fa-user-plus me-2"></i>Đăng ký học viên
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.HasStudentProfile)
        {
        <div class="row g-4 mb-4 align-items-stretch">
            <div class="col-lg-8">
                <div class="bg-white shadow-sm rounded-4 p-4 border h-100 student-hero-card">
                    <span class="badge bg-primary-subtle text-primary px-3 py-2 mb-3">Cổng thông tin học viên</span>
                    <div class="d-flex flex-column flex-md-row gap-4 align-items-md-center">
                        <div class="student-avatar flex-shrink-0">@profile.Initials</div>
                        <div class="flex-grow-1">
                            <h1 class="display-6 mb-2">@(string.IsNullOrWhiteSpace(profile.HoTen) ? "Học viên" : profile.HoTen)</h1>
                            <p class="text-muted mb-3">Theo dõi hồ sơ cá nhân, kết quả ôn luyện, khóa học đã đăng ký và lịch học của bạn trên cùng một màn hình.</p>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge rounded-pill bg-light text-dark border px-3 py-2"><i class="fas fa-id-card me-2 text-primary"></i>Mã học viên: @profile.HocVienId</span>
                                <span class="badge rounded-pill bg-light text-dark border px-3 py-2"><i class="fas fa-user-check me-2 text-success"></i>@(string.IsNullOrWhiteSpace(profile.TrangThai) ? "Đang hoạt động" : profile.TrangThai)</span>
                                <span class="badge rounded-pill bg-light text-dark border px-3 py-2"><i class="fas fa-layer-group me-2 text-warning"></i>@Model.RegisteredCourses.Count khóa học</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="bg-white shadow-sm rounded-4 p-4 border h-100">
                    <h3 class="h5 mb-3">Thông tin học viên</h3>
                    <div class="student-info-list d-grid gap-3">
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">Tên đăng nhập</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.TenDangNhap) ? "Chưa cập nhật" : profile.TenDangNhap)</strong></div>
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">Email</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.Email) ? "Chưa cập nhật" : profile.Email)</strong></div>
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">Số điện thoại</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.SoDienThoai) ? "Chưa cập nhật" : profile.SoDienThoai)</strong></div>
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">Ngày sinh</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.NgaySinhText) ? "Chưa cập nhật" : profile.NgaySinhText)</strong></div>
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">Giới tính</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.GioiTinh) ? "Chưa cập nhật" : profile.GioiTinh)</strong></div>
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">CCCD</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.Cccd) ? "Chưa cập nhật" : profile.Cccd)</strong></div>
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">Địa chỉ</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.DiaChi) ? "Chưa cập nhật" : profile.DiaChi)</strong></div>
                    </div>
                </div>
            </div>
        </div>
        }

        @if (Model.HasStudentProfile)
        {
        <div class="row g-4 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="portal-stat-card stat-primary h-100">
                    <div class="portal-stat-card__glow"></div>
                    <div class="portal-stat-card__topbar">
                        <div class="portal-stat-card__icon"><i class="fas fa-trophy"></i></div>
                        <span class="portal-stat-card__pill">Kết quả</span>
                    </div>
                    <div class="portal-stat-card__value">@stats.PassRate.ToString("0.##")%</div>
                    <div class="portal-stat-card__label">Tỉ lệ thi đậu</div>
                    <div class="portal-stat-card__sub">Đậu @stats.PassedExams / @stats.TotalExams bài thi</div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="portal-stat-card stat-success h-100">
                    <div class="portal-stat-card__glow"></div>
                    <div class="portal-stat-card__topbar">
                        <div class="portal-stat-card__icon"><i class="fas fa-bullseye"></i></div>
                        <span class="portal-stat-card__pill">Chính xác</span>
                    </div>
                    <div class="portal-stat-card__value">@stats.CorrectAnswers</div>
                    <div class="portal-stat-card__label">Câu đúng</div>
                    <div class="portal-stat-card__sub">Điểm trung bình @stats.AverageScore.ToString("0.##")</div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="portal-stat-card stat-warning h-100">
                    <div class="portal-stat-card__glow"></div>
                    <div class="portal-stat-card__topbar">
                        <div class="portal-stat-card__icon"><i class="fas fa-redo-alt"></i></div>
                        <span class="portal-stat-card__pill">Ôn lại</span>
                    </div>
                    <div class="portal-stat-card__value">@stats.WrongAnswers</div>
                    <div class="portal-stat-card__label">Câu sai</div>
                    <div class="portal-stat-card__sub">@stats.WrongQuestionCount câu đang cần ôn lại</div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="portal-stat-card stat-danger h-100">
                    <div class="portal-stat-card__glow"></div>
                    <div class="portal-stat-card__topbar">
                        <div class="portal-stat-card__icon"><i class="fas fa-exclamation-triangle"></i></div>
                        <span class="portal-stat-card__pill">Cảnh báo</span>
                    </div>
                    <div class="portal-stat-card__value">@stats.CriticalWrongCount</div>
                    <div class="portal-stat-card__label">Câu điểm liệt sai</div>
                    <div class="portal-stat-card__sub">Tỷ lệ lỗi @stats.CriticalErrorRate.ToString("0.##")%</div>
                </div>
            </div>
        </div>

        <div class="bg-white shadow-sm rounded-4 p-4 border mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="h5 mb-1">Ôn tập nhanh</h3>
                    <p class="text-muted mb-0">Truy cập nhanh vào khu vực ôn tập của bạn</p>
                </div>
                <a asp-controller="OnTap" asp-action="Index" class="btn btn-warning">
                    <i class="fas fa-book-open me-2"></i>Xem tất cả
                </a>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-4">
                <div class="bg-white shadow-sm rounded-4 p-4 border h-100">
                    <h3 class="h5 mb-3">Tóm tắt ôn luyện</h3>
                    <div class="d-grid gap-3">
                        <div class="summary-item">
                            <span class="summary-item__label">Số bài ôn đã làm</span>
                            <strong class="summary-item__value">@stats.PracticeCount</strong>
                        </div>
                        <div class="summary-item">
                            <span class="summary-item__label">Bài thi chưa đạt</span>
                            <strong class="summary-item__value">@stats.FailedExams</strong>
                        </div>
                        <div class="summary-item">
                            <span class="summary-item__label">Lượt làm câu điểm liệt</span>
                            <strong class="summary-item__value">@stats.TotalCriticalAttempts</strong>
                        </div>
                        <div class="summary-item">
                            <span class="summary-item__label">Trạng thái học tập</span>
                            <strong class="summary-item__value text-success">Duy trì ôn luyện đều</strong>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="bg-white shadow-sm rounded-4 p-4 border h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h3 class="h5 mb-1">Các khóa học đã đăng ký</h3>
                            <p class="text-muted mb-0">Hiển thị tĩnh để mô phỏng lộ trình học hiện tại của học viên.</p>
                        </div>
                        <a asp-controller="KhoaHoc" asp-action="Index" class="btn btn-outline-primary">
                            <i class="fas fa-layer-group me-2"></i>Xem khóa học
                        </a>
                    </div>
                    <div class="row g-3">
                        @foreach (var course in Model.RegisteredCourses)
                        {
                            <div class="col-md-6">
                                <div class="course-card h-100">
                                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                        <h4 class="h6 mb-0">@course.Name</h4>
                                        <span class="badge rounded-pill bg-light text-primary border">@course.Status</span>
                                    </div>
                                    <p class="text-muted small mb-3">@course.Description</p>
                                    <div class="small text-muted d-grid gap-2">
                                        <div><i class="far fa-clock me-2 text-primary"></i>@course.ScheduleText</div>
                                        <div><i class="fas fa-chalkboard-teacher me-2 text-primary"></i>@course.TeacherName</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="bg-white shadow-sm rounded-4 p-4 border h-100">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div>
                            <h3 class="h5 mb-1">Lịch học của khóa học</h3>
                            <p class="text-muted mb-0">Phần lịch học hiện đang dùng dữ liệu tĩnh theo yêu cầu.</p>
                        </div>
                        <span class="badge bg-primary-subtle text-primary px-3 py-2">Lịch học minh họa</span>
                    </div>

                    <div class="schedule-list d-grid gap-3">
                        @foreach (var item in Model.Schedule)
                        {
                            <div class="schedule-item schedule-@item.AccentClass">
                                <div class="schedule-item__day">@item.DayLabel</div>
                                <div class="schedule-item__body">
                                    <div class="schedule-item__title">@item.Title</div>
                                    <div class="schedule-item__meta"><i class="far fa-clock me-2"></i>@item.TimeText</div>
                                    <div class="schedule-item__meta"><i class="fas fa-map-marker-alt me-2"></i>@item.Location</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="bg-primary text-white shadow-sm rounded-4 p-4 h-100">
                    <h3 class="h5 mb-3">Lưu ý cho học viên</h3>
                    <ul class="mb-4 ps-3 d-grid gap-2">
                        <li>Đến trước giờ học ít nhất 15 phút và chuẩn bị CCCD khi cần đối chiếu.</li>
                        <li>Ôn lại toàn bộ câu sai sau mỗi lần làm bài để cải thiện tỉ lệ đậu.</li>
                        <li>Ưu tiên luyện lại câu điểm liệt trước kỳ sát hạch chính thức.</li>
                        <li>Theo dõi các khóa đã đăng ký để không bỏ lỡ lịch học quan trọng.</li>
                    </ul>
                    <div class="portal-note-box bg-white text-dark rounded-4 p-3">
                        <div class="fw-semibold mb-1">Mục tiêu tuần này</div>
                        <div class="small text-muted">Hoàn thành thêm ít nhất 3 bài ôn và giữ tỉ lệ chính xác trên 80%.</div>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .student-portal-page {
            background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
        }

        .student-hero-card {
            overflow: hidden;
        }

        .student-avatar {
            width: 92px;
            height: 92px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0d6efd, #4f8dfd);
            color: #fff;
            font-size: 2rem;
            font-weight: 700;
            box-shadow: 0 18px 32px rgba(13, 110, 253, .22);
        }

        .student-register-card {
            background: linear-gradient(180deg, #ffffff 0%, #fffdf8 100%);
            border: 1px solid #f0e2b6;
            border-radius: 1.5rem;
            padding: 1.5rem;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.6);
        }

        .student-register-shell {
            position: relative;
            overflow: hidden;
            border-radius: 2rem;
            padding: 2rem;
            background: linear-gradient(180deg, #ffffff 0%, #fffaf0 100%);
            border: 10px solid #f3bd00;
            box-shadow: 0 24px 60px rgba(243, 189, 0, 0.12);
        }

        .student-register-shell__backdrop {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at top right, rgba(243, 189, 0, .14), transparent 28%),
                radial-gradient(circle at bottom left, rgba(243, 189, 0, .10), transparent 24%);
            pointer-events: none;
        }

        .student-register-intro {
            position: relative;
            z-index: 1;
            color: #1f2937;
            padding: 1rem;
        }

        .student-register-intro__badge {
            background: #fff8df;
            color: #a16207;
            border: 1px solid #f0e2b6;
            padding: .7rem 1rem;
            font-size: .82rem;
            letter-spacing: .02em;
        }

        .student-register-intro__title {
            font-size: clamp(1.8rem, 3vw, 2.4rem);
            font-weight: 800;
            line-height: 1.2;
        }

        .student-register-intro__text {
            max-width: 36rem;
            color: #6b7280;
            font-size: 1rem;
        }

        .student-register-highlight-item {
            display: flex;
            gap: 1rem;
            align-items: flex-start;
            padding: 1rem 1.1rem;
            border-radius: 1.25rem;
            background: #fffef9;
            border: 1px solid #f0e2b6;
            box-shadow: 0 10px 24px rgba(243, 189, 0, 0.08);
        }

        .student-register-highlight-item__icon {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #fff8df;
            border: 1px solid #f0e2b6;
            color: #a16207;
            font-size: 1.05rem;
            flex-shrink: 0;
        }

        .student-register-card__eyebrow {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: .45rem .85rem;
            background: #fff8df;
            color: #a16207;
            font-size: .82rem;
            font-weight: 700;
        }

        .student-register-card__step {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 90px;
            padding: .65rem 1rem;
            border-radius: 999px;
            background: #fff8df;
            color: #7c5a00;
            font-weight: 700;
            border: 1px solid #f0e2b6;
        }

        .student-register-input {
            border-radius: 1rem;
            border-color: #e5e7eb;
