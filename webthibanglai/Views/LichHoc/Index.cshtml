@model webthibanglai.Models.LichHocViewModel
@{
    ViewData["Title"] = "Trang học viên";
    var profile = Model.Profile;
    var stats = Model.Stats;
}

<div id="studentPortalPage" class="container-xxl py-5 student-portal-page">
    <div class="container">
        <div class="row g-4 mb-4 align-items-stretch">
            <div class="col-lg-8">
                <div class="bg-white shadow-sm rounded-4 p-4 border h-100 student-hero-card">
                    <span class="badge bg-primary-subtle text-primary px-3 py-2 mb-3">Cổng thông tin học viên</span>
                    <div class="d-flex flex-column flex-md-row gap-4 align-items-md-center">
                        <div class="student-avatar flex-shrink-0">@profile.Initials</div>
                        <div class="flex-grow-1">
                            <h1 class="display-6 mb-2">@(string.IsNullOrWhiteSpace(profile.HoTen) ? "Học viên" : profile.HoTen)</h1>
                            <p class="text-muted mb-3">Theo dõi hồ sơ cá nhân, kết quả ôn luyện, khóa học đã đăng ký và lịch học của bạn trên cùng một màn hình.</p>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge rounded-pill bg-light text-dark border px-3 py-2"><i class="fas fa-id-card me-2 text-primary"></i>Mã học viên: @(profile.HocVienId > 0 ? profile.HocVienId : 0)</span>
                                <span class="badge rounded-pill bg-light text-dark border px-3 py-2"><i class="fas fa-user-check me-2 text-success"></i>@(string.IsNullOrWhiteSpace(profile.TrangThai) ? "Đang hoạt động" : profile.TrangThai)</span>
                                <span class="badge rounded-pill bg-light text-dark border px-3 py-2"><i class="fas fa-layer-group me-2 text-warning"></i>@Model.RegisteredCourses.Count khóa học</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="bg-white shadow-sm rounded-4 p-4 border h-100">
                    <h3 class="h5 mb-3">Thông tin học viên</h3>
                    <div class="student-info-list d-grid gap-3">
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">Tên đăng nhập</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.TenDangNhap) ? "Chưa cập nhật" : profile.TenDangNhap)</strong></div>
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">Email</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.Email) ? "Chưa cập nhật" : profile.Email)</strong></div>
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">Số điện thoại</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.SoDienThoai) ? "Chưa cập nhật" : profile.SoDienThoai)</strong></div>
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">Ngày sinh</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.NgaySinhText) ? "Chưa cập nhật" : profile.NgaySinhText)</strong></div>
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">Giới tính</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.GioiTinh) ? "Chưa cập nhật" : profile.GioiTinh)</strong></div>
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">CCCD</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.Cccd) ? "Chưa cập nhật" : profile.Cccd)</strong></div>
                        <div class="d-flex justify-content-between gap-3 align-items-start"><span class="text-muted">Địa chỉ</span><strong class="text-end">@(string.IsNullOrWhiteSpace(profile.DiaChi) ? "Chưa cập nhật" : profile.DiaChi)</strong></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="portal-stat-card stat-primary h-100">
                    <div class="portal-stat-card__glow"></div>
                    <div class="portal-stat-card__topbar">
                        <div class="portal-stat-card__icon"><i class="fas fa-trophy"></i></div>
                        <span class="portal-stat-card__pill">Kết quả</span>
                    </div>
                    <div class="portal-stat-card__value">@stats.PassRate.ToString("0.##")%</div>
                    <div class="portal-stat-card__label">Tỉ lệ thi đậu</div>
                    <div class="portal-stat-card__sub">Đậu @stats.PassedExams / @stats.TotalExams bài thi</div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="portal-stat-card stat-success h-100">
                    <div class="portal-stat-card__glow"></div>
                    <div class="portal-stat-card__topbar">
                        <div class="portal-stat-card__icon"><i class="fas fa-bullseye"></i></div>
                        <span class="portal-stat-card__pill">Chính xác</span>
                    </div>
                    <div class="portal-stat-card__value">@stats.CorrectAnswers</div>
                    <div class="portal-stat-card__label">Câu đúng</div>
                    <div class="portal-stat-card__sub">Điểm trung bình @stats.AverageScore.ToString("0.##")</div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="portal-stat-card stat-warning h-100">
                    <div class="portal-stat-card__glow"></div>
                    <div class="portal-stat-card__topbar">
                        <div class="portal-stat-card__icon"><i class="fas fa-redo-alt"></i></div>
                        <span class="portal-stat-card__pill">Ôn lại</span>
                    </div>
                    <div class="portal-stat-card__value">@stats.WrongAnswers</div>
                    <div class="portal-stat-card__label">Câu sai</div>
                    <div class="portal-stat-card__sub">@stats.WrongQuestionCount câu đang cần ôn lại</div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="portal-stat-card stat-danger h-100">
                    <div class="portal-stat-card__glow"></div>
                    <div class="portal-stat-card__topbar">
                        <div class="portal-stat-card__icon"><i class="fas fa-exclamation-triangle"></i></div>
                        <span class="portal-stat-card__pill">Cảnh báo</span>
                    </div>
                    <div class="portal-stat-card__value">@stats.CriticalWrongCount</div>
                    <div class="portal-stat-card__label">Câu điểm liệt sai</div>
                    <div class="portal-stat-card__sub">Tỷ lệ lỗi @stats.CriticalErrorRate.ToString("0.##")%</div>
                </div>
            </div>
        </div>

        <div class="bg-white shadow-sm rounded-4 p-4 border mb-4 practice-panel">
            <button class="practice-panel__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#studentPracticeCollapse" aria-expanded="true" aria-controls="studentPracticeCollapse">
                <span>
                    <span class="practice-panel__eyebrow">Ôn tập học viên</span>
                    <span class="practice-panel__title">Khu vực ôn tập nhanh</span>
                    <span class="practice-panel__desc">Thu gọn hoặc mở rộng danh sách ôn tập. Các mục chưa có API vẫn hiển thị tĩnh.</span>
                </span>
                <span class="practice-panel__toggle-icon"><i class="fas fa-chevron-down"></i></span>
            </button>

            <div id="studentPracticeCollapse" class="collapse show">
                <div class="practice-grid">
                <a asp-controller="Exam" asp-action="Index" class="practice-shortcut practice-amber text-decoration-none">
                    <span class="practice-shortcut__icon"><i class="fas fa-book"></i></span>
                    <span class="practice-shortcut__content">
                        <span class="practice-shortcut__title">Ôn tập tất cả</span>
                        <span class="practice-shortcut__meta">Mở nhanh khu vực luyện đề tổng hợp dành cho học viên.</span>
                    </span>
                    <span class="practice-shortcut__footer"><i class="fas fa-arrow-right"></i>Bắt đầu ôn</span>
                </a>

                <a asp-controller="Exam" asp-action="Index" class="practice-shortcut practice-red text-decoration-none">
                    <span class="practice-shortcut__icon"><i class="fas fa-random"></i></span>
                    <span class="practice-shortcut__content">
                        <span class="practice-shortcut__title">Đề ngẫu nhiên</span>
                        <span class="practice-shortcut__meta">Đi tới phần thi thử với bộ câu hỏi chọn nhanh.</span>
                    </span>
                    <span class="practice-shortcut__footer"><i class="fas fa-play"></i>Vào luyện đề</span>
                </a>

                <a asp-controller="Exam" asp-action="Index" class="practice-shortcut practice-pink text-decoration-none">
                    <span class="practice-shortcut__icon"><i class="fas fa-th-large"></i></span>
                    <span class="practice-shortcut__content">
                        <span class="practice-shortcut__title">Ôn theo bộ đề</span>
                        <span class="practice-shortcut__meta">Dùng điều hướng hiện có để vào danh sách đề luyện tập.</span>
                    </span>
                    <span class="practice-shortcut__footer"><i class="fas fa-folder-open"></i>Xem bộ đề</span>
                </a>

                <div class="practice-shortcut practice-lime practice-shortcut--static">
                    <span class="practice-shortcut__icon"><i class="fas fa-exclamation-triangle"></i></span>
                    <span class="practice-shortcut__content">
                        <span class="practice-shortcut__title">Câu điểm liệt</span>
                        <span class="practice-shortcut__meta">Hiện làm tĩnh vì chưa có API danh sách riêng các câu điểm liệt sai.</span>
                    </span>
                    <span class="practice-shortcut__footer"><i class="fas fa-info-circle"></i>Đang mô phỏng</span>
                </div>

                <div class="practice-shortcut practice-cyan practice-shortcut--static">
                    <span class="practice-shortcut__icon"><i class="fas fa-lightbulb"></i></span>
                    <span class="practice-shortcut__content">
                        <span class="practice-shortcut__title">Mẹo ghi nhớ</span>
                        <span class="practice-shortcut__meta">Khu vực mẹo học nhanh đang hiển thị giao diện mẫu cho học viên.</span>
                    </span>
                    <span class="practice-shortcut__footer"><i class="fas fa-star"></i>Nội dung tĩnh</span>
                </div>

                <div class="practice-shortcut practice-blue practice-shortcut--static">
                    <span class="practice-shortcut__icon"><i class="fas fa-list-ol"></i></span>
                    <span class="practice-shortcut__content">
                        <span class="practice-shortcut__title">Top câu sai</span>
                        <span class="practice-shortcut__meta">Tạm hiển thị kiểu thẻ vì chưa có API top câu sai theo học viên.</span>
                    </span>
                    <span class="practice-shortcut__footer"><i class="fas fa-chart-line"></i>Chưa nối dữ liệu</span>
                </div>

                <div class="practice-shortcut practice-indigo practice-shortcut--static">
                    <span class="practice-shortcut__icon"><i class="fas fa-map-signs"></i></span>
                    <span class="practice-shortcut__content">
                        <span class="practice-shortcut__title">Biển báo GT</span>
                        <span class="practice-shortcut__meta">Chuyên đề biển báo đang là giao diện tĩnh do chưa có API riêng.</span>
                    </span>
                    <span class="practice-shortcut__footer"><i class="fas fa-route"></i>Chuyên đề mẫu</span>
                </div>

                <a asp-controller="KhoaHoc" asp-action="Index" class="practice-shortcut practice-purple text-decoration-none">
                    <span class="practice-shortcut__icon"><i class="fas fa-car"></i></span>
                    <span class="practice-shortcut__content">
                        <span class="practice-shortcut__title">Tập lái</span>
                        <span class="practice-shortcut__meta">Đi tới khu vực khóa học và nội dung liên quan phần thực hành.</span>
                    </span>
                    <span class="practice-shortcut__footer"><i class="fas fa-arrow-right"></i>Xem khóa học</span>
                </a>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-4">
                <div class="bg-white shadow-sm rounded-4 p-4 border h-100">
                    <h3 class="h5 mb-3">Tóm tắt ôn luyện</h3>
                    <div class="d-grid gap-3">
                        <div class="summary-item">
                            <span class="summary-item__label">Số bài ôn đã làm</span>
                            <strong class="summary-item__value">@stats.PracticeCount</strong>
                        </div>
                        <div class="summary-item">
                            <span class="summary-item__label">Bài thi chưa đạt</span>
                            <strong class="summary-item__value">@stats.FailedExams</strong>
                        </div>
                        <div class="summary-item">
                            <span class="summary-item__label">Lượt làm câu điểm liệt</span>
                            <strong class="summary-item__value">@stats.TotalCriticalAttempts</strong>
                        </div>
                        <div class="summary-item">
                            <span class="summary-item__label">Trạng thái học tập</span>
                            <strong class="summary-item__value text-success">Duy trì ôn luyện đều</strong>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="bg-white shadow-sm rounded-4 p-4 border h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h3 class="h5 mb-1">Các khóa học đã đăng ký</h3>
                            <p class="text-muted mb-0">Hiển thị tĩnh để mô phỏng lộ trình học hiện tại của học viên.</p>
                        </div>
                        <a asp-controller="KhoaHoc" asp-action="Index" class="btn btn-outline-primary">
                            <i class="fas fa-layer-group me-2"></i>Xem khóa học
                        </a>
                    </div>
                    <div class="row g-3">
                        @foreach (var course in Model.RegisteredCourses)
                        {
                            <div class="col-md-6">
                                <div class="course-card h-100">
                                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                        <h4 class="h6 mb-0">@course.Name</h4>
                                        <span class="badge rounded-pill bg-light text-primary border">@course.Status</span>
                                    </div>
                                    <p class="text-muted small mb-3">@course.Description</p>
                                    <div class="small text-muted d-grid gap-2">
                                        <div><i class="far fa-clock me-2 text-primary"></i>@course.ScheduleText</div>
                                        <div><i class="fas fa-chalkboard-teacher me-2 text-primary"></i>@course.TeacherName</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="bg-white shadow-sm rounded-4 p-4 border h-100">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div>
                            <h3 class="h5 mb-1">Lịch học của khóa học</h3>
                            <p class="text-muted mb-0">Phần lịch học hiện đang dùng dữ liệu tĩnh theo yêu cầu.</p>
                        </div>
                        <span class="badge bg-primary-subtle text-primary px-3 py-2">Lịch học minh họa</span>
                    </div>

                    <div class="schedule-list d-grid gap-3">
                        @foreach (var item in Model.Schedule)
                        {
                            <div class="schedule-item schedule-@item.AccentClass">
                                <div class="schedule-item__day">@item.DayLabel</div>
                                <div class="schedule-item__body">
                                    <div class="schedule-item__title">@item.Title</div>
                                    <div class="schedule-item__meta"><i class="far fa-clock me-2"></i>@item.TimeText</div>
                                    <div class="schedule-item__meta"><i class="fas fa-map-marker-alt me-2"></i>@item.Location</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="bg-primary text-white shadow-sm rounded-4 p-4 h-100">
                    <h3 class="h5 mb-3">Lưu ý cho học viên</h3>
                    <ul class="mb-4 ps-3 d-grid gap-2">
                        <li>Đến trước giờ học ít nhất 15 phút và chuẩn bị CCCD khi cần đối chiếu.</li>
                        <li>Ôn lại toàn bộ câu sai sau mỗi lần làm bài để cải thiện tỉ lệ đậu.</li>
                        <li>Ưu tiên luyện lại câu điểm liệt trước kỳ sát hạch chính thức.</li>
                        <li>Theo dõi các khóa đã đăng ký để không bỏ lỡ lịch học quan trọng.</li>
                    </ul>
                    <div class="portal-note-box bg-white text-dark rounded-4 p-3">
                        <div class="fw-semibold mb-1">Mục tiêu tuần này</div>
                        <div class="small text-muted">Hoàn thành thêm ít nhất 3 bài ôn và giữ tỉ lệ chính xác trên 80%.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .student-portal-page {
            background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
        }

        .student-hero-card {
            overflow: hidden;
        }

        .student-avatar {
            width: 92px;
            height: 92px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0d6efd, #4f8dfd);
            color: #fff;
            font-size: 2rem;
            font-weight: 700;
            box-shadow: 0 18px 32px rgba(13, 110, 253, .22);
        }

        .portal-stat-card {
            position: relative;
            overflow: hidden;
            border-radius: 1.75rem;
            padding: 1.5rem;
            color: #fff;
            box-shadow: 0 18px 40px rgba(15, 23, 42, .12);
            isolation: isolate;
        }

        .portal-stat-card__glow {
            position: absolute;
            inset: auto -40px -55px auto;
            width: 140px;
            height: 140px;
            border-radius: 999px;
            background: rgba(255,255,255,.12);
            filter: blur(4px);
            z-index: -1;
        }

        .portal-stat-card__topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .portal-stat-card__icon {
            width: 56px;
            height: 56px;
            border-radius: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.14);
            backdrop-filter: blur(10px);
            font-size: 1.35rem;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.18);
        }
        .portal-stat-card__pill {
            display: inline-flex;
            align-items: center;
            padding: .45rem .8rem;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .02em;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.14);
        }

        .portal-stat-card__value {
            font-size: 2rem;
            font-weight: 800;
            line-height: 1;
            margin-bottom: .5rem;
        }

        .portal-stat-card__label {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: .25rem;
        }

        .portal-stat-card__sub {
            font-size: .92rem;
            opacity: .92;
        }

        .stat-primary { background: linear-gradient(135deg, #2563eb, #60a5fa); }
        .stat-success { background: linear-gradient(135deg, #059669, #34d399); }
        .stat-warning { background: linear-gradient(135deg, #f59e0b, #fcd34d); }
        .stat-danger { background: linear-gradient(135deg, #e11d48, #fb7185); }
        .practice-panel {
            overflow: hidden;
        }

        .practice-panel__toggle {
            width: 100%;
            border: 0;
            background: transparent;
            padding: 0;
            margin: 0 0 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            text-align: left;
        }

        .practice-panel__eyebrow {
            display: inline-block;
            margin-bottom: .35rem;
            padding: .35rem .7rem;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 700;
            color: #b45309;
            background: #fff7e6;
        }

        .practice-panel__title {
            display: block;
            font-size: 1.45rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: .2rem;
        }

        .practice-panel__desc {
            display: block;
            color: #64748b;
            font-size: .96rem;
        }

        .practice-panel__toggle-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #0f172a;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: transform .2s ease;
        }

        .practice-panel__toggle[aria-expanded="true"] .practice-panel__toggle-icon {
            transform: rotate(180deg);
        }

        .practice-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .85rem;
        }

        .practice-shortcut {
            min-height: 168px;
            border-radius: 1.1rem;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: #fff;
            box-shadow: 0 14px 28px rgba(15, 23, 42, .10);
            transition: transform .2s ease, box-shadow .2s ease;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.18);
            text-decoration: none;
        }

        .practice-shortcut::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(255,255,255,.14), rgba(255,255,255,.03));
            pointer-events: none;
        }

        .practice-shortcut:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 34px rgba(15, 23, 42, .14);
            color: #fff;
        }

        .practice-shortcut__icon,
        .practice-shortcut__content,
        .practice-shortcut__footer {
            position: relative;
            z-index: 1;
        }

        .practice-shortcut__icon {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
