@using webthibanglai.Services
@{
    ViewData["Title"] = "Ôn tập";
    var apiBaseUrl = (Context.RequestServices.GetService<IConfiguration>()?["ApiSettings:BaseUrl"] ?? string.Empty).TrimEnd('/');
    var topicCode = ViewBag.TopicCode as string ?? "";
    var topicName = ViewBag.TopicName as string ?? "Ôn tập";
    var questions = ViewBag.Questions as List<PracticeQuestion> ?? new List<PracticeQuestion>();
    var currentNumber = ViewBag.CurrentNumber as int? ?? 1;
    var isEmbedded = ViewBag.IsEmbedded as bool? ?? false;
    var total = questions.Count;
    var current = Math.Min(Math.Max(currentNumber, 1), Math.Max(total, 1));
    var currentQuestion = questions.ElementAtOrDefault(current - 1);

    if (currentQuestion == null)
    {
        <div class="container py-5">
            <div class="alert alert-danger">Không tìm thấy câu hỏi.</div>
        </div>
        return;
    }

    var questionId = currentQuestion.Id;
    var content = currentQuestion.Content;
    var isCritical = currentQuestion.IsCritical;
    var rawImageUrl = currentQuestion.ImageUrl;
    var imageUrl = !string.IsNullOrWhiteSpace(rawImageUrl) && Uri.TryCreate(rawImageUrl, UriKind.Absolute, out _)
        ? rawImageUrl
        : (!string.IsNullOrWhiteSpace(rawImageUrl) && !string.IsNullOrWhiteSpace(apiBaseUrl)
            ? $"{apiBaseUrl}/{rawImageUrl.TrimStart('/')}"
            : rawImageUrl);
    var explanation = currentQuestion.Explanation ?? string.Empty;
    var answers = currentQuestion.Answers;
    var orderedAnswers = answers.OrderBy(x => x.Order).ToList();
}

<div class="container py-5 session-practice-page @(isEmbedded ? "embedded-mode" : string.Empty)" id="practiceSessionContainer">
    <div class="practice-hero mb-4">
        <div class="row g-4 align-items-center position-relative">
            <div class="col-lg-7">
                <span class="badge rounded-pill bg-light text-primary px-3 py-2 mb-3">Chế độ ôn tập</span>
                <h1 class="display-5 fw-bold mb-3">@topicName</h1>
                <p class="lead mb-4">Làm bài ôn tập với phản hồi ngay lập tức. Khi chọn sai, hệ thống sẽ thông báo và lưu câu sai để bạn xem lại trong chính phiên hiện tại.</p>
                <div class="d-flex flex-wrap gap-3">
                    <div class="practice-panel-glass px-3 py-2">
                        <i class="fas fa-layer-group me-2"></i>@total câu hỏi
                    </div>
                    <div class="practice-panel-glass px-3 py-2">
                        <i class="fas fa-book-open me-2"></i>Ôn tập
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="practice-panel-glass p-4">
                    <h4 class="fw-bold mb-3 text-dark">Thông tin ôn tập</h4>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="bg-white text-dark rounded-4 p-3 h-100">
                                <div class="small text-uppercase text-muted mb-1">Câu hiện tại</div>
                                <div class="fs-3 fw-bold">@current/@total</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="bg-white text-dark rounded-4 p-3 h-100">
                                <div class="small text-uppercase text-muted mb-1">Câu sai</div>
                                <div id="wrongCountBox" class="fs-3 fw-bold text-danger">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="practice-shell">
        <div class="practice-workspace">
            <aside class="practice-sidebar">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <div class="text-uppercase small text-muted mb-1">Chủ đề ôn tập</div>
                        <h4 class="mb-0">@topicName</h4>
                    </div>
                    <span class="badge rounded-pill bg-success px-3 py-2">Ôn tập</span>
                </div>

                <div class="sidebar-stat mb-3">
                    <span class="text-muted small">Tiến độ làm bài</span>
                    <strong id="answeredProgressText">0/@total</strong>
                    <div class="progress mt-3" style="height: 10px;">
                        <div id="answeredProgressBar" class="progress-bar bg-success" role="progressbar" style="width: 0%"></div>
                    </div>
                </div>

                <div class="sidebar-stat mb-3">
                    <span class="text-muted small">Câu hiện tại</span>
                    <strong>Câu @current</strong>
                    <div class="text-muted">Chọn đáp án để kiểm tra ngay lập tức.</div>
                </div>

                <div class="practice-fullscreen-note mb-3" id="practiceFeedback">
                    <i class="fas fa-circle-info me-2"></i><span id="practiceFeedbackText">Chọn đáp án để kiểm tra</span>
                </div>

                <button type="button" class="btn btn-warning w-100 py-3 fw-semibold mb-3 practice-finish-button" id="finishPracticeButton">
                    <i class="fas fa-flag-checkered me-2"></i>Kết thúc bài và xem kết quả
                </button>

                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">Tổng quan</h6>
                        <span class="small text-muted">Câu @current / @total</span>
                    </div>
                    <div class="question-palette">
                        @for (var i = 1; i <= total; i++)
                        {
                            <button type="button" class="palette-btn @(i == current ? "active" : "")"
                               data-question-number="@i"
                               data-navigate-to="@i">@i</button>
                        }
                    </div>
                </div>
            </aside>

            <section class="practice-stage">
                <div class="practice-stage-header">
                    <div class="question-progress">
                        <div class="question-progress-badge">
                            <i class="fas fa-location-arrow"></i>
                            <span>Câu @current / @total</span>
                        </div>
                        <div>
                            <h5 class="question-progress-title">Bạn đang làm đến câu @current</h5>
                            <p class="question-progress-subtitle">@(isCritical ? "Đây là câu điểm liệt, cần chú ý chọn đáp án chính xác." : "Đọc kỹ nội dung câu hỏi và chọn đáp án phù hợp nhất.")</p>
                        </div>
                    </div>
                </div>

                <form id="practiceAnswerForm" data-check-url="@Url.Action("CheckAnswer", "OnTap")" data-topic-code="@topicCode">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="questionId" value="@questionId" />

                    <div class="practice-question-card">
                        <div>
                            <span class="question-tag">Câu hỏi @current/@total</span>
                            <div class="question-text">@content</div>
                            @if (!string.IsNullOrWhiteSpace(imageUrl))
                            {
                                <img src="@imageUrl" alt="Hình minh họa câu hỏi" class="question-image" />
                            }
                            <div class="option-list">
                                @foreach (var answer in orderedAnswers)
                                {
                                    var answerId = answer.AnswerId;
                                    var answerContent = answer.Content;
                                    var answerOrder = answer.Order;
                                    var answerIsCorrect = answer.IsCorrect == true;

                                    <div class="option-item selectable" data-answer-id="@answerId" data-is-correct="@answerIsCorrect.ToString().ToLower()">
                                        <input class="option-input" type="radio" name="answerId" id="answer-@answerId" value="@answerId" />
                                        <label class="option-label w-100" for="answer-@answerId">
                                            <span class="option-marker">@((char)('A' + Math.Max(answerOrder - 1, 0)))</span>
                                            <span class="option-copy">@answerContent</span>
                                        </label>
                                    </div>
                                }
                            </div>

                            <div id="practiceExplanation" class="practice-explanation mt-4" style="display:none;">
                                <div class="practice-explanation-title">
                                    <i class="fas fa-lightbulb me-2"></i>Giải thích đáp án
                                </div>
                                <div id="practiceExplanationText" class="practice-explanation-text"></div>
                            </div>
                        </div>
                        <div class="text-muted mt-4">Mã câu hỏi: @questionId</div>
                    </div>

                    <div class="practice-nav">
                        <div class="d-flex gap-2 flex-wrap">
                            @if (current > 1)
                            {
                                <button type="button" class="btn btn-outline-secondary px-4" data-navigate-to="@(current - 1)">
                                    <i class="fas fa-arrow-left me-2"></i>Câu trước
                                </button>
                            }
                            @if (current < total)
                            {
                                <button type="button" class="btn btn-primary px-4" data-navigate-to="@(current + 1)">
                                    Câu tiếp theo<i class="fas fa-arrow-right ms-2"></i>
                                </button>
                            }
                        </div>
                        @if (!isEmbedded)
                        {
                            <a asp-controller="OnTap" asp-action="Index" class="btn btn-outline-primary px-4 py-2">Quay lại danh sách</a>
                        }
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Styles {
    <style>
        body:has(.session-practice-page) .container-fluid.bg-dark.text-light.p-0,
        body:has(.session-practice-page) .navbar,
        body:has(.session-practice-page) footer,
        body:has(.session-practice-page) .footer,
        body:has(.session-practice-page) .copyright,
        body:has(.session-practice-page) .back-to-top {
            display: none !important;
        }

        .session-practice-page {
            max-width: 1320px;
        }

        .practice-hero,
        .practice-stage,
        .practice-question-card,
        .practice-sidebar {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 28px;
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.08);
        }

        .practice-hero {
            padding: 2rem;
            background: linear-gradient(180deg, #ffffff 0%, #f0fdf4 100%);
        }

        .practice-panel-glass {
            border-radius: 18px;
            background: rgba(255,255,255,.85);
            border: 1px solid #dbeafe;
        }

        .practice-shell {
            padding: .25rem;
        }

        .practice-workspace {
            display: grid;
            grid-template-columns: 320px minmax(0, 1fr);
            gap: 1.5rem;
            align-items: start;
        }

        .practice-sidebar,
        .practice-stage,
        .practice-question-card {
            padding: 1.5rem;
        }

        .practice-sidebar {
            position: sticky;
            top: 1rem;
        }

        .practice-stage-header,
        .practice-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .question-progress {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .question-progress-badge {
            min-width: max-content;
            background: #dcfce7;
            color: #166534;
            border-radius: 999px;
            padding: .8rem 1.1rem;
            font-weight: 700;
        }

        .question-progress-title {
            font-weight: 800;
            margin-bottom: .35rem;
        }

        .question-progress-subtitle,
        .text-muted {
            color: #6b7280 !important;
        }

        .question-tag {
            display: inline-block;
            margin-bottom: 1rem;
            border-radius: 999px;
            padding: .65rem 1rem;
            background: #dcfce7;
            color: #166534;
            font-weight: 700;
        }

        .question-text {
            font-size: 1.28rem;
            font-weight: 700;
            line-height: 1.55;
            color: #0f172a;
        }

        .question-image {
            display: block;
            max-width: 100%;
            border-radius: 20px;
            margin-top: 1rem;
            border: 1px solid #e5e7eb;
        }

        .option-list {
            display: grid;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .option-item {
            border: 1px solid #e5e7eb;
            border-radius: 22px;
            transition: all .2s ease;
            background: #fff;
        }

        .option-item.selectable:hover {
            border-color: #86efac;
            box-shadow: 0 12px 30px rgba(34, 197, 94, 0.12);
            transform: translateY(-1px);
        }

        .option-item.selected {
            border-color: #60a5fa;
            box-shadow: 0 0 0 3px rgba(96, 165, 250, .12);
        }

        .option-item.correct {
            border-color: #22c55e;
            background: #f0fdf4;
        }

        .option-item.wrong {
            border-color: #ef4444;
            background: #fef2f2;
        }

        .option-item.disabled {
            pointer-events: none;
        }

        .option-input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .option-label {
            display: flex;
            gap: 1rem;
            align-items: flex-start;
            padding: 1.2rem 1.3rem;
            cursor: pointer;
        }

        .option-marker {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #f0fdf4;
            color: #166534;
            font-size: 1.25rem;
            font-weight: 800;
            flex-shrink: 0;
        }

        .option-copy {
            font-size: 1rem;
            line-height: 1.7;
            color: #334155;
        }

        .practice-explanation {
            padding: 1rem 1.1rem;
            border-radius: 18px;
            background: #fffbeb;
            border: 1px solid #fde68a;
        }

        .practice-explanation-title {
            font-weight: 800;
            color: #b45309;
            margin-bottom: .5rem;
        }

        .practice-explanation-text {
            color: #78350f;
            line-height: 1.65;
        }

        .sidebar-stat,
        .practice-fullscreen-note {
            padding: 1rem 1.1rem;
            border-radius: 18px;
            background: #f8fafc;
            border: 1px solid #e5e7eb;
        }

        .practice-fullscreen-note.status-correct {
            background: #f0fdf4;
            border-color: #86efac;
            color: #166534;
        }

        .practice-fullscreen-note.status-wrong {
            background: #fef2f2;
            border-color: #fca5a5;
            color: #b91c1c;
        }

        .question-palette {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: .75rem;
        }

        .palette-btn {
            border: 1px solid #bbf7d0;
            background: #f0fdf4;
            color: #166534;
            border-radius: 16px;
            min-height: 52px;
            font-weight: 700;
        }

        .palette-btn.active {
            background: #22c55e;
            color: #fff;
            border-color: #22c55e;
        }

        .palette-btn.answered {
            background: #dcfce7;
        }

        .palette-btn.wrong {
            background: #fef2f2;
            border-color: #fca5a5;
            color: #b91c1c;
        }

        .practice-finish-button {
            box-shadow: 0 12px 24px rgba(234, 179, 8, .22);
        }

        @@media (max-width: 991.98px) {
            .practice-workspace {
                grid-template-columns: 1fr;
            }

            .practice-sidebar {
                position: static;
            }

            .practice-nav,
            .question-progress {
                flex-direction: column;
                align-items: stretch;
            }

            .question-palette {
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }
        }

        @@media (max-width: 575.98px) {
            .practice-hero,
            .practice-sidebar,
            .practice-stage,
            .practice-question-card {
                padding: 1rem;
                border-radius: 20px;
            }

            .question-palette {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .option-label {
                padding: 1rem;
            }
        }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var practiceForm = document.getElementById('practiceAnswerForm');
            var feedback = document.getElementById('practiceFeedback');
            var feedbackText = document.getElementById('practiceFeedbackText');
            var explanationBox = document.getElementById('practiceExplanation');
            var explanationText = document.getElementById('practiceExplanationText');
            var tokenField = practiceForm ? practiceForm.querySelector('input[name="__RequestVerificationToken"]') : null;
            var progressText = document.getElementById('answeredProgressText');
            var progressBar = document.getElementById('answeredProgressBar');
            var wrongCountBox = document.getElementById('wrongCountBox');
            var checkUrl = practiceForm ? (practiceForm.getAttribute('data-check-url') || '') : '';
            var topicCode = practiceForm ? (practiceForm.getAttribute('data-topic-code') || '') : '';
            var totalQuestions = @total;
            var currentQuestionNumber = @current;
            var questionId = @questionId;
            var currentExplanation = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(explanation ?? string.Empty));
            var sessionResultState = { answeredQuestions: [], wrongQuestions: [] };
            var isCheckingAnswer = false;
            var isNavigating = false;
            var isEmbedded = @(isEmbedded ? "true" : "false");

            function setFeedback(message, state) {
                if (!feedback || !feedbackText) return;
                feedback.classList.remove('status-correct', 'status-wrong');
                if (state) feedback.classList.add(state);
                feedbackText.textContent = message || 'Chọn đáp án để kiểm tra';
            }

            function setExplanation(text, visible) {
                if (!explanationBox || !explanationText) return;
                var normalized = (text || '').toString().trim();
                explanationText.textContent = normalized;
                explanationBox.style.display = visible && normalized ? 'block' : 'none';
            }

            function normalizeImageUrl(imageUrl) {
                if (!imageUrl) return imageUrl;
                if (/^https?:\/\//i.test(imageUrl) || imageUrl.startsWith('//') || !@Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiBaseUrl))) {
                    return imageUrl;
                }

                var apiBaseUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiBaseUrl));
                return apiBaseUrl.replace(/\/$/, '') + '/' + imageUrl.replace(/^\//, '');
            }

            function getAnsweredQuestions() {
                return Array.isArray(sessionResultState.answeredQuestions) ? sessionResultState.answeredQuestions.slice() : [];
            }

            function saveAnsweredQuestions(items) {
                var normalized = Array.from(new Set(items.map(function (value) { return parseInt(value, 10); }).filter(function (value) {
                    return !isNaN(value) && value >= 1 && value <= totalQuestions;
                }))).sort(function (a, b) { return a - b; });
                sessionResultState.answeredQuestions = normalized;
                return normalized;
            }

            function markAnswered(questionNumber) {
                return saveAnsweredQuestions(getAnsweredQuestions().concat([questionNumber]));
            }

            function getWrongQuestions() {
                return Array.isArray(sessionResultState.wrongQuestions) ? sessionResultState.wrongQuestions.slice() : [];
            }

            function saveWrongQuestions(items) {
                var normalized = Array.from(new Set(items.map(function (value) { return parseInt(value, 10); }).filter(function (value) {
                    return !isNaN(value) && value >= 1 && value <= totalQuestions;
                }))).sort(function (a, b) { return a - b; });
                sessionResultState.wrongQuestions = normalized;
                return normalized;
            }

            function markWrong(questionNumber) {
                return saveWrongQuestions(getWrongQuestions().concat([questionNumber]));
            }

            function renderAnsweredState() {
                var answeredQuestions = getAnsweredQuestions();
                var wrongQuestions = getWrongQuestions();
                var answeredCount = answeredQuestions.length;
                var wrongCount = wrongQuestions.length;
                var answeredMap = new Set(answeredQuestions);
                var wrongMap = new Set(wrongQuestions);
                var answeredPercent = totalQuestions <= 0 ? 0 : Math.max(0, Math.min(100, Math.round(answeredCount / totalQuestions * 100)));

                document.querySelectorAll('.palette-btn[data-question-number]').forEach(function (button) {
                    var number = parseInt(button.getAttribute('data-question-number') || '', 10);
                    button.classList.remove('answered', 'wrong');
                    if (wrongMap.has(number)) button.classList.add('wrong');
                    else if (answeredMap.has(number)) button.classList.add('answered');
                });

                if (progressText) progressText.textContent = answeredCount + '/' + totalQuestions;
                if (progressBar) {
                    progressBar.style.width = answeredPercent + '%';
                    progressBar.setAttribute('aria-valuenow', answeredPercent.toString());
                }
                if (wrongCountBox) wrongCountBox.textContent = wrongCount.toString();
            }

            function disableAllOptions() {
                if (!practiceForm) return;
                practiceForm.querySelectorAll('.option-item.selectable').forEach(function (item) { item.classList.add('disabled'); });
                practiceForm.querySelectorAll('input[name="answerId"]').forEach(function (input) { input.disabled = true; });
            }

            function highlightAnswers(selectedAnswerId, correctAnswerId, isCorrect) {
                if (!practiceForm) return;
                practiceForm.querySelectorAll('.option-item.selectable').forEach(function (item) {
                    var itemAnswerId = parseInt(item.getAttribute('data-answer-id') || '0', 10);
                    if (itemAnswerId === correctAnswerId) item.classList.add('correct');
                    if (!isCorrect && itemAnswerId === selectedAnswerId) item.classList.add('wrong');
                });
            }

            function finalizeAnswerResult(isCorrectResult, selectedAnswerIdResult, correctAnswerIdResult, explanationTextResult) {
                if (isCorrectResult) setFeedback('✓ Chính xác! Đáp án đúng.', 'status-correct');
                else {
                    setFeedback('✗ Sai rồi! Đáp án đúng đã được đánh dấu màu xanh.', 'status-wrong');
                    markWrong(currentQuestionNumber);
                }
                highlightAnswers(selectedAnswerIdResult, correctAnswerIdResult, isCorrectResult);
                setExplanation(explanationTextResult || currentExplanation, true);
                disableAllOptions();
                renderAnsweredState();
                isCheckingAnswer = false;
            }

            function checkAnswer(answerId) {
                if (isCheckingAnswer || !practiceForm) return;
                isCheckingAnswer = true;
                setFeedback('Đang kiểm tra...', '');

                var selectedAnswer = null;
                var correctAnswer = null;
                practiceForm.querySelectorAll('.option-item.selectable').forEach(function (item) {
                    var itemAnswerId = parseInt(item.getAttribute('data-answer-id') || '0', 10);
                    var itemIsCorrect = item.getAttribute('data-is-correct') === 'true';
                    if (itemAnswerId === answerId) selectedAnswer = { id: itemAnswerId, isCorrect: itemIsCorrect };
                    if (itemIsCorrect) correctAnswer = { id: itemAnswerId };
                });

                if (!selectedAnswer || !correctAnswer) {
                    setFeedback('Lỗi: Không tìm thấy thông tin đáp án.', 'status-wrong');
                    isCheckingAnswer = false;
                    return;
                }

                markAnswered(currentQuestionNumber);

                if (checkUrl && tokenField) {
                    fetch(checkUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': tokenField.value,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ topicCode: topicCode, questionId: questionId, answerId: answerId })
                    })
                    .then(function (response) {
                        if (!response.ok) throw new Error('HTTP ' + response.status);
                        return response.json();
                    })
                    .then(function (result) {
                        if (!result || !result.success) {
                            throw new Error(result && result.message ? result.message : 'Không thể kiểm tra đáp án.');
                        }
                        currentExplanation = result.explanation || currentExplanation || '';
                        finalizeAnswerResult(result.isCorrect === true, parseInt(result.selectedAnswerId, 10), parseInt(result.correctAnswerId, 10), result.explanation || currentExplanation);
                    })
                    .catch(function () {
                        finalizeAnswerResult(selectedAnswer.isCorrect === true, selectedAnswer.id, correctAnswer.id, currentExplanation);
                    });
                    return;
                }

                finalizeAnswerResult(selectedAnswer.isCorrect === true, selectedAnswer.id, correctAnswer.id, currentExplanation);
            }

            function navigateToQuestion(questionNumber) {
                if (isNavigating) return;
                if (questionNumber < 1 || questionNumber > totalQuestions) return;
                isNavigating = true;
                setFeedback('Đang tải câu hỏi...', '');

                var url = '@Url.Action("GetQuestionJson", "OnTap")' + '?topicCode=' + encodeURIComponent(topicCode) + '&number=' + questionNumber;
                fetch(url)
                    .then(function (response) {
                        if (!response.ok) throw new Error('HTTP ' + response.status);
                        return response.json();
                    })
                    .then(function (data) {
                        if (!data.success || !data.question) throw new Error('Invalid response data');
                        updateQuestionUI(data.question);
                        var newUrl = '@Url.Action("Session", "OnTap")' + '?topicCode=' + encodeURIComponent(topicCode) + '&number=' + questionNumber + (isEmbedded ? '&embedded=true' : '');
                        window.history.pushState({ questionNumber: questionNumber }, '', newUrl);
                        isNavigating = false;
                    })
                    .catch(function () {
                        setFeedback('Lỗi tải câu hỏi. Vui lòng thử lại.', 'status-wrong');
                        isNavigating = false;
                    });
            }

            function updateNavigationButtons(currentNum, totalNum) {
                var navContainer = document.querySelector('.practice-nav .d-flex');
                if (!navContainer) return;
                navContainer.innerHTML = '';

                if (currentNum > 1) {
                    var prevBtn = document.createElement('button');
                    prevBtn.type = 'button';
                    prevBtn.className = 'btn btn-outline-secondary px-4';
                    prevBtn.setAttribute('data-navigate-to', currentNum - 1);
                    prevBtn.innerHTML = '<i class="fas fa-arrow-left me-2"></i>Câu trước';
                    navContainer.appendChild(prevBtn);
                }

                if (currentNum < totalNum) {
                    var nextBtn = document.createElement('button');
                    nextBtn.type = 'button';
                    nextBtn.className = 'btn btn-primary px-4';
                    nextBtn.setAttribute('data-navigate-to', currentNum + 1);
                    nextBtn.innerHTML = 'Câu tiếp theo<i class="fas fa-arrow-right ms-2"></i>';
                    navContainer.appendChild(nextBtn);
                }

                attachNavigationListeners();
            }

            function updateQuestionUI(question) {
                currentQuestionNumber = question.number;
                questionId = question.id;
                currentExplanation = question.explanation || '';

                var questionTag = document.querySelector('.question-tag');
                if (questionTag) questionTag.textContent = 'Câu hỏi ' + question.number + '/' + question.total;

                var questionText = document.querySelector('.question-text');
                if (questionText) questionText.textContent = question.content;
                setExplanation('', false);

                var questionImage = document.querySelector('.question-image');
                if (question.imageUrl) {
                    if (!questionImage && questionText) {
                        questionImage = document.createElement('img');
                        questionImage.className = 'question-image';
                        questionImage.alt = 'Hình minh họa câu hỏi';
                        questionText.parentNode.insertBefore(questionImage, questionText.nextSibling);
                    }
                    if (questionImage) {
                        questionImage.src = normalizeImageUrl(question.imageUrl);
                        questionImage.style.display = 'block';
                    }
                } else if (questionImage) {
                    questionImage.style.display = 'none';
                }

                var optionList = document.querySelector('.option-list');
                if (optionList) {
                    optionList.innerHTML = '';
                    question.answers.forEach(function (answer, index) {
                        var optionItem = document.createElement('div');
                        optionItem.className = 'option-item selectable';
                        optionItem.setAttribute('data-answer-id', answer.answerId);
                        optionItem.setAttribute('data-is-correct', answer.isCorrect ? 'true' : 'false');
                        optionItem.innerHTML = '<input class="option-input" type="radio" name="answerId" id="answer-' + answer.answerId + '" value="' + answer.answerId + '" />'
                            + '<label class="option-label w-100" for="answer-' + answer.answerId + '">'
                            + '<span class="option-marker">' + String.fromCharCode(65 + index) + '</span>'
                            + '<span class="option-copy">' + answer.content + '</span>'
                            + '</label>';
                        optionList.appendChild(optionItem);
                    });
                    attachAnswerListeners();
                }

                var questionIdInput = document.querySelector('input[name="questionId"]');
                if (questionIdInput) questionIdInput.value = question.id;

                var questionCodeDisplay = document.querySelector('.practice-question-card .text-muted');
                if (questionCodeDisplay) questionCodeDisplay.textContent = 'Mã câu hỏi: ' + question.id;

                var progressBadge = document.querySelector('.question-progress-badge span');
                if (progressBadge) progressBadge.textContent = 'Câu ' + question.number + ' / ' + question.total;

                var progressTitle = document.querySelector('.question-progress-title');
                if (progressTitle) progressTitle.textContent = 'Bạn đang làm đến câu ' + question.number;

                var progressSubtitle = document.querySelector('.question-progress-subtitle');
                if (progressSubtitle) {
                    progressSubtitle.textContent = question.isCritical ? 'Đây là câu điểm liệt, cần chú ý chọn đáp án chính xác.' : 'Đọc kỹ nội dung câu hỏi và chọn đáp án phù hợp nhất.';
                }

                var sidebarCurrent = document.querySelector('.sidebar-stat strong');
                if (sidebarCurrent) sidebarCurrent.textContent = 'Câu ' + question.number;

                var paletteProgress = document.querySelector('.question-palette').previousElementSibling.querySelector('.small.text-muted');
                if (paletteProgress) paletteProgress.textContent = 'Câu ' + question.number + ' / ' + question.total;

                document.querySelectorAll('.palette-btn[data-question-number]').forEach(function (btn) {
                    var btnNumber = parseInt(btn.getAttribute('data-question-number'), 10);
                    btn.classList.toggle('active', btnNumber === question.number);
                });

                updateNavigationButtons(question.number, question.total);
                setFeedback('Chọn đáp án để kiểm tra', '');
                isCheckingAnswer = false;
            }

            function attachAnswerListeners() {
                if (!practiceForm) return;
                practiceForm.querySelectorAll('input[name="answerId"]').forEach(function (input) {
                    input.addEventListener('change', function () {
                        if (input.disabled) return;
                        practiceForm.querySelectorAll('.option-item.selectable').forEach(function (item) { item.classList.remove('selected'); });
                        var optionItem = input.closest('.option-item.selectable');
                        if (optionItem) optionItem.classList.add('selected');
                        checkAnswer(parseInt(input.value, 10));
                    });
                });
            }

            function attachNavigationListeners() {
                document.querySelectorAll('[data-navigate-to]').forEach(function (btn) {
                    btn.addEventListener('click', function (e) {
                        e.preventDefault();
                        var targetNumber = parseInt(btn.getAttribute('data-navigate-to'), 10);
                        navigateToQuestion(targetNumber);
                    });
                });
            }

            function goToResult() {
                var answered = encodeURIComponent(JSON.stringify(getAnsweredQuestions()));
                var wrong = encodeURIComponent(JSON.stringify(getWrongQuestions()));
                var resultUrl = '@Url.Action("Result", "OnTap")' + '?topicCode=' + encodeURIComponent(topicCode) + '&total=' + encodeURIComponent(totalQuestions) + '&answered=' + answered + '&wrong=' + wrong + (isEmbedded ? '&embedded=true' : '');
                window.location.assign(resultUrl);
            }

            if (isEmbedded === true || isEmbedded === 'true') {
                document.body.classList.add('embedded-practice-mode');
            }

            var finishPracticeButton = document.getElementById('finishPracticeButton');
            if (finishPracticeButton) {
                finishPracticeButton.addEventListener('click', function () {
                    goToResult();
                });
            }

            renderAnsweredState();
            attachAnswerListeners();
            attachNavigationListeners();

            window.addEventListener('popstate', function (event) {
                if (event.state && event.state.questionNumber) {
                    navigateToQuestion(event.state.questionNumber);
                }
            });
        })();
    </script>
}
