@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div id="profilePage" class="container-xxl py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="bg-white shadow-sm rounded-4 p-4 h-100 border">
                    <div class="text-center">
                        <div id="profileAvatar" class="mx-auto d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold mb-3" style="width: 110px; height: 110px; font-size: 2.5rem;">NA</div>
                        <h3 id="profileFullName" class="h4 mb-1">Nguyễn Văn A</h3>
                        <p class="text-muted mb-3">Email: <span id="profileUsername">nguyenvana@gmail.com</span></p>
                        <span id="profileRole" class="badge bg-warning text-dark px-3 py-2">Học viên</span>
                    </div>

                    <hr class="my-4" />

                    <div class="d-grid gap-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Đăng nhập lúc</span>
                            <strong id="profileLoginAt">15/04/2026 08:30</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Số bài đã ôn</span>
                            <strong id="profileStudyCount">12</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Điểm bài gần nhất</span>
                            <strong id="profileLastScore">88 điểm</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Trạng thái gần nhất</span>
                            <span id="profileLastStatus" class="badge bg-success">Đạt</span>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="button" class="btn btn-outline-danger" data-profile-logout>
                            <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="bg-white shadow-sm rounded-4 p-4 border mb-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                        <div>
                            <h2 class="h3 mb-2">Thông tin chi tiết bản thân</h2>
                            <p class="text-muted mb-0">Theo dõi tiến độ ôn thi, khóa học đang tham gia và quản lý tài khoản học viên tại đây.</p>
                        </div>
                        <a href="/Exam" class="btn btn-primary">
                            <i class="fas fa-book-open me-2"></i>Tiếp tục ôn thi
                        </a>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="border rounded-4 p-4 h-100 bg-light">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div>
                                        <span class="badge bg-primary-subtle text-primary px-3 py-2 mb-3">Khóa học đang học</span>
                                        <h3 id="profileCourseName" class="h4 mb-2">Khóa B2 - Tháng 4/2026</h3>
                                        <p id="profileCourseDescription" class="text-muted mb-3">Thông tin hiển thị theo hướng phù hợp với dữ liệu hồ sơ học viên, đăng ký khóa học và lịch sử ôn tập sau này.</p>
                                    </div>
                                    <i class="fas fa-graduation-cap text-primary fs-2"></i>
                                </div>
                                <div class="d-grid gap-2 small text-muted mb-4">
                                    <div><i class="far fa-calendar-alt text-primary me-2"></i>Ngày đăng ký: <strong id="profileCourseStartDate">01/04/2026</strong></div>
                                    <div><i class="far fa-clock text-primary me-2"></i>Trạng thái đăng ký: <strong id="profileCourseSchedule">Đã duyệt</strong></div>
                                    <div><i class="fas fa-user text-primary me-2"></i>Học viên: <strong id="profileCourseTeacher">Nguyễn Văn A</strong></div>
                                </div>
                                <a id="profileScheduleLink" href="/LichHoc" class="btn btn-outline-primary disabled" aria-disabled="true">
                                    <i class="fas fa-calendar-week me-2"></i>Xem lịch học
                                </a>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-4 p-4 h-100 bg-light">
                                <span class="badge bg-warning text-dark px-3 py-2 mb-3">Tình trạng học tập</span>
                                <h3 class="h4 mb-3">Tiến độ hiện tại</h3>
                                <div class="d-grid gap-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Khóa học đã đăng ký</span>
                                        <strong id="profileRegisteredCourseCount">2</strong>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Buổi học gần nhất</span>
                                        <strong id="profileNextLesson">16/04/2026 18:30</strong>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Trạng thái khóa học</span>
                                        <span id="profileCourseStatus" class="badge bg-success">Đang học</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white shadow-sm rounded-4 p-4 border">
                    <h3 class="h4 mb-3">Đổi mật khẩu</h3>
                    <p class="text-muted">Cập nhật mật khẩu mới để bảo vệ tài khoản của bạn.</p>

                    <form id="changePasswordForm" class="row g-3">
                        <div class="col-12">
                            <label for="currentPassword" class="form-label fw-semibold">Mật khẩu hiện tại</label>
                            <input id="currentPassword" type="password" class="form-control" placeholder="Nhập mật khẩu hiện tại" required />
                        </div>
                        <div class="col-md-6">
                            <label for="newPassword" class="form-label fw-semibold">Mật khẩu mới</label>
                            <input id="newPassword" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                        </div>
                        <div class="col-md-6">
                            <label for="confirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                            <input id="confirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" required />
                        </div>
                        <div class="col-12">
                            <div id="changePasswordMsg" class="alert d-none"></div>
                        </div>
                        <div class="col-12 d-flex flex-wrap gap-3">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-key me-2"></i>Lưu mật khẩu mới
                            </button>
                            <button type="button" class="btn btn-outline-danger px-4" data-profile-logout>
                                <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
