@model webthibanglai.Models.LoginViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var profileHoTen = TempData.Peek("ProfileHoTen")?.ToString();
    var profileTenDangNhap = TempData.Peek("ProfileTenDangNhap")?.ToString();
    var profileEmail = TempData.Peek("ProfileEmail")?.ToString();
    var profileSoDienThoai = TempData.Peek("ProfileSoDienThoai")?.ToString();
    var profileTrangThai = TempData.Peek("ProfileTrangThai")?.ToString();
    var profileNgaySinh = TempData.Peek("ProfileNgaySinh")?.ToString();
    var profileGioiTinh = TempData.Peek("ProfileGioiTinh")?.ToString();
    var profileCccd = TempData.Peek("ProfileCccd")?.ToString();
    var profileDiaChi = TempData.Peek("ProfileDiaChi")?.ToString();
    var profileAnhChanDung = TempData.Peek("ProfileAnhChanDung")?.ToString();
    var profileUserId = TempData.Peek("ProfileUserId")?.ToString();
    var profileHocVienId = TempData.Peek("ProfileHocVienId")?.ToString();
    var profileUpdateSuccess = TempData["ProfileUpdateSuccess"]?.ToString();
    var profileUpdateError = TempData["ProfileUpdateError"]?.ToString();
    var changePasswordSuccess = TempData["ChangePasswordSuccess"]?.ToString();
    var changePasswordError = TempData["ChangePasswordError"]?.ToString();
    var initials = !string.IsNullOrWhiteSpace(profileHoTen)
        ? string.Concat(profileHoTen.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])))
        : "U";
    var roleLabel = "Học viên";
    var statusLabel = string.IsNullOrWhiteSpace(profileTrangThai) ? "Chưa cập nhật" : profileTrangThai;
    var profileName = !string.IsNullOrWhiteSpace(profileHoTen) ? profileHoTen : profileTenDangNhap ?? "Người dùng";
}

<div id="profilePage" class="container-xxl py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="bg-white shadow-sm rounded-4 p-4 h-100 border profile-card-main">
                    <div class="text-center">
                        <div id="profileAvatar" class="profile-avatar mx-auto d-flex align-items-center justify-content-center rounded-circle text-white fw-bold mb-3">@initials</div>
                        <h3 id="profileFullName" class="h4 mb-1">@profileName</h3>
                        <p class="text-muted mb-3">Email: <span id="profileUsername">@(profileEmail ?? "")</span></p>
                        <span id="profileRole" class="badge bg-warning text-dark px-3 py-2">@roleLabel</span>
                    </div>

                    <hr class="my-4" />

                    <div class="d-grid gap-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Đăng nhập lúc</span>
                            <strong id="profileLoginAt">Đã đăng nhập</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Tình trạng hồ sơ</span>
                            <strong id="profileStudyCount">@(!string.IsNullOrWhiteSpace(profileHocVienId) && profileHocVienId != "0" ? "Đã kích hoạt" : "Chưa có hồ sơ")</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Mã học viên</span>
                            <strong id="profileLastScore">@(!string.IsNullOrWhiteSpace(profileHocVienId) && profileHocVienId != "0" ? profileHocVienId : "Chưa cập nhật")</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Trạng thái tài khoản</span>
                            <span id="profileLastStatus" class="badge bg-secondary">@statusLabel</span>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <form method="post" action="/Login/Logout">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="bg-white shadow-sm rounded-4 p-4 border mb-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                        <div>
                            <h2 class="h3 mb-2">Thông tin chi tiết bản thân</h2>
                            <p class="text-muted mb-0">Theo dõi tiến độ ôn thi, khóa học đang tham gia và quản lý tài khoản học viên tại đây.</p>
                        </div>
                        <a href="/Exam" class="btn btn-primary">
                            <i class="fas fa-book-open me-2"></i>Tiếp tục ôn thi
                        </a>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="border rounded-4 p-4 h-100 bg-light">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div>
                                        <span class="badge bg-primary-subtle text-primary px-3 py-2 mb-3">Thông tin cá nhân</span>
                                        <h3 id="profileCourseName" class="h4 mb-2">@(profileName)</h3>
                                        <p id="profileCourseDescription" class="text-muted mb-3">Tên đăng nhập: <strong>@(profileTenDangNhap ?? "Chưa cập nhật")</strong></p>
                                    </div>
                                    <i class="fas fa-user-circle text-primary fs-2"></i>
                                </div>
                                <div class="d-grid gap-2 small text-muted mb-4">
                                    <div><i class="far fa-calendar-alt text-primary me-2"></i>Ngày sinh: <strong id="profileCourseStartDate">@(profileNgaySinh ?? "Chưa cập nhật")</strong></div>
                                    <div><i class="far fa-clock text-primary me-2"></i>Giới tính: <strong id="profileCourseSchedule">@(profileGioiTinh ?? "Chưa cập nhật")</strong></div>
                                    <div><i class="fas fa-user text-primary me-2"></i>Số điện thoại: <strong id="profileCourseTeacher">@(profileSoDienThoai ?? "Chưa cập nhật")</strong></div>
                                </div>
                                <div id="profileScheduleLink" class="btn btn-outline-primary disabled" aria-disabled="true">
                                    <i class="fas fa-map-marker-alt me-2"></i>@(profileDiaChi ?? "Chưa cập nhật địa chỉ")
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-4 p-4 h-100 bg-light">
                                <span class="badge bg-warning text-dark px-3 py-2 mb-3">Hồ sơ tài khoản</span>
                                <h3 class="h4 mb-3">Thông tin xác minh</h3>
                                <div class="d-grid gap-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Mã người dùng</span>
                                        <strong id="profileRegisteredCourseCount">@(profileUserId ?? "-")</strong>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted">CCCD</span>
                                        <strong id="profileNextLesson">@(profileCccd ?? "Chưa cập nhật")</strong>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted">Ảnh chân dung</span>
                                        <span id="profileCourseStatus" class="badge bg-info">@(string.IsNullOrWhiteSpace(profileAnhChanDung) ? "Chưa có" : "Đã có")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white shadow-sm rounded-4 p-4 border">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                        <div>
                            <h3 class="h4 mb-2">Cập nhật hồ sơ</h3>
                            <p class="text-muted mb-0">Chỉnh sửa thông tin cá nhân và gửi về controller để cập nhật qua API <code>PUT /api/v1/auth/me</code>.</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(profileUpdateSuccess))
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@profileUpdateSuccess
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(profileUpdateError))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>@profileUpdateError
                        </div>
                    }

                    <form method="post" action="/Login/Profile" class="row g-3">
                        @Html.AntiForgeryToken()

                        <div class="col-md-6">
                            <label asp-for="UpdateProfileRequest.HoTen" class="form-label fw-semibold">Họ tên</label>
                            <input asp-for="UpdateProfileRequest.HoTen" class="form-control" placeholder="Nhập họ tên" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tên đăng nhập</label>
                            <input class="form-control" value="@(profileTenDangNhap ?? string.Empty)" readonly />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UpdateProfileRequest.Email" class="form-label fw-semibold">Email</label>
                            <input asp-for="UpdateProfileRequest.Email" type="email" class="form-control" placeholder="Nhập email" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UpdateProfileRequest.SoDienThoai" class="form-label fw-semibold">Số điện thoại</label>
                            <input asp-for="UpdateProfileRequest.SoDienThoai" class="form-control" placeholder="Nhập số điện thoại" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UpdateProfileRequest.NgaySinh" class="form-label fw-semibold">Ngày sinh</label>
                            <input asp-for="UpdateProfileRequest.NgaySinh" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UpdateProfileRequest.GioiTinh" class="form-label fw-semibold">Giới tính</label>
                            <select asp-for="UpdateProfileRequest.GioiTinh" class="form-select">
                                <option value="">Chọn giới tính</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UpdateProfileRequest.Cccd" class="form-label fw-semibold">CCCD</label>
                            <input asp-for="UpdateProfileRequest.Cccd" class="form-control" placeholder="Nhập CCCD" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UpdateProfileRequest.AnhChanDung" class="form-label fw-semibold">Ảnh chân dung</label>
                            <input asp-for="UpdateProfileRequest.AnhChanDung" class="form-control" placeholder="Nhập URL ảnh chân dung" />
                        </div>
                        <div class="col-12">
                            <label asp-for="UpdateProfileRequest.DiaChi" class="form-label fw-semibold">Địa chỉ</label>
                            <textarea asp-for="UpdateProfileRequest.DiaChi" class="form-control" rows="3" placeholder="Nhập địa chỉ"></textarea>
                        </div>
                        <div class="col-12 d-flex flex-wrap gap-3 align-items-center">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-save me-2"></i>Cập nhật hồ sơ
                            </button>
                        </div>
                    </form>

                    <hr class="my-4" />

                    <div>
                        <h3 class="h4 mb-2">Đổi mật khẩu</h3>
                        <p class="text-muted">Nhập mật khẩu hiện tại và mật khẩu mới để cập nhật tài khoản của bạn.</p>

                        @if (!string.IsNullOrWhiteSpace(changePasswordSuccess))
                        {
                            <div class="alert alert-success" role="alert">
                                <i class="fas fa-check-circle me-2"></i>@changePasswordSuccess
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(changePasswordError))
                        {
                            <div class="alert alert-danger" role="alert">
                                <i class="fas fa-exclamation-triangle me-2"></i>@changePasswordError
                            </div>
                        }

                        <form method="post" action="/Login/ChangePassword" class="row g-3">
                            @Html.AntiForgeryToken()
                            <div class="col-12">
                                <label asp-for="ChangePasswordRequest.OldPassword" class="form-label fw-semibold">Mật khẩu hiện tại</label>
                                <input asp-for="ChangePasswordRequest.OldPassword" type="password" class="form-control" placeholder="Nhập mật khẩu hiện tại" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ChangePasswordRequest.NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
                                <input asp-for="ChangePasswordRequest.NewPassword" type="password" class="form-control" placeholder="Tối thiểu 8 ký tự" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ChangePasswordRequest.ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                                <input asp-for="ChangePasswordRequest.ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" />
                            </div>
                            <div class="col-12 d-flex flex-wrap gap-3 align-items-center">
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="fas fa-key me-2"></i>Đổi mật khẩu
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="mt-3">
                        <form method="post" action="/Login/Logout">
                                <button type="submit" class="btn btn-outline-danger px-4">
                                    <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .profile-card-main {
            position: sticky;
            top: 100px;
        }

        .profile-avatar {
            width: 110px;
            height: 110px;
            font-size: 2.1rem;
            background: linear-gradient(135deg, #f3bd00, #ff9f1c);
            box-shadow: 0 14px 32px rgba(243, 189, 0, 0.22);
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('form[action="/Login/Logout"]').forEach(form => {
                form.addEventListener('submit', function () {
                    const submitButton = form.querySelector('button[type="submit"]');
                    if (submitButton) {
                        submitButton.disabled = true;
                    }
                });
            });
        });
    </script>
}
