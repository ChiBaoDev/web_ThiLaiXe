@model webthibanglai.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    var returnUrl = ViewBag.ReturnUrl as string ?? string.Empty;
}

<div class="login-page py-5">
    <div class="container py-4 py-lg-5">
        <div class="row justify-content-center align-items-center">
            <div class="col-xl-10 col-lg-11">
                <div class="login-shell">
                    <div class="row g-0">
                        <div class="col-lg-5 d-none d-lg-block">
                            <div class="login-hero d-flex flex-column justify-content-center h-100">
                                <span class="login-badge"><i class="fas fa-user-shield"></i> Khu vực tài khoản hệ thống</span>
                                <h1 class="display-6 mb-3">Đăng nhập nhanh hoặc tạo tài khoản mới</h1>
                                <p class="login-note mb-4">Quản lý tài khoản học viên và theo dõi tiến độ học tập của bạn.</p>
                            </div>
                        </div>

                        <div class="col-lg-7">
                            <div class="login-panel h-100">
                                <div class="d-flex flex-wrap gap-2 mb-4 login-tab-group" role="tablist" aria-label="Chọn biểu mẫu tài khoản">
                                    <button type="button" class="btn login-tab-btn active" data-login-tab="login">Đăng nhập</button>
                                    <button type="button" class="btn login-tab-btn" data-login-tab="register">Đăng ký</button>
                                </div>

                                <div id="loginTabPanel" data-login-panel="login">
                                    <h2 class="h3 mb-2">Đăng nhập User/Admin</h2>
                                    <p class="login-note mb-4">Nhập tài khoản để truy cập khu vực người dùng hoặc quản trị.</p>

                                    @if (!ViewData.ModelState.IsValid)
                                    {
                                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                                    }

                                    @if (ViewBag.RegisterSuccess != null)
                                    {
                                        <div class="alert alert-success">@ViewBag.RegisterSuccess</div>
                                    }

                                    @if (TempData["ForgotPasswordSuccess"] != null)
                                    {
                                        <div class="alert alert-success">@TempData["ForgotPasswordSuccess"]</div>
                                    }

                                    @if (TempData["ForgotPasswordError"] != null && (TempData.Peek("ActiveLoginTab")?.ToString() == "forgot"))
                                    {
                                        <div class="alert alert-danger">@TempData["ForgotPasswordError"]</div>
                                    }

                                    @if (TempData["ResetPasswordSuccess"] != null)
                                    {
                                        <div class="alert alert-success">@TempData["ResetPasswordSuccess"]</div>
                                    }

                                    @if (TempData["ResetPasswordError"] != null && (TempData.Peek("ActiveLoginTab")?.ToString() == "reset"))
                                    {
                                        <div class="alert alert-danger">@TempData["ResetPasswordError"]</div>
                                    }

                                    <form method="post" action="/Login/Index">
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <div class="mb-3">
                                            <label asp-for="LoginRequest.TenDangNhapHoacEmail" class="form-label fw-semibold">Tên đăng nhập hoặc email</label>
                                            <input asp-for="LoginRequest.TenDangNhapHoacEmail" class="form-control login-input" placeholder="Nhập tên đăng nhập hoặc email" />
                                        </div>

                                        <div class="mb-4">
                                            <label asp-for="LoginRequest.MatKhau" class="form-label fw-semibold">Mật khẩu</label>
                                            <input asp-for="LoginRequest.MatKhau" type="password" class="form-control login-input" placeholder="Nhập mật khẩu" />
                                        </div>

                                        <button type="submit" class="btn btn-primary w-100 login-submit">Đăng nhập</button>
                                    </form>

                                    <div class="login-secondary-actions mt-3">
                                        <button type="button" class="btn btn-link login-inline-link p-0" data-login-tab="forgot">Quên mật khẩu?</button>
                                        <span class="text-muted">hoặc</span>
                                        <button type="button" class="btn btn-link login-inline-link p-0" data-login-tab="reset">Nhập token để reset mật khẩu</button>
                                    </div>
                                </div>

                                <div id="registerTabPanel" data-login-panel="register" class="d-none">
                                    <h2 class="h3 mb-2">Đăng ký tài khoản</h2>
                                    <p class="login-note mb-4">Tạo tài khoản mới với thông tin cơ bản. Bạn có thể cập nhật thêm thông tin sau khi đăng nhập.</p>

                                    @if (!ViewData.ModelState.IsValid && TempData.Peek("ActiveLoginTab")?.ToString() == "register")
                                    {
                                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                                    }

                                    <form method="post" action="/Login/Register" class="row g-3" novalidate>
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <div class="col-12">
                                            <label asp-for="RegisterRequest.TenDangNhap" class="form-label fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                                            <input asp-for="RegisterRequest.TenDangNhap" class="form-control login-input" placeholder="vd: nguyenvana" required />
                                            <span asp-validation-for="RegisterRequest.TenDangNhap" class="text-danger small"></span>
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="RegisterRequest.Email" class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                                            <input asp-for="RegisterRequest.Email" type="email" class="form-control login-input" placeholder="name@email.com" required />
                                            <span asp-validation-for="RegisterRequest.Email" class="text-danger small"></span>
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="RegisterRequest.MatKhau" class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                                            <input asp-for="RegisterRequest.MatKhau" type="password" class="form-control login-input" placeholder="Tối thiểu 8 ký tự" required />
                                            <span asp-validation-for="RegisterRequest.MatKhau" class="text-danger small"></span>
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="RegisterRequest.SoDienThoai" class="form-label fw-semibold">Số điện thoại <span class="text-muted fw-normal">(không bắt buộc)</span></label>
                                            <input asp-for="RegisterRequest.SoDienThoai" class="form-control login-input" placeholder="Nhập số điện thoại" />
                                            <span asp-validation-for="RegisterRequest.SoDienThoai" class="text-danger small"></span>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-text">
                                                <i class="fas fa-info-circle me-1"></i>
                                                Sau khi đăng ký, bạn có thể cập nhật thêm thông tin cá nhân như họ tên, ngày sinh, địa chỉ trong trang hồ sơ.
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary w-100 login-submit">Đăng ký tài khoản</button>
                                        </div>
                                    </form>
                                </div>

                                <div id="forgotTabPanel" data-login-panel="forgot" class="d-none">
                                    <h2 class="h3 mb-2">Quên mật khẩu</h2>
                                    <p class="login-note mb-4">Nhập email để gửi yêu cầu khôi phục mật khẩu qua API.</p>

                                    @if (TempData.Peek("ActiveLoginTab")?.ToString() == "forgot" && TempData["ForgotPasswordError"] != null)
                                    {
                                        <div class="alert alert-danger">@TempData["ForgotPasswordError"]</div>
                                    }

                                    @if (TempData.Peek("ActiveLoginTab")?.ToString() == "forgot" && TempData["ForgotPasswordSuccess"] != null)
                                    {
                                        <div class="alert alert-success">@TempData["ForgotPasswordSuccess"]</div>
                                    }

                                    <form method="post" action="/Login/ForgotPassword">
                                        @Html.AntiForgeryToken()
                                        <div class="mb-4">
                                            <label asp-for="ForgotPasswordRequest.Email" class="form-label fw-semibold">Email</label>
                                            <input asp-for="ForgotPasswordRequest.Email" type="email" class="form-control login-input" placeholder="Nhập email tài khoản" />
                                        </div>

                                        <button type="submit" class="btn btn-primary w-100 login-submit">Gửi yêu cầu quên mật khẩu</button>
                                    </form>
                                </div>

                                <div id="resetTabPanel" data-login-panel="reset" class="d-none">
                                    <h2 class="h3 mb-2">Reset mật khẩu</h2>
                                    <p class="login-note mb-4">Nhập email, token và mật khẩu mới để hoàn tất đặt lại mật khẩu.</p>

                                    @if (TempData.Peek("ActiveLoginTab")?.ToString() == "reset" && TempData["ResetPasswordError"] != null)
                                    {
                                        <div class="alert alert-danger">@TempData["ResetPasswordError"]</div>
                                    }

                                    @if (TempData.Peek("ActiveLoginTab")?.ToString() == "reset" && TempData["ResetPasswordSuccess"] != null)
                                    {
                                        <div class="alert alert-success">@TempData["ResetPasswordSuccess"]</div>
                                    }

                                    <form method="post" action="/Login/ResetPassword" class="row g-3">
                                        @Html.AntiForgeryToken()
                                        <div class="col-12">
                                            <label asp-for="ResetPasswordRequest.Email" class="form-label fw-semibold">Email</label>
                                            <input asp-for="ResetPasswordRequest.Email" type="email" class="form-control login-input" placeholder="Nhập email tài khoản" />
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="ResetPasswordRequest.Token" class="form-label fw-semibold">Token</label>
                                            <input asp-for="ResetPasswordRequest.Token" class="form-control login-input" placeholder="Nhập token reset mật khẩu" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="ResetPasswordRequest.NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
                                            <input asp-for="ResetPasswordRequest.NewPassword" type="password" class="form-control login-input" placeholder="Tối thiểu 8 ký tự" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="ResetPasswordRequest.ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                                            <input asp-for="ResetPasswordRequest.ConfirmPassword" type="password" class="form-control login-input" placeholder="Nhập lại mật khẩu mới" />
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary w-100 login-submit">Reset mật khẩu</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .login-page {
            background: linear-gradient(180deg, #fffef9 0%, #fffaf0 100%);
            min-height: calc(100vh - 120px);
        }

        .login-shell {
            border-radius: 28px;
            background: #ffffff;
            border: 10px solid #f3bd00;
            box-shadow: 0 24px 60px rgba(243, 189, 0, 0.12);
            overflow: hidden;
        }

        .login-hero {
            background: linear-gradient(180deg, #ffffff 0%, #fffdf8 100%);
            padding: 2rem;
            position: relative;
        }

        .login-hero::after {
            content: "";
            position: absolute;
            right: -70px;
            bottom: -70px;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(243, 189, 0, 0.10);
        }

        .login-badge {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            padding: .65rem 1rem;
            border-radius: 999px;
            background: #fff8df;
            color: #a16207;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .login-panel {
            background: #ffffff;
            padding: 2rem;
        }

        .login-demo-box {
            border: 1px solid #f0e2b6;
            background: #fffef9;
            border-radius: 20px;
            padding: 1rem 1.1rem;
        }

        .login-demo-item {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            padding: .75rem 0;
            border-bottom: 1px dashed #eadcae;
        }

        .login-demo-item:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

        .login-demo-item:first-child {
            padding-top: 0;
        }

        .login-input {
            min-height: 54px;
            border-radius: 16px;
            border: 1px solid #e5e7eb;
            background: #ffffff;
            box-shadow: none;
        }

        .login-input:focus {
            border-color: #f3bd00;
            box-shadow: 0 0 0 .2rem rgba(243, 189, 0, 0.15);
        }

        .login-submit {
            min-height: 54px;
            border-radius: 16px;
            font-weight: 700;
        }

        .login-tab-group {
            display: inline-flex;
            background: #fff8df;
            border-radius: 18px;
            padding: .35rem;
        }

        .login-tab-btn {
            border-radius: 14px;
            font-weight: 700;
            color: #7c5a00;
            background: transparent;
            border: 0;
            padding: .8rem 1.2rem;
        }

        .login-tab-btn.active {
            background: #f3bd00;
            color: #1f2937;
            box-shadow: 0 8px 20px rgba(243, 189, 0, 0.28);
        }

        .login-note {
            color: #6b7280;
        }

        .login-secondary-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            align-items: center;
            justify-content: center;
            font-size: .95rem;
        }

        .login-inline-link {
            color: #a16207;
            font-weight: 600;
            text-decoration: none;
        }

        .login-inline-link:hover {
            color: #7c5a00;
            text-decoration: underline;
        }

        @@media (max-width: 991.98px) {
            .login-shell {
                border-width: 8px;
            }

            .login-panel {
                padding: 1.5rem;
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const buttons = document.querySelectorAll('[data-login-tab]');
            const loginPanel = document.querySelector('[data-login-panel="login"]');
            const registerPanel = document.querySelector('[data-login-panel="register"]');
            const forgotPanel = document.querySelector('[data-login-panel="forgot"]');
            const resetPanel = document.querySelector('[data-login-panel="reset"]');
            const activeTabFromServer = '@(TempData.Peek("ActiveLoginTab")?.ToString() ?? string.Empty)';

            function activateTab(tabName) {
                buttons.forEach(button => {
                    button.classList.toggle('active', button.dataset.loginTab === tabName);
                });

                if (loginPanel) {
                    loginPanel.classList.toggle('d-none', tabName !== 'login');
                }

                if (registerPanel) {
                    registerPanel.classList.toggle('d-none', tabName !== 'register');
                }

                if (forgotPanel) {
                    forgotPanel.classList.toggle('d-none', tabName !== 'forgot');
                }

                if (resetPanel) {
                    resetPanel.classList.toggle('d-none', tabName !== 'reset');
                }
            }

            buttons.forEach(button => {
                button.addEventListener('click', function () {
                    activateTab(button.dataset.loginTab);
                });
            });

            const hasRegisterValues = [
                document.getElementById('RegisterRequest_TenDangNhap'),
                document.getElementById('RegisterRequest_Email'),
                document.getElementById('RegisterRequest_HoTen')
            ].some(input => input && input.value.trim() !== '');

            const hasForgotValues = [
                document.getElementById('ForgotPasswordRequest_Email')
            ].some(input => input && input.value.trim() !== '');

            const hasResetValues = [
                document.getElementById('ResetPasswordRequest_Email'),
                document.getElementById('ResetPasswordRequest_Token')
            ].some(input => input && input.value.trim() !== '');

            if (activeTabFromServer) {
                activateTab(activeTabFromServer);
            } else if (hasResetValues) {
                activateTab('reset');
            } else if (hasForgotValues) {
                activateTab('forgot');
            } else {
                activateTab(hasRegisterValues ? 'register' : 'login');
            }
        });
    </script>
}
