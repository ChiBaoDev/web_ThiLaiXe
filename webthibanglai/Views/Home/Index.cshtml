<div class="container-xxl courses my-6 py-6 pb-0">
    <div class="container">
        <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
            <h6 class="text-primary text-uppercase mb-2">Khóa học nổi bật</h6>
            <h1 class="display-6 mb-4">Các khóa học đang được học viên quan tâm</h1>
        </div>
        <div class="row g-4 justify-content-center">
            @if (featuredCourses.Count == 0)
            {
                <div class="col-12 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="bg-white text-center rounded shadow-sm p-5">
                        <i class="fa fa-layer-group text-primary mb-3" style="font-size: 2.5rem;"></i>
                        <h5 class="mb-2">Chưa có khóa học nổi bật</h5>
                        <p class="text-muted mb-0">Danh sách khóa học sẽ được cập nhật khi API có dữ liệu.</p>
                    </div>
                </div>
            }
            else
            {
                @for (var index = 0; index < featuredCourses.Count; index++)
                {
                    var course = featuredCourses[index];
                    <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.@(index * 2 + 1)s">
                        <article class="home-featured-course-card h-100">
                            <div class="home-featured-course-card__glow"></div>
                            <div class="home-featured-course-card__top">
                                <span class="home-featured-course-card__icon"><i class="fa fa-motorcycle"></i></span>
                                <span class="home-featured-course-card__status">@GetStatusLabel(course.TrangThai)</span>
                            </div>
                            <div class="home-featured-course-card__code">@course.MaKhoaHoc</div>
                            <h5 class="home-featured-course-card__title">@course.TenKhoaHoc</h5>
                            <p class="home-featured-course-card__desc">@(string.IsNullOrWhiteSpace(course.MoTaNgan) ? "Khóa học đang được cập nhật mô tả chi tiết." : course.MoTaNgan)</p>

                            <div class="home-featured-course-card__price">
                                <span>Học phí</span>
                                <strong>@FormatPrice(course.HocPhi)</strong>
                            </div>

                            <div class="home-featured-course-card__meta">
                                <div><span>Số buổi</span><strong>@course.SoBuoiHoc buổi</strong></div>
                                <div><span>Khai giảng</span><strong>@FormatDate(course.ThoiGianBatDau)</strong></div>
                            </div>

                            <div class="home-featured-course-card__schedule">
                                <i class="fa fa-calendar-alt me-2"></i>@(string.IsNullOrWhiteSpace(course.LichHocTomTat) ? "Lịch học đang cập nhật" : course.LichHocTomTat)
                            </div>

                            <a class="home-featured-course-card__button text-decoration-none" asp-controller="KhoaHoc" asp-action="Detail" asp-route-id="@course.CourseId">
                                <i class="fa fa-circle-info me-2"></i>Xem chi tiết
                            </a>
                        </article>
                    </div>
                }
            }
            <div class="col-lg-8 my-6 mb-0 wow fadeInUp" data-wow-delay="0.1s">
              
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .home-featured-course-card {
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding: 1.5rem;
            border-radius: 1.5rem;
            background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
            border: 1px solid #e5e7eb;
            box-shadow: 0 18px 45px rgba(15, 23, 42, .08);
            isolation: isolate;
        }

        .home-featured-course-card__glow {
            position: absolute;
            width: 180px;
            height: 180px;
            right: -70px;
            top: -70px;
            border-radius: 999px;
            background: rgba(243, 189, 0, .18);
            z-index: -1;
        }

        .home-featured-course-card__top,
        .home-featured-course-card__meta {
            display: flex;
            justify-content: space-between;
            gap: .75rem;
            align-items: center;
        }

        .home-featured-course-card__icon {
            width: 52px;
            height: 52px;
            border-radius: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #fff8df;
            color: #b7791f;
            border: 1px solid #fde68a;
            font-size: 1.2rem;
        }

        .home-featured-course-card__status {
            border-radius: 999px;
            padding: .45rem .8rem;
            background: #ecfdf3;
            color: #15803d;
            font-weight: 700;
            font-size: .78rem;
        }

        .home-featured-course-card__code {
            color: #f3bd00;
            font-weight: 800;
            letter-spacing: .06em;
            text-transform: uppercase;
            font-size: .8rem;
        }

        .home-featured-course-card__title {
            color: #0c2b4b;
            font-weight: 800;
            line-height: 1.35;
            margin: 0;
        }

        .home-featured-course-card__desc {
            color: #6b7280;
            margin: 0;
            min-height: 4.5rem;
        }

        .home-featured-course-card__price {
            padding: 1rem;
            border-radius: 1rem;
            background: #0c2b4b;
            color: #fff;
        }

        .home-featured-course-card__price span,
        .home-featured-course-card__meta span {
            display: block;
            font-size: .78rem;
            opacity: .78;
            margin-bottom: .25rem;
        }

        .home-featured-course-card__price strong {
            font-size: 1.35rem;
        }

        .home-featured-course-card__meta > div {
            flex: 1;
            padding: .85rem;
            border-radius: .9rem;
            background: #f8fafc;
            border: 1px solid #e5e7eb;
        }

        .home-featured-course-card__meta strong {
            color: #0c2b4b;
        }

        .home-featured-course-card__schedule {
            color: #64748b;
            font-size: .92rem;
            padding-top: .25rem;
        }

        .home-featured-course-card__button {
            margin-top: auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: .85rem 1rem;
            border-radius: 999px;
            background: #f3bd00;
            color: #0c2b4b;
            font-weight: 800;
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .home-featured-course-card__button:hover {
            color: #0c2b4b;
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(243, 189, 0, .25);
        }
    </style>
}

