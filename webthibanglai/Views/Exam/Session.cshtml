@model ExamViewModel
@{
    ViewData["Title"] = "Làm bài thi";
    var session = Model.SessionPage!;
    var question = session.CurrentQuestion!;
    var total = Math.Max(session.TotalQuestions, 1);
    var current = Math.Min(Math.Max(session.CurrentQuestionNumber, 1), total);
    var answered = question.SelectedAnswerId.HasValue ? 1 : 0;
    var progressPercent = Math.Min(100, Math.Max(0, (int)Math.Round((double)answered / total * 100)));
    var isReviewMode = session.IsReviewMode;
    var isEmbeddedMode = session.IsEmbeddedMode;
    var apiBaseUrl = (Context.RequestServices.GetService<IConfiguration>()?["ApiSettings:BaseUrl"] ?? string.Empty).TrimEnd('/');
    var rawImageUrl = question.ImageUrl;
    var imageUrl = !string.IsNullOrWhiteSpace(rawImageUrl) && Uri.TryCreate(rawImageUrl, UriKind.Absolute, out _)
        ? rawImageUrl
        : (!string.IsNullOrWhiteSpace(rawImageUrl) && !string.IsNullOrWhiteSpace(apiBaseUrl)
            ? $"{apiBaseUrl}/{rawImageUrl.TrimStart('/')}"
            : rawImageUrl);
    var orderedAnswers = question.Answers
        .Where(x => !string.IsNullOrWhiteSpace(x.Content))
        .OrderBy(x => x.Order)
        .ToList();
}

<div class="container py-5 session-exam-page @(isEmbeddedMode ? "embedded-mode" : string.Empty)" id="examSessionContainer">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4">@Model.ErrorMessage</div>
    }

    <div class="exam-hero mb-4">
        <div class="row g-4 align-items-center position-relative">
            <div class="col-lg-7">
                <span class="badge rounded-pill bg-light text-primary px-3 py-2 mb-3">@(isReviewMode ? "Chế độ xem lại" : "Phiên thi đang diễn ra")</span>
                <h1 class="display-5 fw-bold mb-3">@session.SampleExamName</h1>
                <p class="lead mb-4">@(isReviewMode ? "Đây là màn hình xem lại bài đã nộp. Bạn có thể đối chiếu từng câu theo đúng dữ liệu của phiên thi." : "Làm bài theo phiên thi thật từ hệ thống. Mỗi lần chọn đáp án sẽ được lưu trực tiếp về API.")</p>
                <div class="d-flex flex-wrap gap-3">
                    <div class="exam-panel-glass px-3 py-2">
                        <i class="fas fa-layer-group me-2"></i>@session.TotalQuestions câu hỏi
                    </div>
                    <div class="exam-panel-glass px-3 py-2">
                        <i class="fas fa-clock me-2"></i>@session.DurationMinutes phút
                    </div>
                    <div class="exam-panel-glass px-3 py-2">
                        <i class="fas fa-signal me-2"></i>@session.Status
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="exam-panel-glass p-4">
                    <h4 class="fw-bold mb-3 text-dark">Thông tin phiên thi</h4>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="bg-white text-dark rounded-4 p-3 h-100">
                                <div class="small text-uppercase text-muted mb-1">Câu hiện tại</div>
                                <div class="fs-3 fw-bold">@current/@total</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="bg-white text-dark rounded-4 p-3 h-100">
                                <div class="small text-uppercase text-muted mb-1">Thời gian còn lại</div>
                                <div id="timerBox" class="fs-3 fw-bold">00:00</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="bg-white text-dark rounded-4 p-3">
                                <div class="small text-uppercase text-muted mb-1">Bắt đầu lúc</div>
                                <div class="fw-bold">@(session.StartedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "--")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="exam-shell">
        <div class="exam-workspace">
            <aside class="exam-sidebar">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <div class="text-uppercase small text-muted mb-1">Đề thi hiện tại</div>
                        <h4 class="mb-0">@session.SampleExamName</h4>
                    </div>
                    <span class="badge rounded-pill bg-primary px-3 py-2">@session.Status</span>
                </div>

                <div class="sidebar-stat mb-3">
                    <span class="text-muted small">Tiến độ làm bài</span>
                    <strong id="answeredProgressText">@answered/@total</strong>
                    <div class="progress mt-3" style="height: 10px;">
                        <div id="answeredProgressBar" class="progress-bar bg-success" role="progressbar" style="width: @progressPercent%"></div>
                    </div>
                </div>

                <div class="sidebar-stat mb-3">
                    <span class="text-muted small">Câu hiện tại</span>
                    <strong>Câu @question.Number</strong>
                    <div class="text-muted">@(isReviewMode ? "Bạn đang xem lại nội dung và đáp án đã chọn của câu này." : "Trả lời và chuyển câu tiếp theo để tiếp tục bài thi.")</div>
                </div>

                <div class="exam-fullscreen-note mb-3" id="examSaveStatus" data-default-message="@(isReviewMode ? "Phiên thi đã nộp, các đáp án chỉ còn để xem lại và không thể chỉnh sửa." : "Đáp án sẽ được lưu ngay khi bạn chọn.")">
                    <i class="fas fa-circle-info me-2"></i><span id="examSaveStatusText">@(isReviewMode ? "Phiên thi đã nộp, các đáp án chỉ còn để xem lại và không thể chỉnh sửa." : "Đáp án sẽ được lưu ngay khi bạn chọn.")</span>
                </div>

                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">Tổng quan</h6>
                        <span class="small text-muted">Câu @current / @total</span>
                    </div>
                     <div class="question-palette read-only-palette">
                        @for (var i = 1; i <= total; i++)
                        {
                            <a class="palette-btn @(i == current ? "active" : string.Empty)"
                               data-question-number="@i"
                               data-ajax-question-url="@Url.Action("QuestionAjax", "Exam", new { sessionId = session.SessionId, number = i, embedded = isEmbeddedMode })"
                               asp-controller="Exam"
                               asp-action="Session"
                               asp-route-sessionId="@session.SessionId"
                               asp-route-number="@i"
                               asp-route-review="@isReviewMode"
                               asp-route-embedded="@isEmbeddedMode">@i</a>
                        }
                    </div>
                </div>
            </aside>

            <section class="exam-stage">
                <div class="exam-stage-header">
                    <div class="question-progress">
                        <div class="question-progress-badge">
                            <i class="fas fa-location-arrow"></i>
                            <span>Câu @question.Number / @total</span>
                        </div>
                        <div>
                            <h5 class="question-progress-title">Bạn đang làm đến câu @question.Number</h5>
                            <p class="question-progress-subtitle">@((question.IsCritical ? "Đây là câu điểm liệt, cần chú ý chọn đáp án chính xác." : "Đọc kỹ nội dung câu hỏi và chọn đáp án phù hợp nhất."))</p>
                        </div>
                    </div>
                    <div class="exam-timer-box">
                        <span class="label">Thời gian còn lại</span>
                        <strong id="timerInline" class="value">00:00</strong>
                    </div>
                </div>

                @if (isReviewMode)
                {
                    <div class="exam-question-card">
                        <div>
                            <span class="question-tag">Câu hỏi @question.Number/@total</span>
                            <div class="question-text">@question.Content</div>
                            @if (!string.IsNullOrWhiteSpace(imageUrl))
                            {
                                <img src="@imageUrl" alt="Hình minh họa câu hỏi" class="question-image" />
                            }
                            <div class="option-list">
                                @foreach (var answer in orderedAnswers)
                                {
                                    <div class="option-item selectable @(question.SelectedAnswerId == answer.AnswerId ? "selected" : string.Empty)">
                                        <input class="option-input" type="radio" id="review-answer-@answer.AnswerId" disabled @(question.SelectedAnswerId == answer.AnswerId ? "checked" : null) />
                                        <label class="option-label w-100" for="review-answer-@answer.AnswerId">
                                            <span class="option-marker">@((char)('A' + Math.Max(answer.Order - 1, 0)))</span>
                                            <span class="option-copy">@answer.Content</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="text-muted mt-4">Mã câu hỏi: @question.QuestionId</div>
                    </div>

                    <div class="exam-nav">
                        <div class="d-flex gap-2 flex-wrap">
                            @if (current > 1)
                            {
                                <a asp-controller="Exam" asp-action="Session" asp-route-sessionId="@session.SessionId" asp-route-number="@(current - 1)" asp-route-review="true" class="btn btn-outline-secondary px-4">
                                    <i class="fas fa-arrow-left me-2"></i>Câu trước
                                </a>
                            }
                            @if (current < total)
                            {
                                <a asp-controller="Exam" asp-action="Session" asp-route-sessionId="@session.SessionId" asp-route-number="@(current + 1)" asp-route-review="true" class="btn btn-primary px-4">
                                    Câu tiếp theo<i class="fas fa-arrow-right ms-2"></i>
                                </a>
                            }
                        </div>
                        <a asp-controller="Exam" asp-action="Result" asp-route-sessionId="@session.SessionId" class="btn btn-outline-primary px-4 py-2">Quay lại kết quả</a>
                    </div>
                }
                 else
                 {
                     <form asp-controller="Exam" asp-action="SaveAnswer" method="post" id="examAnswerForm"
                           data-save-url="@Url.Action("SaveAnswerAjax", "Exam")"
                           data-question-url-template="@Url.Action("QuestionAjax", "Exam", new { sessionId = session.SessionId, number = "__number__", embedded = isEmbeddedMode })"
                           data-submit-url="@Url.Action("SubmitAjax", "Exam")"
                           data-result-url="@Url.Action("Result", "Exam", new { sessionId = session.SessionId })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sessionId" value="@session.SessionId" />
                        <input type="hidden" name="currentNumber" value="@current" />
                        <input type="hidden" name="questionId" value="@question.QuestionId" />

                        <div class="exam-question-card">
                            <div>
                                <span class="question-tag">Câu hỏi @question.Number/@total</span>
                                <div class="question-text">@question.Content</div>
                                @if (!string.IsNullOrWhiteSpace(imageUrl))
                                {
                                    <img src="@imageUrl" alt="Hình minh họa câu hỏi" class="question-image" />
                                }
                                <div class="option-list">
                                    @foreach (var answer in orderedAnswers)
                                    {
                                        <div class="option-item selectable @(question.SelectedAnswerId == answer.AnswerId ? "selected" : string.Empty)">
                                            <input class="option-input" type="radio" name="answerId" id="answer-@answer.AnswerId" value="@answer.AnswerId" @(question.SelectedAnswerId == answer.AnswerId ? "checked" : null) />
                                            <label class="option-label w-100" for="answer-@answer.AnswerId">
                                                <span class="option-marker">@((char)('A' + Math.Max(answer.Order - 1, 0)))</span>
                                                <span class="option-copy">@answer.Content</span>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="text-muted mt-4">Mã câu hỏi: @question.QuestionId</div>
                        </div>

                        <div class="exam-nav">
                            <div class="d-flex gap-2 flex-wrap">
                                @if (current > 1)
                                {
                                    <button type="submit"
                                            name="actionType"
                                             value="previous"
                                             class="btn btn-outline-secondary px-4 exam-nav-button"
                                             data-target-number="@(current - 1)"
                                             data-target-url="@Url.Action("Session", "Exam", new { sessionId = session.SessionId, number = Math.Max(current - 1, 1), review = false, embedded = isEmbeddedMode })">
                                        <i class="fas fa-arrow-left me-2"></i>Câu trước
                                    </button>
                                }
                                @if (current < total)
                                {
                                    <button type="submit"
                                            name="actionType"
                                             value="next"
                                             class="btn btn-primary px-4 exam-nav-button"
                                             data-target-number="@(current + 1)"
                                             data-target-url="@Url.Action("Session", "Exam", new { sessionId = session.SessionId, number = Math.Min(current + 1, total), review = false, embedded = isEmbeddedMode })">
                                        Câu tiếp theo<i class="fas fa-arrow-right ms-2"></i>
                                    </button>
                                }
                            </div>
                            <button type="submit" name="actionType" value="submit" class="btn btn-danger px-4 py-2 exam-submit-button">Nộp bài</button>
                        </div>
                    </form>
                }
            </section>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .session-exam-page {
            max-width: 1320px;
        }

        body.exam-fullscreen-active {
            background: linear-gradient(135deg, #fffdf7 0%, #fff9ea 50%, #ffffff 100%);
        }

        body.exam-fullscreen-active .container-fluid.bg-dark.text-light.p-0,
        body.exam-fullscreen-active .navbar.sticky-top,
        body.exam-fullscreen-active footer,
        body.exam-fullscreen-active .footer,
        body.exam-fullscreen-active .copyright,
        body.exam-fullscreen-active .back-to-top,
        body.exam-fullscreen-active .exam-hero,
        body.embedded-exam-mode .container-fluid.bg-dark.text-light.p-0,
        body.embedded-exam-mode .navbar.sticky-top,
        body.embedded-exam-mode footer,
        body.embedded-exam-mode .footer,
        body.embedded-exam-mode .copyright,
        body.embedded-exam-mode .back-to-top,
        body.embedded-exam-mode .exam-hero {
            display: none !important;
        }

        body.exam-fullscreen-active .container.py-5,
        body.embedded-exam-mode .container.py-5 {
            max-width: 100%;
            padding-top: .75rem !important;
            padding-bottom: .75rem !important;
        }

        body.exam-fullscreen-active .exam-shell,
        body.embedded-exam-mode .exam-shell {
            padding: .5rem;
            margin-top: 0;
        }

        body.exam-fullscreen-active .exam-sidebar,
        body.embedded-exam-mode .exam-sidebar {
            top: 1rem;
        }

        body.exam-fullscreen-active .exam-stage,
        body.embedded-exam-mode .exam-stage {
            min-height: calc(100vh - 2rem);
        }

        .exam-hero {
            position: relative;
            overflow: hidden;
            border-radius: 32px;
            padding: 3rem;
            background: linear-gradient(180deg, #ffffff 0%, #fffdf8 100%);
            color: #1f2937;
            border: 1px solid #eceff3;
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.08);
        }

        .exam-hero::after {
            content: "";
            position: absolute;
            width: 320px;
            height: 320px;
            right: -120px;
            top: -140px;
            border-radius: 50%;
            background: rgba(243, 189, 0, 0.10);
        }

        .exam-panel-glass {
            border: 1px solid #f3e1a0;
            background: #ffffff;
            backdrop-filter: blur(12px);
            border-radius: 24px;
            color: #1f2937;
            box-shadow: 0 18px 40px rgba(243, 189, 0, 0.08);
        }

        .exam-shell {
            margin-top: 1.5rem;
            background: #ffffff;
            border-radius: 32px;
            border: 1px solid #eceff3;
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.08);
            overflow: hidden;
        }

        .exam-workspace {
            display: grid;
            grid-template-columns: 320px minmax(0,1fr);
            gap: 1.5rem;
            align-items: start;
        }

        .exam-sidebar,
        .exam-stage,
        .exam-question-card {
            background: #fff;
            border-radius: 28px;
            padding: 1.5rem;
            border: 1px solid #eceff3;
            box-shadow: none;
        }

        .sidebar-stat {
            padding: 1rem;
            border-radius: 20px;
            background: #ffffff;
            border: 1px solid #eceff3;
            display: flex;
            flex-direction: column;
            gap: .35rem;
        }

        .exam-fullscreen-note {
            padding: .9rem 1rem;
            border-radius: 18px;
            background: #fffaf0;
            color: #a16207;
            border: 1px solid #f2df9d;
        }

        .question-palette {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: .6rem;
        }

        .palette-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 46px;
            border-radius: 16px;
            border: 1px solid #eceff3;
            background: #ffffff;
            color: #6b7280;
            font-weight: 700;
            text-decoration: none;
            transition: all .2s ease;
        }

        .palette-btn.active {
            background: linear-gradient(135deg, #f3bd00 0%, #e2ac00 100%);
            border-color: #f3bd00;
            color: #fff;
        }

        .palette-btn.answered:not(.active) {
            background: #e8f7ee;
            border-color: #9ed9b0;
            color: #166534;
        }

        .exam-stage-header,
        .exam-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .question-progress {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
        }

        .question-progress-badge {
            min-width: max-content;
            padding: .55rem .95rem;
            border-radius: 999px;
            background: #fff8df;
            color: #a16207;
            font-weight: 700;
            display: flex;
            gap: .5rem;
            align-items: center;
        }

        .question-progress-title {
            font-weight: 700;
            margin-bottom: .35rem;
        }

        .question-progress-subtitle,
        .label {
            color: #6b7280;
            margin: 0;
        }

        .exam-timer-box {
            min-width: 180px;
            padding: 1rem 1.15rem;
            border-radius: 18px;
            background: #ffffff;
            border: 1px solid #eceff3;
            text-align: right;
        }

        .exam-timer-box .value {
            font-size: 1.85rem;
            line-height: 1;
        }

        .question-tag {
            display: inline-block;
            margin-bottom: 1rem;
            padding: .35rem .8rem;
            border-radius: 999px;
            background: #fff8df;
            color: #a16207;
            font-weight: 700;
        }

        .question-text {
            font-size: 1.28rem;
            font-weight: 700;
            color: #111827;
            margin-bottom: 1.5rem;
        }

        .question-image {
            display: block;
            max-width: 100%;
            height: auto;
            border-radius: 12px;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 12px rgba(0, 0, 0, .1);
        }

        .option-list {
            display: grid;
            gap: 1rem;
        }

        .option-item.selectable {
            position: relative;
        }

        .option-input {
            position: absolute;
            opacity: 0;
            inset: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
            z-index: 2;
        }

        .option-label {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            padding: 1rem 1.1rem;
            border-radius: 18px;
            border: 1px solid #e5e7eb;
            background: #ffffff;
            cursor: pointer;
            transition: all .2s ease;
        }

        .option-label:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(15,23,42,.06);
        }

        .option-item.selectable.selected .option-label,
        .option-input:checked + .option-label {
            border-color: #f3bd00;
            background: #fff8df;
            box-shadow: 0 14px 35px rgba(243, 189, 0, 0.14);
        }

        .option-marker {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #fff5cf;
            color: #9a7400;
            font-weight: 700;
            flex-shrink: 0;
        }

        .option-copy {
            color: #111827;
            font-weight: 500;
        }

        .option-input:checked + .option-label .option-marker,
        .option-item.selectable.selected .option-label .option-marker {
            background: linear-gradient(135deg, #f3bd00 0%, #e2ac00 100%);
            color: #fff;
        }

        @@media (max-width: 991.98px) {
            .exam-workspace {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 767.98px) {
            .exam-hero,
            .exam-sidebar,
            .exam-stage,
            .exam-question-card {
                padding: 1.25rem;
            }

            .exam-stage-header,
            .exam-nav,
            .question-progress {
                flex-direction: column;
                align-items: stretch;
            }

            .question-palette {
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }

            .exam-timer-box {
                min-width: auto;
                text-align: left;
            }
        }
        .exam-fullscreen-note.status-saving {
            background: #eef6ff;
            color: #1d4ed8;
            border-color: #bfdbfe;
        }

        .exam-fullscreen-note.status-success {
            background: #ecfdf3;
            color: #166534;
            border-color: #bbf7d0;
        }

        .exam-fullscreen-note.status-error {
            background: #fef2f2;
            color: #b91c1c;
            border-color: #fecaca;
        }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var remainSeconds = @session.RemainingSeconds;
            var timerBox = document.getElementById('timerBox');
            var timerInline = document.getElementById('timerInline');
            var isReviewMode = @(isReviewMode ? "true" : "false");
            var isEmbeddedMode = @(isEmbeddedMode ? "true" : "false");
            var submitUrl = '@Url.Action("Submit", "Exam", new { sessionId = session.SessionId, autoSubmit = true })';
            var tokenField = document.querySelector('input[name="__RequestVerificationToken"]');
            var answerForm = document.getElementById('examAnswerForm');
            var saveStatus = document.getElementById('examSaveStatus');
            var saveStatusText = document.getElementById('examSaveStatusText');
            var progressText = document.getElementById('answeredProgressText');
            var progressBar = document.getElementById('answeredProgressBar');
            var paletteButtons = Array.from(document.querySelectorAll('.palette-btn[data-question-number]'));
            var answeredStorageKey = 'exam-answered-@session.SessionId';
            var totalQuestions = @total;
            var currentQuestionNumber = @current;
            var hasSelectedAnswer = @((question.SelectedAnswerId.HasValue ? "true" : "false"));
            var saveUrl = answerForm ? (answerForm.getAttribute('data-save-url') || '') : '';
            var questionUrlTemplate = answerForm ? (answerForm.getAttribute('data-question-url-template') || '') : '';
            var submitAjaxUrl = answerForm ? (answerForm.getAttribute('data-submit-url') || '') : '';
            var resultUrl = answerForm ? (answerForm.getAttribute('data-result-url') || '') : '';
            var sessionId = @session.SessionId;
            var questionId = @question.QuestionId;
            var isSavingAnswer = false;
            var isLoadingQuestion = false;
            var isSubmittingExam = false;

            function formatTime(totalSeconds) {
                var minutes = Math.floor(Math.max(totalSeconds, 0) / 60).toString().padStart(2, '0');
                var seconds = Math.floor(Math.max(totalSeconds, 0) % 60).toString().padStart(2, '0');
                return minutes + ':' + seconds;
            }

            function updateTimer() {
                var value = formatTime(remainSeconds);
                if (timerBox) timerBox.textContent = value;
                if (timerInline) timerInline.textContent = value;
            }

            function getAnsweredQuestions() {
                try {
                    var raw = window.sessionStorage.getItem(answeredStorageKey);
                    if (!raw) {
                        return [];
                    }

                    var parsed = JSON.parse(raw);
                    return Array.isArray(parsed) ? parsed : [];
                } catch {
                    return [];
                }
            }

            function saveAnsweredQuestions(items) {
                var normalized = Array.from(new Set(items
                    .map(function (value) { return parseInt(value, 10); })
                    .filter(function (value) { return !isNaN(value) && value >= 1 && value <= totalQuestions; })))
                    .sort(function (a, b) { return a - b; });

                window.sessionStorage.setItem(answeredStorageKey, JSON.stringify(normalized));
                return normalized;
            }

            function markAnswered(questionNumber) {
                return saveAnsweredQuestions(getAnsweredQuestions().concat([questionNumber]));
            }

            function renderAnsweredState() {
                var answeredQuestions = getAnsweredQuestions();
                var answeredCount = answeredQuestions.length;
                var answeredMap = new Set(answeredQuestions);
                var answeredPercent = totalQuestions <= 0
                    ? 0
                    : Math.max(0, Math.min(100, Math.round(answeredCount / totalQuestions * 100)));

                paletteButtons.forEach(function (button) {
                    var number = parseInt(button.getAttribute('data-question-number') || '', 10);
                    if (answeredMap.has(number)) {
                        button.classList.add('answered');
                    } else {
                        button.classList.remove('answered');
                    }
                });

                if (progressText) {
                    progressText.textContent = answeredCount + '/' + totalQuestions;
                }

                if (progressBar) {
                    progressBar.style.width = answeredPercent + '%';
                    progressBar.setAttribute('aria-valuenow', answeredPercent.toString());
                }
            }

            function setSaveStatus(message, state) {
                if (!saveStatus || !saveStatusText) {
                    return;
                }

                saveStatus.classList.remove('status-saving', 'status-success', 'status-error');
                if (state) {
                    saveStatus.classList.add(state);
                }

                saveStatusText.textContent = message || saveStatus.getAttribute('data-default-message') || '';
            }

            function getQuestionUrl(number) {
                if (!questionUrlTemplate) {
                    return '';
                }

                return questionUrlTemplate.replace('__number__', encodeURIComponent(number));
            }

            function getQuestionTargetUrl(number) {
                return '@Url.Action("Session", "Exam", new { sessionId = session.SessionId, number = "__number__", review = false, embedded = isEmbeddedMode })'
                    .replace('__number__', encodeURIComponent(number));
            }

            function escapeHtml(value) {
                return (value || '').toString()
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function answerLetter(order) {
                var index = Math.max((parseInt(order, 10) || 1) - 1, 0);
                return String.fromCharCode('A'.charCodeAt(0) + index);
            }

            function updateNavButtons() {
                if (!answerForm) {
                    return;
                }

                var navWrap = answerForm.querySelector('.exam-nav .d-flex');
                if (!navWrap) {
                    return;
                }

                navWrap.innerHTML = '';

                if (currentQuestionNumber > 1) {
                    var previousButton = document.createElement('button');
                    previousButton.type = 'submit';
                    previousButton.name = 'actionType';
                    previousButton.value = 'previous';
                    previousButton.className = 'btn btn-outline-secondary px-4 exam-nav-button';
                    previousButton.setAttribute('data-target-number', (currentQuestionNumber - 1).toString());
                    previousButton.setAttribute('data-target-url', getQuestionTargetUrl(currentQuestionNumber - 1));
                    previousButton.innerHTML = '<i class="fas fa-arrow-left me-2"></i>Câu trước';
                    navWrap.appendChild(previousButton);
                }

                if (currentQuestionNumber < totalQuestions) {
                    var nextButton = document.createElement('button');
                    nextButton.type = 'submit';
                    nextButton.name = 'actionType';
                    nextButton.value = 'next';
                    nextButton.className = 'btn btn-primary px-4 exam-nav-button';
                    nextButton.setAttribute('data-target-number', (currentQuestionNumber + 1).toString());
                    nextButton.setAttribute('data-target-url', getQuestionTargetUrl(currentQuestionNumber + 1));
                    nextButton.innerHTML = 'Câu tiếp theo<i class="fas fa-arrow-right ms-2"></i>';
                    navWrap.appendChild(nextButton);
                }
            }

            function bindAnswerInputs() {
                if (!answerForm) {
                    return;
                }

                answerForm.querySelectorAll('input[name="answerId"]').forEach(function (input) {
                    input.addEventListener('change', function () {
                        answerForm.querySelectorAll('.option-item.selectable').forEach(function (item) {
                            item.classList.remove('selected');
                        });

                        var optionItem = input.closest('.option-item.selectable');
                        if (optionItem) {
                            optionItem.classList.add('selected');
                        }

                        saveSelectedAnswer();
                    });
                });
            }

            function renderQuestion(payload) {
                if (!payload || !payload.question || !answerForm) {
                    return;
                }

                var question = payload.question;
                currentQuestionNumber = payload.currentNumber || question.number || currentQuestionNumber;
                totalQuestions = payload.totalQuestions || totalQuestions;
                questionId = question.questionId;
                remainSeconds = typeof payload.remainingSeconds === 'number' ? payload.remainingSeconds : remainSeconds;

                var currentNumberInput = answerForm.querySelector('input[name="currentNumber"]');
                var questionIdInput = answerForm.querySelector('input[name="questionId"]');
                if (currentNumberInput) currentNumberInput.value = currentQuestionNumber;
                if (questionIdInput) questionIdInput.value = questionId;

                document.querySelectorAll('.question-progress-badge span').forEach(function (element) {
                    element.textContent = 'Câu ' + currentQuestionNumber + ' / ' + totalQuestions;
                });

                var progressTitle = document.querySelector('.question-progress-title');
                if (progressTitle) progressTitle.textContent = 'Bạn đang làm đến câu ' + currentQuestionNumber;

                var progressSubtitle = document.querySelector('.question-progress-subtitle');
                if (progressSubtitle) {
                    progressSubtitle.textContent = question.isCritical
                        ? 'Đây là câu điểm liệt, cần chú ý chọn đáp án chính xác.'
                        : 'Đọc kỹ nội dung câu hỏi và chọn đáp án phù hợp nhất.';
                }

                var sidebarCurrent = document.querySelector('.sidebar-stat:nth-of-type(2) strong');
                if (sidebarCurrent) sidebarCurrent.textContent = 'Câu ' + currentQuestionNumber;

                var overviewText = document.querySelector('.question-palette').previousElementSibling?.querySelector('.small.text-muted');
                if (overviewText) overviewText.textContent = 'Câu ' + currentQuestionNumber + ' / ' + totalQuestions;

                var questionTag = answerForm.querySelector('.question-tag');
                var questionText = answerForm.querySelector('.question-text');
                var optionList = answerForm.querySelector('.option-list');
                var codeBox = answerForm.querySelector('.exam-question-card > .text-muted');
                var oldImage = answerForm.querySelector('.question-image');

                if (questionTag) questionTag.textContent = 'Câu hỏi ' + currentQuestionNumber + '/' + totalQuestions;
                if (questionText) questionText.textContent = question.content || '';

                if (oldImage) {
                    oldImage.remove();
                }

                if (question.imageUrl && questionText) {
                    var image = document.createElement('img');
                    image.src = question.imageUrl;
                    image.alt = 'Hình minh họa câu hỏi';
                    image.className = 'question-image';
                    questionText.insertAdjacentElement('afterend', image);
                }

                if (optionList) {
                    optionList.innerHTML = (question.answers || []).map(function (answer) {
                        var checked = question.selectedAnswerId && question.selectedAnswerId.toString() === answer.answerId.toString();
                        return '<div class="option-item selectable ' + (checked ? 'selected' : '') + '">' +
                            '<input class="option-input" type="radio" name="answerId" id="answer-' + escapeHtml(answer.answerId) + '" value="' + escapeHtml(answer.answerId) + '" ' + (checked ? 'checked' : '') + ' />' +
                            '<label class="option-label w-100" for="answer-' + escapeHtml(answer.answerId) + '">' +
                                '<span class="option-marker">' + answerLetter(answer.order) + '</span>' +
                                '<span class="option-copy">' + escapeHtml(answer.content) + '</span>' +
                            '</label>' +
                        '</div>';
                    }).join('');
                }

                if (codeBox) {
                    codeBox.textContent = 'Mã câu hỏi: ' + questionId;
                }

                paletteButtons.forEach(function (button) {
                    var number = parseInt(button.getAttribute('data-question-number') || '', 10);
                    button.classList.toggle('active', number === currentQuestionNumber);
                    button.setAttribute('data-ajax-question-url', getQuestionUrl(number));
                });

                hasSelectedAnswer = !!question.selectedAnswerId;
                if (hasSelectedAnswer) {
                    markAnswered(currentQuestionNumber);
                }

                updateTimer();
                renderAnsweredState();
                updateNavButtons();
                bindAnswerInputs();
                window.history.replaceState(null, '', getQuestionTargetUrl(currentQuestionNumber));
            }

            async function loadQuestionAjax(number, fallbackUrl) {
                if (!number || isLoadingQuestion || isSubmittingExam) {
                    return;
                }

                var requestUrl = getQuestionUrl(number);
                if (!requestUrl) {
                    window.location.href = fallbackUrl || getQuestionTargetUrl(number);
                    return;
                }

                isLoadingQuestion = true;
                setFormBusy(true);
                setSaveStatus('Đang chuyển câu...', 'status-saving');

                try {
                    var response = await fetch(requestUrl, {
                        method: 'GET',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    var payload = {};
                    try {
                        payload = await response.json();
                    } catch {
                        payload = {};
                    }

                    if (!response.ok || payload.success !== true) {
                        throw new Error(payload.message || 'Không thể tải câu hỏi.');
                    }

                    if (payload.finished && payload.redirectUrl) {
                        window.location.href = payload.redirectUrl;
                        return;
                    }

                    renderQuestion(payload);
                    setSaveStatus('Đã chuyển sang câu ' + currentQuestionNumber + '.', 'status-success');
                } catch (error) {
                    setSaveStatus(error && error.message ? error.message : 'Không thể tải câu hỏi.', 'status-error');
                    if (fallbackUrl) {
                        window.location.href = fallbackUrl;
                    }
                } finally {
                    isLoadingQuestion = false;
                    setFormBusy(false);
                }
            }

            function getSelectedAnswerInput() {
                return answerForm
                    ? answerForm.querySelector('input[name="answerId"]:checked')
                    : null;
            }

            function setFormBusy(isBusy) {
                if (!answerForm) {
                    return;
                }

                answerForm.querySelectorAll('input[name="answerId"], .exam-nav-button, .exam-submit-button').forEach(function (element) {
                    element.disabled = isBusy;
                });
            }

            async function saveSelectedAnswer() {
                var selectedInput = getSelectedAnswerInput();
                if (!answerForm || !selectedInput || !saveUrl || !tokenField) {
                    return { success: false, skipped: true };
                }

                if (isSavingAnswer) {
                    return { success: false, skipped: true };
                }

                isSavingAnswer = true;
                setFormBusy(true);
                setSaveStatus('Đang lưu đáp án...', 'status-saving');

                try {
                    var response = await fetch(saveUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': tokenField.value,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            sessionId: sessionId,
                            currentNumber: currentQuestionNumber,
                            questionId: questionId,
                            answerId: parseInt(selectedInput.value, 10)
                        })
                    });

                    var payload = {};
                    try {
                        payload = await response.json();
                    } catch {
                        payload = {};
                    }

                    if (!response.ok || payload.success !== true) {
                        throw new Error(payload.message || 'Không thể lưu đáp án.');
                    }

                    markAnswered(currentQuestionNumber);
                    renderAnsweredState();
                    setSaveStatus(payload.message || 'Đã lưu đáp án.', 'status-success');
                    return { success: true, payload: payload };
                } catch (error) {
                    if (response && response.status === 401) {
                        window.location.href = '@Url.Action("Index", "Login", new { returnUrl = Url.Action("Index", "Exam") })';
                        return { success: false, message: 'Phiên đăng nhập đã hết hạn.' };
                    }

                    setSaveStatus(error && error.message ? error.message : 'Không thể lưu đáp án.', 'status-error');
                    return { success: false, message: error && error.message ? error.message : 'Không thể lưu đáp án.' };
                } finally {
                    isSavingAnswer = false;
                    setFormBusy(false);
                }
            }

            async function submitExam(autoSubmit) {
                if (!submitAjaxUrl || !tokenField || isSubmittingExam) {
                    return;
                }

                isSubmittingExam = true;
                setFormBusy(true);
                setSaveStatus(autoSubmit ? 'Đang tự động nộp bài...' : 'Đang nộp bài...', 'status-saving');

                try {
                    var response = await fetch(submitAjaxUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': tokenField.value,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            sessionId: sessionId,
                            autoSubmit: !!autoSubmit
                        })
                    });

                    var payload = {};
                    try {
                        payload = await response.json();
                    } catch {
                        payload = {};
                    }

                    if (!response.ok || payload.success !== true) {
                        throw new Error(payload.message || 'Không thể nộp bài thi.');
                    }

                    window.location.href = payload.redirectUrl || resultUrl;
                } catch (error) {
                    if (response && response.status === 401) {
                        window.location.href = '@Url.Action("Index", "Login", new { returnUrl = Url.Action("Index", "Exam") })';
                        return;
                    }

                    isSubmittingExam = false;
                    setFormBusy(false);
                    setSaveStatus(error && error.message ? error.message : 'Không thể nộp bài thi.', 'status-error');
                }
            }

            if (hasSelectedAnswer === true || hasSelectedAnswer === 'true') {
                markAnswered(currentQuestionNumber);
            } else {
                renderAnsweredState();
            }

            if (isEmbeddedMode === true || isEmbeddedMode === 'true') {
                document.body.classList.add('embedded-exam-mode');
            }

            if (isReviewMode !== true && isReviewMode !== 'true') {
                document.body.classList.add('exam-fullscreen-active');
            }

            updateTimer();
            renderAnsweredState();

            if (isReviewMode === true || isReviewMode === 'true') {
                return;
            }

            if (remainSeconds <= 0) {
                submitExam(true);
                return;
            }

            if (answerForm) {
                bindAnswerInputs();

                answerForm.addEventListener('submit', async function (event) {
                    event.preventDefault();

                    var submitter = event.submitter;
                    var actionType = submitter && submitter.value ? submitter.value : 'next';

                    if (actionType === 'submit') {
                        var selectedAnswerBeforeSubmit = getSelectedAnswerInput();
                        if (!selectedAnswerBeforeSubmit) {
                            setSaveStatus('Vui lòng chọn đáp án trước khi nộp bài ở câu hiện tại.', 'status-error');
                            return;
                        }

                        var savedBeforeSubmit = await saveSelectedAnswer();
                        if (!savedBeforeSubmit.success) {
                            return;
                        }

                        await submitExam(false);
                        return;
                    }

                    var targetUrl = submitter ? (submitter.getAttribute('data-target-url') || '') : '';
                    var targetNumber = submitter ? parseInt(submitter.getAttribute('data-target-number') || '', 10) : NaN;
                    if (!targetUrl) {
                        targetUrl = '@Url.Action("Session", "Exam", new { sessionId = session.SessionId, number = Math.Min(current + 1, total), review = false, embedded = isEmbeddedMode })';
                    }

                    if (isNaN(targetNumber)) {
                        targetNumber = actionType === 'previous'
                            ? Math.max(currentQuestionNumber - 1, 1)
                            : Math.min(currentQuestionNumber + 1, totalQuestions);
                    }

                    var savedBeforeNavigate = await saveSelectedAnswer();
                    if (savedBeforeNavigate.success === false && savedBeforeNavigate.skipped !== true) {
                        return;
                    }

                    await loadQuestionAjax(targetNumber, targetUrl);
                });
            }

            if (answerForm) {
                paletteButtons.forEach(function (button) {
                    button.addEventListener('click', async function (event) {
                        event.preventDefault();

                        var targetNumber = parseInt(button.getAttribute('data-question-number') || '', 10);
                        var targetUrl = button.getAttribute('href') || getQuestionTargetUrl(targetNumber);
                        if (!targetNumber || targetNumber === currentQuestionNumber) {
                            return;
                        }

                        var savedBeforeNavigate = await saveSelectedAnswer();
                        if (savedBeforeNavigate.success === false && savedBeforeNavigate.skipped !== true) {
                            return;
                        }

                        await loadQuestionAjax(targetNumber, targetUrl);
                    });
                });
            }

            var timer = window.setInterval(function () {
                remainSeconds--;
                updateTimer();

                if (remainSeconds <= 0) {
                    window.clearInterval(timer);
                    submitExam(true);
                }
            }, 1000);
        })();
    </script>
}
