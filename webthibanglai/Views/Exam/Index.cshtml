@model ExamViewModel
@{
    ViewData["Title"] = "Thi thử";
}

<section class="sample-exams-page py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 720px;">
                    <h6 class="text-primary text-uppercase mb-2">Thi thử GPLX</h6>
                    <h1 class="display-6 mb-4">Danh sách đề thi mẫu</h1>
                    <p class="mb-0">Chọn một đề thi để bắt đầu luyện tập theo bộ đề mẫu từ hệ thống.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(TempData["ExamError"]?.ToString()))
                {
                    <div class="alert alert-danger shadow-sm border-0 rounded-4 mb-4">
                        @TempData["ExamError"]
                    </div>
                }

                @if (!Model.IsAuthenticated)
                {
                    <div class="alert alert-warning shadow-sm border-0 rounded-4 mb-4">
                        @Model.ErrorMessage
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage) && Model.SampleExams.Count == 0)
                {
                    <div class="alert alert-info shadow-sm border-0 rounded-4 mb-4">
                        @Model.ErrorMessage
                    </div>
                }

                @if (Model.SampleExams.Count > 0)
                {
                    <div class="row g-4">
                        @foreach (var exam in Model.SampleExams)
                        {
                            <div class="col-md-6">
                                <div class="exam-card h-100">
                                    <div class="exam-card__header">
                                        <div>
                                            <h2 class="exam-card__title">@exam.Name</h2>
                                        </div>
                                        <span class="exam-card__status">@exam.Status</span>
                                    </div>

                                    <div class="exam-card__body">
                                        <div class="exam-meta-grid">
                                            <div class="exam-meta-item">
                                                <span class="label">Số câu hỏi</span>
                                                <strong>@exam.TotalQuestions câu</strong>
                                            </div>
                                            <div class="exam-meta-item">
                                                <span class="label">Thời gian</span>
                                                <strong>@exam.DurationMinutes phút</strong>
                                            </div>
                                            <div class="exam-meta-item">
                                                <span class="label">Bộ đề</span>
                                                <strong>@exam.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</strong>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="exam-card__footer">
                                        <form asp-controller="Exam" asp-action="Start" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="sampleExamId" value="@exam.Id" />
                                            <button type="submit" class="btn btn-primary btn-start">Bắt đầu thi</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .sample-exams-page {
            background: linear-gradient(180deg, #f5f9ff 0%, #ffffff 100%);
            min-height: calc(100vh - 160px);
        }

        .exam-card {
            background: #ffffff;
            border: 1px solid #e9eef5;
            border-radius: 1.5rem;
            padding: 1.5rem;
            box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .exam-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 48px rgba(15, 23, 42, 0.12);
        }

        .exam-card__header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
        }

        .exam-card__title {
            font-size: 1.35rem;
            font-weight: 700;
            color: #1f2937;
            margin: 0;
        }

        .exam-card__status {
            white-space: nowrap;
            padding: 0.45rem 0.8rem;
            border-radius: 999px;
            background: #e8f7ee;
            color: #198754;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: capitalize;
        }

        .exam-meta-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }

        .exam-meta-item {
            padding: 1rem;
            border-radius: 1rem;
            background: #f8fbff;
            border: 1px solid #edf2f7;
        }

        .exam-meta-item .label {
            display: block;
            color: #6b7280;
            font-size: 0.9rem;
            margin-bottom: 0.35rem;
        }

        .exam-meta-item strong {
            color: #111827;
            font-size: 1rem;
        }

        .exam-card__footer {
            margin-top: auto;
        }

        .btn-start {
            width: 100%;
            border-radius: 0.95rem;
            padding: 0.9rem 1rem;
            font-weight: 700;
            font-size: 1rem;
        }

        @@media (max-width: 767.98px) {
            .exam-card {
                padding: 1.25rem;
            }

            .exam-card__header {
                flex-direction: column;
            }

            .exam-meta-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}
