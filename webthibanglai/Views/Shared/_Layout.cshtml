@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var hideTawkTo = string.Equals(currentController, "Exam", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "OnTap", StringComparison.OrdinalIgnoreCase);
    var hideAiChatbot = hideTawkTo || ViewBag.HideChatbot == true;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thi bằng lái xe máy</title>
    <meta name="keywords" content="thi bằng lái, thi thử xe máy, ôn thi GPLX" />
    <meta name="description" content="Nền tảng ôn thi bằng lái xe máy trực tuyến với bộ đề sát hạch và thống kê kết quả chi tiết." />

    <link href="~/favicon.ico" rel="icon" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet" />

    <link href="~/lib/animate/animate.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/webthibanglai.styles.css" rel="stylesheet" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" role="status"></div>
    </div>

    <partial name="_Header" />

    <main>
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>

    @* Chatbot AI - Ẩn ở thi thử, ôn tập hoặc khi ViewBag.HideChatbot = true *@
    @if (!hideAiChatbot)
    {
        <partial name="_Chatbot" />
    }

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/wow/wow.min.js" asp-append-version="true"></script>
    <script src="~/lib/easing/easing.min.js" asp-append-version="true"></script>
    <script src="~/lib/waypoints/waypoints.min.js" asp-append-version="true"></script>
    <script src="~/lib/owlcarousel/owl.carousel.min.js" asp-append-version="true"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>

    @if (!hideTawkTo)
    {
        <!--Start of Tawk.to Script-->
        <script type="text/javascript">
            var Tawk_API = Tawk_API || {}, Tawk_LoadStart = new Date();
            window.openCustomerConsultChat = function () {
                if (window.Tawk_API && typeof window.Tawk_API.maximize === 'function') {
                    window.Tawk_API.maximize();
                    return;
                }

                window.__pendingOpenCustomerConsultChat = true;
            };
            Tawk_API.onLoad = function () {
                if (window.__pendingOpenCustomerConsultChat && typeof Tawk_API.maximize === 'function') {
                    window.__pendingOpenCustomerConsultChat = false;
                    Tawk_API.maximize();
                }
            };
            Tawk_API.customStyle = {
                visibility: {
                    desktop: {
                        position: 'br',
                        xOffset: 20,
                        yOffset: 120
                    },
                    mobile: {
                        position: 'br',
                        xOffset: 16,
                        yOffset: 104
                    },
                    bubble: {
                        rotate: '0deg',
                        xOffset: -20,
                        yOffset: 0
                    }
                }
            };
            (function () {
                var s1 = document.createElement("script"), s0 = document.getElementsByTagName("script")[0];
                s1.async = true;
                s1.src = 'https://embed.tawk.to/67db9d7cf14623190e5d72a5/1imotuboo';
                s1.charset = 'UTF-8';
                s1.setAttribute('crossorigin', '*');
                s0.parentNode.insertBefore(s1, s0);
            })();
        </script>
        <!--End of Tawk.to Script-->
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
