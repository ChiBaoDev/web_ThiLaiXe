# OpenAI Configuration
# Lấy API key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Hoặc cấu hình trong appsettings.json:
# {
#   "OpenAI": {
#     "ApiKey": "sk-your-key-here",
#     "ApiUrl": "https://api.openai.com/v1/chat/completions"
#   }
# }

# Lưu ý: 
# - Không commit API key vào Git
# - Chatbot vẫn hoạt động với fallback responses nếu không có API key
# - Sử dụng User Secrets cho development: dotnet user-secrets set "OpenAI:ApiKey" "sk-your-key"
