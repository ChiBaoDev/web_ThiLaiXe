# OpenAI Compatible Configuration
OPENAI_API_KEY=your-openai-compatible-api-key-here

# Hoặc cấu hình trong appsettings.json:
# {
#   "OpenAI": {
#     "ApiKey": "your-key-here",
#     "ApiUrl": "https://routerapi.vovantin.online/v1/chat/completions",
#     "Model": "gpt-5.4"
#   }
# }

# Lưu ý: 
# - Không commit API key vào Git
# - Chatbot vẫn hoạt động với fallback responses nếu không có API key
# - Sử dụng User Secrets cho development: dotnet user-secrets set "OpenAI:ApiKey" "your-key"
