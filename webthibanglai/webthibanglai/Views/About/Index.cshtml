@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="container-fluid page-header py-6 my-6 mt-0 wow fadeIn" data-wow-delay="0.1s">
    <div class="container text-center">
        <h1 class="display-4 text-white animated slideInDown mb-4">Về chúng tôi</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a class="text-white" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item text-primary active" aria-current="page">Giới thiệu</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-xxl py-6">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="position-relative overflow-hidden ps-5 pt-5 h-100" style="min-height: 400px;">
                    <img class="position-absolute w-100 h-100" src="~/img/about-1.jpg" alt="Về chúng tôi" style="object-fit: cover;" />
                    <img class="position-absolute top-0 start-0 bg-white pe-3 pb-3" src="~/img/about-2.jpg" alt="Hỗ trợ học viên" style="width: 200px; height: 200px;" />
                </div>
            </div>
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="h-100">
                    <h6 class="text-primary text-uppercase mb-2">Về chúng tôi</h6>
                    <h1 class="display-6 mb-4">Giúp bạn ôn thi bằng lái xe máy và tăng tỷ lệ đậu ngay lần đầu</h1>
                    <p>Hệ thống cung cấp đề thi sát hạch, bài giải chi tiết và thống kê kết quả theo từng lần làm bài.</p>
                    <p class="mb-4">Hệ thống cung cấp đề thi sát hạch, bài giải chi tiết và thống kê kết quả theo từng lần làm bài.</p>
                    <div class="row g-2 mb-4 pb-2">
                        <div class="col-sm-6"><i class="fa fa-check text-primary me-2"></i>Nội dung chuẩn quy định</div>
                        <div class="col-sm-6"><i class="fa fa-check text-primary me-2"></i>Theo dõi kết quả trực tuyến</div>
                        <div class="col-sm-6"><i class="fa fa-check text-primary me-2"></i>Học phí hợp lý</div>
                        <div class="col-sm-6"><i class="fa fa-check text-primary me-2"></i>Đội ngũ kinh nghiệm</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-xxl py-6">
    <div class="container">
        <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
            <h6 class="text-primary text-uppercase mb-2">Đội ngũ hỗ trợ</h6>
            <h1 class="display-6 mb-4">Giảng viên và tư vấn viên luôn đồng hành</h1>
        </div>
        <div class="row g-0 team-items">
            <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.1s"><div class="team-item position-relative"><div class="position-relative"><img class="img-fluid" src="~/img/team-1.jpg" alt="Giảng viên 1" /><div class="team-social text-center"><a class="btn btn-square btn-outline-primary border-2 m-1" href="#"><i class="fab fa-facebook-f"></i></a><a class="btn btn-square btn-outline-primary border-2 m-1" href="#"><i class="fab fa-twitter"></i></a><a class="btn btn-square btn-outline-primary border-2 m-1" href="#"><i class="fab fa-instagram"></i></a></div></div><div class="bg-light text-center p-4"><h5 class="mt-2">Họ và tên</h5><span>Giảng viên</span></div></div></div>
            <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.3s"><div class="team-item position-relative"><div class="position-relative"><img class="img-fluid" src="~/img/team-2.jpg" alt="Giảng viên 2" /><div class="team-social text-center"><a class="btn btn-square btn-outline-primary border-2 m-1" href="#"><i class="fab fa-facebook-f"></i></a><a class="btn btn-square btn-outline-primary border-2 m-1" href="#"><i class="fab fa-twitter"></i></a><a class="btn btn-square btn-outline-primary border-2 m-1" href="#"><i class="fab fa-instagram"></i></a></div></div><div class="bg-light text-center p-4"><h5 class="mt-2">Họ và tên</h5><span>Giảng viên</span></div></div></div>
            <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.5s"><div class="team-item position-relative"><div class="position-relative"><img class="img-fluid" src="~/img/team-3.jpg" alt="Giảng viên 3" /><div class="team-social text-center"><a class="btn btn-square btn-outline-primary border-2 m-1" href="#"><i class="fab fa-facebook-f"></i></a><a class="btn btn-square btn-outline-primary border-2 m-1" href="#"><i class="fab fa-twitter"></i></a><a class="btn btn-square btn-outline-primary border-2 m-1" href="#"><i class="fab fa-instagram"></i></a></div></div><div class="bg-light text-center p-4"><h5 class="mt-2">Họ và tên</h5><span>Giảng viên</span></div></div></div>
            <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.7s"><div class="team-item position-relative"><div class="position-relative"><img class="img-fluid" src="~/img/team-4.jpg" alt="Giảng viên 4" /><div class="team-social text-center"><a class="btn btn-square btn-outline-primary border-2 m-1" href="#"><i class="fab fa-facebook-f"></i></a><a class="btn btn-square btn-outline-primary border-2 m-1" href="#"><i class="fab fa-twitter"></i></a><a class="btn btn-square btn-outline-primary border-2 m-1" href="#"><i class="fab fa-instagram"></i></a></div></div><div class="bg-light text-center p-4"><h5 class="mt-2">Họ và tên</h5><span>Giảng viên</span></div></div></div>
        </div>
    </div>
</div>
